    ('encoded-payload-pipe', re.compile(r'\bbase64\s+(?:-[A-Za-z]*d|--decode)\b[^\n|]{0,300}\|\s*(?:/bin/)?(?:ba)?sh\b', re.I)),
    ('php-inline-eval', re.compile(r'\bphp(?:\d+(?:\.\d+)?)?\s+-r\s+[^\n]{0,1000}\b(?:eval|assert|base64_decode)\s*\(', re.I)),
