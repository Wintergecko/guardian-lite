BEGIN = '; BEGIN GUARDIAN MANAGED\n'
END = '; END GUARDIAN MANAGED\n'
CRON_FILES = (pathlib.Path('/etc/crontab'),)
CRON_DIRS = (pathlib.Path('/etc/cron.d'), pathlib.Path('/etc/cron.hourly'),
             pathlib.Path('/etc/cron.daily'), pathlib.Path('/etc/cron.weekly'),
