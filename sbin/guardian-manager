def root():
    return h.ROOT / 'management'


def prepare():
    if os.geteuid() != 0:
        raise ValueError('Root-Rechte erforderlich.')
    h.prepare_dir()
    h.ensure_private_dir(root())
    for name in ('backups', 'baselines', 'repair-journals', 'jobs'):
        h.ensure_private_dir(root() / name)


@contextlib.contextmanager
def locked(blocking=False):
    prepare()
    fd = os.open(str(root() / 'lock'), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        yield
    finally:
        os.close(fd)


def run(argv, timeout=30, diagnostic=False, **kwargs):
    result = subprocess.run([str(a) for a in argv], stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, timeout=timeout, check=False,
                            env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C'}, **kwargs)
    if result.returncode:
        # Commands may process secrets; never echo command arguments or raw stderr.
        detail = ''
        if diagnostic:
            detail = ' ' + re.sub(r'[\x00-\x1f]+', ' ', result.stderr.decode('utf-8', 'replace')[-180:])
        raise ValueError('Systemaktion fehlgeschlagen: %s (Exit %d).%s' %
                         (pathlib.Path(str(argv[0])).name, result.returncode, detail))
    return result.stdout.decode('utf-8', 'replace').strip()


def plesk(args):
    binary = h.binary(h.PLESK_BINARIES)
    if not binary:
        raise ValueError('Plesk CLI fehlt.')
    return run([binary, 'bin'] + args, timeout=120)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def checked(path, limit=2_000_000):
    fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or st.st_size > limit or st.st_mode & 0o022:
            raise ValueError('Unsichere oder zu grosse Konfigurationsdatei.')
        with os.fdopen(fd, 'rb', closefd=False) as stream:
            data = stream.read(limit + 1)
        if len(data) > limit:
            raise ValueError('Datei zu gross.')
        return data, st
    finally:
        os.close(fd)


def atomic(path, data, mode=0o600, uid=0, gid=0):
    if path.is_symlink():
        raise ValueError('Symlink als Ziel abgelehnt.')
    temp = path.with_name('.guardian-' + uuid.uuid4().hex)
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        with os.fdopen(fd, 'wb') as output:
            os.fchown(output.fileno(), uid, gid)
            os.fchmod(output.fileno(), mode)
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.replace(str(temp), str(path))
    finally:
        temp.unlink(missing_ok=True)


def config():
    return h.read_json(root() / 'config.json', {})


def save_config(data):
    h.write_json(root() / 'config.json', data)


def handler(version):
    if not VERSION.fullmatch(version):
        raise ValueError('Unterstuetzt werden Plesk PHP 8.0 bis 8.5.')
    path = PHP_BASE / version
    # Every parent is root-owned, not writable by website users, and not a symlink.
    for candidate in (PHP_BASE, path, path / 'etc', path / 'bin'):
        st = candidate.lstat()
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise ValueError('Unsicherer PHP-Handlerpfad.')
    checked(path / 'etc/php.ini')
    checked(path / 'bin/php', 100_000_000)
    return path


def make_backup(kind, identity, path):
    data, st = checked(path)
    check_backup_capacity(len(data))
    token = uuid.uuid4().hex
    atomic(root() / 'backups' / (token + '.bin'), data)
    record = {'id': token, 'kind': kind, 'identity': identity, 'sha256': digest(data),
              'mode': stat.S_IMODE(st.st_mode), 'gid': st.st_gid, 'created_at': h.utc_now()}
    h.write_json(root() / 'backups' / (token + '.json'), record)
    invalidate_storage_cache()
    return record


def php_backup(version):
    path = handler(version) / 'etc/php.ini'
    return make_backup('php', version, path)


def reload_handler(version):
    base = handler(version)
    run([base / 'sbin/php-fpm', '-t'], timeout=30)
    ctl = h.binary(h.SYSTEMCTL_PATHS)
    if not ctl:
        raise ValueError('systemctl fehlt.')
    run([ctl, 'reload', 'plesk-php%s-fpm' % version.replace('.', '')])


def php_restore(version, token, expected):
    path = handler(version) / 'etc/php.ini'
    if not re.fullmatch(r'[a-f0-9]{32}', token) or not HEX.fullmatch(expected):
        raise ValueError('Backup-ID oder aktueller Fingerprint ungueltig.')
    meta = h.read_json(root() / 'backups' / (token + '.json'), {})
    data, _ = checked(root() / 'backups' / (token + '.bin'))
    current, st = checked(path)
    if meta.get('kind') != 'php' or meta.get('identity') != version or digest(data) != meta.get('sha256'):
        raise ValueError('Backup passt nicht zum Handler oder ist beschaedigt.')
    if digest(current) != expected:
        raise ValueError('Konfiguration wurde zwischenzeitlich geaendert; Seite neu laden.')
    recovery = make_backup('php', version, path)
    atomic(path, data, meta['mode'], gid=st.st_gid)
    try:
        reload_handler(version)
    except Exception:
        atomic(path, current, stat.S_IMODE(st.st_mode), gid=st.st_gid)
        reload_handler(version)
        raise
    h.incident_log('operator', 'warning', detail='PHP %s Rollback %s' % (version, token))
    return {'backup': recovery['id'], 'message': 'PHP-Konfiguration wiederhergestellt und FPM neu geladen.'}


def runtime_policy(mode):
    if mode not in ('simulate', 'enforce'):
        raise ValueError('Ungueltiger Runtime-Modus.')
    suffix = '.simulation()' if mode == 'simulate' else ''
    return ''.join('sp.disable_function.function("%s").drop()%s;\n' % (name, suffix)
                   for name in ('system', 'shell_exec', 'passthru', 'exec', 'proc_open', 'popen'))


def runtime_set(version, mode, expected):
    base = handler(version)
    path = base / 'etc/php.ini'
    data, st = checked(path)
    if not HEX.fullmatch(expected) or digest(data) != expected:
        raise ValueError('PHP-Konfiguration geaendert; Seite neu laden.')
    text = data.decode('utf-8')
    if text.count(BEGIN) != text.count(END) or text.count(BEGIN) > 1:
        raise ValueError('Beschaedigter Guardian-Konfigurationsblock.')
    clean = re.sub(re.escape(BEGIN) + r'.*?' + re.escape(END), '', text, flags=re.S)
    if mode not in ('off', 'simulate', 'enforce'):
        raise ValueError('Ungueltiger Runtime-Modus.')
    external = [clean]
    for directory in (base / 'etc/php.d', base / 'etc/conf.d'):
        if directory.is_dir():
            for candidate in sorted(directory.glob('*.ini')):
                resolved = candidate.resolve(strict=True)
                external.append(checked(resolved)[0].decode('utf-8', 'replace'))
    if any(re.search(r'^\s*(?:extension\s*=.*snuffleupagus|sp\.configuration_file\s*=)',
                     entry, re.M | re.I) for entry in external):
        raise ValueError('Externe Snuffleupagus-Konfiguration vorhanden; keine Uebernahme.')
    backup = make_backup('php', version, path)
    if mode != 'off':
        module = base / 'lib/php/modules/snuffleupagus.so'
        checked(module, 20_000_000)
        rules = base / 'etc' / ('guardian-' + mode + '.rules')
        atomic(rules, runtime_policy(mode).encode('ascii'), 0o644)
        # Verify ABI, configuration syntax, and benign PHP execution before changing ini.
        output = run([base / 'bin/php', '-n', '-d', 'display_errors=stderr', '-d', 'log_errors=0', '-d', 'extension=' + str(module), '-d',
                      'sp.configuration_file=' + str(rules), '-r',
                      'echo extension_loaded("snuffleupagus") ? "GUARDIAN_OK" : "MISSING";'])
        if output != 'GUARDIAN_OK':
            raise ValueError('Snuffleupagus konnte nicht geladen werden.')
        probe = subprocess.run([str(base / 'bin/php'), '-n', '-d', 'display_errors=stderr', '-d', 'log_errors=0', '-d', 'extension=' + str(module), '-d',
                                'sp.configuration_file=' + str(rules), '-r',
                                'echo shell_exec("printf GUARDIAN_PROBE");'], stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, timeout=10, check=False,
                               env={'PATH': '/usr/bin:/bin', 'LANG': 'C'})
        if mode == 'simulate' and (probe.returncode or probe.stdout != b'GUARDIAN_PROBE'):
            raise ValueError('Runtime-Simulation hat den harmlosen Test unerwartet blockiert.')
        if mode == 'enforce' and (probe.returncode == 0 or b'snuffleupagus' not in probe.stderr.lower()):
            raise ValueError('Runtime-Blockade konnte im isolierten PHP-Test nicht bestaetigt werden.')
        clean += '\n' + BEGIN + 'extension="%s"\nsp.configuration_file="%s"\n' % (module, rules) + END
    atomic(path, clean.encode('utf-8'), stat.S_IMODE(st.st_mode), gid=st.st_gid)
    try:
        reload_handler(version)
    except Exception:
        atomic(path, data, stat.S_IMODE(st.st_mode), gid=st.st_gid)
        reload_handler(version)
        raise
    h.incident_log('operator', 'warning', detail='PHP %s Runtime %s' % (version, mode))
    return {'backup': backup['id'], 'mode': mode, 'message': 'Handler-Konfiguration geprueft und FPM neu geladen; Webrequests separat testen.'}


def runtime_install(version):
    base = handler(version)
    for path in (base / 'bin/phpize', base / 'bin/php-config'):
        if not path.is_file():
            raise ValueError('Passendes Plesk-PHP-Entwicklungspaket fehlt: ' + path.name)
        checked(path, 2_000_000)
    for program in ('git', 'make', 'gcc', 'autoconf'):
        if not shutil.which(program):
            raise ValueError('Build-Voraussetzung fehlt: ' + program)
    target = base / 'lib/php/modules/snuffleupagus.so'
    if target.exists() or target.is_symlink():
        raise ValueError('Modul ist bereits vorhanden; kein automatisches Ueberschreiben.')
    try:
        user = pwd.getpwnam('guardian-build')
    except KeyError:
        run(['/usr/sbin/useradd', '--system', '--no-create-home', '--home-dir', '/nonexistent',
             '--shell', '/usr/sbin/nologin', 'guardian-build'])
        user = pwd.getpwnam('guardian-build')
    if not 0 < user.pw_uid < 1000 or user.pw_dir != '/nonexistent' or user.pw_shell != '/usr/sbin/nologin':
        raise ValueError('Build-Benutzer muss ein gesondertes gesperrtes Systemkonto sein.')
    def unprivileged():
        os.setgroups([])
        os.setgid(user.pw_gid)
        os.setuid(user.pw_uid)
        os.nice(10)
    # No configure/make/install step ever runs as root.
    with tempfile.TemporaryDirectory(prefix='guardian-build-') as tmp:
        folder = pathlib.Path(tmp)
        os.chown(folder, user.pw_uid, user.pw_gid)
        source = folder / 'source'
        run(['/usr/bin/git', 'clone', '--depth=1', '--branch', 'v0.14.0',
             'https://github.com/jvoisin/snuffleupagus.git', str(source)], timeout=180,
            cwd=folder, preexec_fn=unprivileged, diagnostic=True)
        commit = run(['/usr/bin/git', '-C', source, 'rev-parse', 'HEAD'], cwd=folder, preexec_fn=unprivileged, diagnostic=True)
        if commit != SNuffle_COMMIT:
            raise ValueError('Upstream-Tag stimmt nicht mit dem freigegebenen Commit ueberein.')
        src = source / 'src'
        run([base / 'bin/phpize'], timeout=120, cwd=src, preexec_fn=unprivileged, diagnostic=True)
        run([src / 'configure', '--enable-snuffleupagus', '--with-php-config=' + str(base / 'bin/php-config')],
            timeout=180, cwd=src, preexec_fn=unprivileged, diagnostic=True)
        run(['/usr/bin/make', '-j2'], timeout=600, cwd=src, preexec_fn=unprivileged, diagnostic=True)
        built = src / 'modules/snuffleupagus.so'
        fd = os.open(str(built), os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, 'rb') as inp:
            module = inp.read(20_000_001)
        if len(module) > 20_000_000 or not module.startswith(b'\x7fELF'):
            raise ValueError('Ungueltiges Build-Artefakt.')
        atomic(target, module, 0o644)
    return {'message': 'Snuffleupagus 0.14.0 fuer PHP %s installiert, noch nicht aktiviert.' % version}


def waf_rules(domain, mode, limit):
    if not h.valid_domain(domain) or mode not in ('off', 'detect', 'enforce'):
        raise ValueError('Ungueltige WAF-Einstellung.')
    limit = int(limit)
    if not 10 <= limit <= 10000:
        raise ValueError('Limit muss zwischen 10 und 10000 liegen.')
    if mode == 'off':
        return ''
    # Stable IDs are per server, not dependent on input or hash collisions.
    action = 'deny,status:429' if mode == 'enforce' else 'pass'
    return ('SecAction "id:9974100,phase:1,pass,nolog,initcol:ip=%%{REMOTE_ADDR}"\n'
            'SecRule &IP:guardian_requests "@eq 0" "id:9974101,phase:1,pass,nolog,setvar:ip.guardian_requests=0,expirevar:ip.guardian_requests=60"\n'
            'SecRule REQUEST_HEADERS:Host "@rx ^%s(?::[0-9]+)?$" '
            '"id:9974102,phase:1,pass,nolog,t:lowercase,setvar:ip.guardian_requests=+1"\n'
            'SecRule REQUEST_HEADERS:Host "@rx ^%s(?::[0-9]+)?$" '
            '"id:9974103,phase:1,chain,t:lowercase,%s,log,msg:\'Guardian request limit\'"\n'
            'SecRule IP:guardian_requests "@gt %d"\n') % (re.escape(domain), re.escape(domain), action, limit)


def waf_file():
    # Plesk's Apache include dirs; only Guardian-owned rules are changed.
    options = (pathlib.Path('/etc/apache2/modsecurity.d'), pathlib.Path('/etc/httpd/conf/modsecurity.d'))
    for path in options:
        if path.is_dir() and not path.is_symlink():
            return path / 'zz-guardian.conf'
    raise ValueError('Unterstuetztes Apache-ModSecurity-Include-Verzeichnis fehlt.')


def waf_set(domain, mode, limit, expected):
    h.site_docroot(domain)
    path = waf_file()
    current = checked(path)[0] if path.exists() else b''
    if not HEX.fullmatch(expected) or digest(current) != expected:
        raise ValueError('WAF-Konfiguration geaendert; Seite neu laden.')
    if current and not current.startswith(b'# Guardian managed\n'):
        raise ValueError('Vorhandene fremde Regeldatei wird nicht ueberschrieben.')
    # One explicit target domain per managed policy avoids accidental global rollout.
    rules = waf_rules(domain, mode, limit)
    data = b'# Guardian managed\n' + rules.encode('ascii')
    if path.exists():
        backup = make_backup('waf', domain, path)['id']
    else:
        backup = None
    ctl = h.binary(('/usr/sbin/apache2ctl', '/usr/sbin/apachectl'))
    systemctl = h.binary(h.SYSTEMCTL_PATHS)
    if not ctl or not systemctl:
        raise ValueError('Apache-Konfigurationspruefung oder systemctl fehlt.')
    # Reject absent ModSecurity and unconfigured persistent collections.
    modules = run([ctl, '-M'])
    if 'security2_module' not in modules:
        raise ValueError('Apache ModSecurity v2 ist nicht geladen.')
    if 'unique_id_module' not in modules:
        raise ValueError('Apache mod_unique_id als ModSecurity-Voraussetzung fehlt.')
    included = run([ctl, '-t', '-D', 'DUMP_INCLUDES'])
    datadir = None
    for filename in re.findall(r'(/[^\s]+\.conf)', included):
        candidate = pathlib.Path(filename).resolve()
        if os.path.commonpath(('/etc', str(candidate))) != '/etc':
            continue
        try:
            text = checked(candidate)[0].decode('utf-8', 'replace')
        except (OSError, ValueError):
            continue
        match = re.search(r'^\s*SecDataDir\s+"?([^"\s]+)', text, re.M)
        if match:
            datadir = pathlib.Path(match.group(1))
    if mode != 'off' and (datadir is None or not datadir.is_dir()):
        raise ValueError('ModSecurity SecDataDir fuer persistente IP-Counter fehlt.')
    atomic(path, data, 0o644)
    try:
        run([ctl, '-t'])
        # DUMP_INCLUDES proves the managed file is actually included.
        includes = run([ctl, '-t', '-D', 'DUMP_INCLUDES'])
        if str(path) not in includes:
            raise ValueError('Guardian-Regeldatei wird von Apache nicht eingebunden.')
        run([systemctl, 'reload', 'apache2' if 'apache2' in str(ctl) else 'httpd'])
    except Exception:
        if current:
            atomic(path, current, 0o644)
        else:
            path.unlink(missing_ok=True)
        run([ctl, '-t'])
        raise
    settings = config()
    settings['waf'] = {'domain': domain, 'mode': mode, 'limit': int(limit), 'sha256': digest(data), 'backup': backup}
    save_config(settings)
    h.incident_log('operator', 'warning', domain, 'Guardian WAF ' + mode)
    return {'message': 'WAF-Regeln installiert und Apache neu geladen. HTTP-Wirksamkeitspruefung erforderlich.', 'backup': backup}


def waf_engine(domain, mode):
    h.site_docroot(domain)
    if mode not in ('on', 'off', 'detection-only'):
        raise ValueError('Ungueltiger WAF-Engine-Modus.')
    before = plesk(['subscription', '--show-web-app-firewall', domain])
    previous = before.strip().lower()
    match = re.search(r'(?:waf[-_ ]rule[-_ ]engine|rule[-_ ]engine|mode|modus)\s*[:=]\s*(on|off|detection[- ]?only)', previous)
    if match:
        previous = match.group(1)
    previous = {'detectiononly': 'detection-only', 'detection only': 'detection-only'}.get(previous, previous)
    if previous not in ('on', 'off', 'detection-only'):
        raise ValueError('Vorheriger Plesk-WAF-Modus konnte nicht eindeutig ermittelt werden; keine Aenderung.')
    token = uuid.uuid4().hex
    backup_data = before.encode('utf-8')
    check_backup_capacity(len(backup_data))
    atomic(root() / 'backups' / (token + '.bin'), backup_data)
    h.write_json(root() / 'backups' / (token + '.json'), {
        'id': token, 'kind': 'waf-engine', 'identity': domain, 'sha256': digest(backup_data),
        'mode': 0o600, 'gid': os.getgid(), 'created_at': h.utc_now()})
    invalidate_storage_cache()
    settings = config()
    settings.setdefault('waf_engines', {}).setdefault(domain, previous)
    save_config(settings)
    plesk(['subscription', '--update-web-app-firewall', domain, '-waf-rule-engine', mode])
    h.incident_log('operator', 'warning', domain, 'Plesk WAF-Engine ' + mode)
    return {'message': 'Plesk WAF-Engine auf %s gesetzt. Vorheriger Status als Diagnosebackup %s gespeichert.' % (mode, token)}


def waf_restore(token, expected):
    if not re.fullmatch(r'[a-f0-9]{32}', token) or not HEX.fullmatch(expected):
        raise ValueError('Ungueltiger WAF-Backupverweis.')
    meta = h.read_json(root() / 'backups' / (token + '.json'), {})
    data, _ = checked(root() / 'backups' / (token + '.bin'))
    path = waf_file()
    current, _ = checked(path)
    if meta.get('kind') != 'waf' or digest(data) != meta.get('sha256') or not data.startswith(b'# Guardian managed\n'):
        raise ValueError('Kein gueltiges Guardian-WAF-Backup.')
    if digest(current) != expected:
        raise ValueError('WAF-Konfiguration zwischenzeitlich geaendert.')
    backup = make_backup('waf', meta.get('identity', ''), path)
    ctl = h.binary(('/usr/sbin/apache2ctl', '/usr/sbin/apachectl'))
    systemctl = h.binary(h.SYSTEMCTL_PATHS)
    if not ctl or not systemctl:
        raise ValueError('Apache-Werkzeuge fehlen.')
    atomic(path, data, 0o644)
    try:
        run([ctl, '-t'])
        run([systemctl, 'reload', 'apache2' if 'apache2' in str(ctl) else 'httpd'])
    except Exception:
        atomic(path, current, 0o644)
        raise
    settings = config()
    settings['waf'] = {'mode': 'restored', 'backup': token, 'sha256': digest(data)}
    save_config(settings)
    return {'message': 'Guardian-WAF-Backup wiederhergestellt.', 'backup': backup['id']}


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        raise ValueError('API-Weiterleitung abgelehnt.')


def api_json(url, headers, data=None):
    request = urllib.request.Request(url, headers=headers, data=data)
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    try:
        with opener.open(request, timeout=10) as response:
            raw = response.read(64_001)
    except urllib.error.HTTPError as exc:
        raise ValueError('Cloud-API antwortet mit HTTP %d; Schluessel und API-Limit pruefen.' % exc.code) from None
    except urllib.error.URLError:
        raise ValueError('Cloud-API nicht erreichbar; DNS, TLS und ausgehendes HTTPS pruefen.') from None
    if len(raw) > 64000:
        raise ValueError('API-Antwort zu gross.')
    result = json.loads(raw)
    if not isinstance(result, dict):
        raise ValueError('Ungueltige API-Antwort.')
    return result


def reputation(ip):
    address = ipaddress.ip_address(ip)
    if not address.is_global:
        raise ValueError('Nur oeffentliche IP-Adressen duerfen abgefragt werden.')
    settings = config()
    key = settings.get('abuseipdb_key', '')
    if not key or not settings.get('cloud_consent'):
        raise ValueError('AbuseIPDB-Schluessel und Zustimmung zur IP-Uebermittlung fehlen.')
    cache = h.read_json(root() / 'reputation.json', {})
    cached = cache.get(str(address), {})
    if time.time() - cached.get('checked_at', 0) < 3600:
        return cached
    reply = api_json('https://api.abuseipdb.com/api/v2/check?' + urllib.parse.urlencode(
        {'ipAddress': str(address), 'maxAgeInDays': 30}), {'Key': key, 'Accept': 'application/json'})
    record = reply.get('data', {})
    score = record.get('abuseConfidenceScore')
    if record.get('ipAddress') != str(address) or type(score) is not int or not 0 <= score <= 100:
        raise ValueError('AbuseIPDB-Antwort passt nicht zur Abfrage.')
    result = {'ip': str(address), 'score': score, 'reports': record.get('totalReports', 0),
              'checked_at': time.time(), 'country': str(record.get('countryCode', ''))[:2]}
    cache[str(address)] = result
    cache = dict(sorted(cache.items(), key=lambda x: x[1].get('checked_at', 0), reverse=True)[:200])
    h.write_json(root() / 'reputation.json', cache)
    return result


def cloud_save(request):
    settings = config()
    if any(item.get('enabled') for item in settings.get('bots', {}).values()) and (
            request.get('clear') is True or request.get('consent') is not True or
            request.get('turnstile_sitekey') or request.get('turnstile_secret')):
        raise ValueError('Zuerst aktive Bot-Pruefungen deaktivieren, bevor Turnstile-Schluessel oder Zustimmung geaendert werden.')
    for key in ('abuseipdb_key', 'turnstile_sitekey', 'turnstile_secret'):
        value = request.get(key, '')
        if value:
            if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9_-]{10,200}', value):
                raise ValueError('Ungueltiger API-Schluessel.')
            settings[key] = value
    settings['cloud_consent'] = request.get('consent') is True
    if request.get('clear') is True:
        for key in ('abuseipdb_key', 'turnstile_sitekey', 'turnstile_secret'):
            settings.pop(key, None)
    save_config(settings)
    return {'message': 'Cloud-Einstellungen gespeichert. Es werden keine IPs automatisch gemeldet oder gesperrt.'}


def ignore_hash_set(domain, sha256, mode):
    h.site_docroot(domain)
    if not isinstance(sha256, str) or not HEX.fullmatch(sha256) or mode not in ('add', 'remove'):
        raise ValueError('Ungueltiger Ignore-List-Eintrag.')
    settings = config()
    entries = settings.setdefault('ignore_hashes', {})
    if not isinstance(entries, dict):
        entries = {}
        settings['ignore_hashes'] = entries
    values = entries.get(domain, [])
    if not isinstance(values, list):
        values = []
    values = sorted({value for value in values if isinstance(value, str) and HEX.fullmatch(value)})
    if mode == 'add':
        total = sum(len(value) for value in entries.values() if isinstance(value, list))
        if sha256 not in values and total >= 2000:
            raise ValueError('Maximal 2000 Ignore-Hashes insgesamt; zuerst alte Eintraege entfernen.')
        if sha256 not in values and len(values) >= 500:
            raise ValueError('Maximal 500 Hashes je Domain; zuerst alte Eintraege entfernen.')
        values = sorted(set(values) | {sha256})
        entries[domain] = values
        message = 'Exakter Dateiinhalt wird bei kuenftigen Scans fuer diese Domain als ignoriert markiert.'
    else:
        values = [value for value in values if value != sha256]
        if values:
            entries[domain] = values
        else:
            entries.pop(domain, None)
        message = 'Hash aus der Ignore-Liste entfernt; Datei wird bei kuenftigen Scans wieder normal gemeldet.'
    save_config(settings)
    h.incident_log('operator', 'warning', domain,
                   ('SHA256 zur Malware-Ignore-Liste hinzugefuegt: ' if mode == 'add' else
                    'SHA256 aus Malware-Ignore-Liste entfernt: ') + sha256[:12])
    return {'message': message}


def global_ignore_hash_set(sha256, mode):
    if not isinstance(sha256, str) or not HEX.fullmatch(sha256) or mode not in ('add', 'remove'):
        raise ValueError('Ungueltiger globaler Ignore-List-Eintrag.')
    settings = config()
    values = settings.get('global_ignore_hashes', [])
    if not isinstance(values, list):
        values = []
    values = sorted({value for value in values if isinstance(value, str) and HEX.fullmatch(value)})
    if mode == 'add':
        if sha256 not in values and len(values) >= 2000:
            raise ValueError('Maximal 2000 globale Ignore-Hashes; zuerst alte Eintraege entfernen.')
        values = sorted(set(values) | {sha256})
        settings['global_ignore_hashes'] = values
        message = 'Exakter Dateiinhalt wird domainuebergreifend als ignoriert markiert; er wird weiterhin gescannt und angezeigt.'
    else:
        values = [value for value in values if value != sha256]
        if values:
            settings['global_ignore_hashes'] = values
        else:
            settings.pop('global_ignore_hashes', None)
        message = 'Hash aus der globalen Ignore-Liste entfernt; Treffer werden wieder normal gemeldet.'
    save_config(settings)
    h.incident_log('operator', 'warning', '',
                   ('Globalen SHA256 zur Malware-Ignore-Liste hinzugefuegt: ' if mode == 'add' else
                    'Globalen SHA256 aus Malware-Ignore-Liste entfernt: ') + sha256[:12])
    return {'message': message}


def directory_usage(path):
    """Count regular files without following symlinks in a Guardian storage area."""
    total = 0
    files = 0
    incomplete = False
    path = pathlib.Path(path)
    try:
        path.lstat()
    except FileNotFoundError:
        return {'bytes': 0, 'files': 0, 'incomplete': False}
    try:
        if path.is_symlink() or not path.is_dir():
            return {'bytes': 0, 'files': 0, 'incomplete': True}
        for directory, dirs, names in os.walk(path, followlinks=False):
            for name in list(dirs):
                candidate = pathlib.Path(directory) / name
                try:
                    mode = candidate.lstat().st_mode
                    if not stat.S_ISDIR(mode):
                        dirs.remove(name)
                        incomplete = True
                except OSError:
                    dirs.remove(name)
                    incomplete = True
            for name in names:
                candidate = pathlib.Path(directory) / name
                try:
                    info = candidate.lstat()
                    if not stat.S_ISREG(info.st_mode):
                        incomplete = True
                        continue
                    total += info.st_size
                    files += 1
                except OSError:
                    incomplete = True
    except OSError:
        incomplete = True
    return {'bytes': total, 'files': files, 'incomplete': incomplete}


def check_backup_capacity(additional_bytes):
    area = root() / 'backups'
    usage = directory_usage(area)
    bin_count = sum(1 for _ in area.glob('*.bin'))
    if bin_count >= MAX_BACKUPS:
        raise ValueError('Maximal 200 Backups. Nicht mehr benoetigte Backups zuerst loeschen.')
    if usage['bytes'] + max(0, int(additional_bytes)) + 4096 > BACKUP_QUOTA_BYTES:
        raise ValueError('Backup-Quota von 256 MiB wuerde ueberschritten. Alte Wiederherstellungspunkte zuerst entfernen.')


def invalidate_storage_cache():
    try:
        (root() / 'storage-cache.json').unlink()
    except OSError:
        pass


def storage_status():
    areas = {name: directory_usage(root() / name)
             for name in ('backups', 'baselines', 'repair-journals', 'jobs')}
    areas['scan-cache'] = directory_usage(h.ROOT / 'scan-cache')
    managed = sum(item['bytes'] for item in areas.values())
    try:
        disk = shutil.disk_usage(h.ROOT)
        disk_info = {'total_bytes': disk.total, 'used_bytes': disk.used, 'free_bytes': disk.free}
    except OSError:
        disk_info = {'total_bytes': None, 'used_bytes': None, 'free_bytes': None}
    return {'areas': areas, 'managed_bytes': managed, 'disk': disk_info,
            'baseline_quota_bytes': BASELINE_QUOTA_BYTES,
            'baseline_remaining_bytes': max(0, BASELINE_QUOTA_BYTES - areas['baselines']['bytes']),
            'backup_quota_bytes': BACKUP_QUOTA_BYTES,
            'backup_remaining_bytes': max(0, BACKUP_QUOTA_BYTES - areas['backups']['bytes']),
            'incomplete': any(item['incomplete'] for item in areas.values())}


def storage_snapshot():
    path = root() / 'storage-cache.json'
    cached = h.read_json(path, {})
    epoch = cached.get('epoch', 0) if isinstance(cached, dict) else 0
    if isinstance(epoch, (int, float)) and 0 <= time.time() - epoch < STORAGE_CACHE_TTL \
            and isinstance(cached.get('storage'), dict) and isinstance(cached.get('baselines'), list):
        return cached['storage'], cached['baselines'], epoch
    storage = storage_status()
    baselines = baseline_inventory()
    epoch = time.time()
    storage['measured_at'] = h.utc_now()
    h.write_json(path, {'epoch': epoch, 'storage': storage, 'baselines': baselines})
    return storage, baselines, epoch


def baseline_inventory(settings=None):
    settings = config() if settings is None else settings
    active = settings.get('baselines', {}) if isinstance(settings.get('baselines', {}), dict) else {}
    autorepair = settings.get('autorepair', {}) if isinstance(settings.get('autorepair', {}), dict) else {}
    result = []
    for folder in sorted((root() / 'baselines').iterdir(), key=lambda p: p.name, reverse=True):
        if not re.fullmatch(r'[a-f0-9]{32}', folder.name):
            continue
        try:
            info = folder.lstat()
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                continue
        except OSError:
            continue
        manifest = h.read_json(folder / 'manifest.json', {}, max_bytes=2_000_000)
        usage = directory_usage(folder)
        domain = manifest.get('domain', '') if isinstance(manifest, dict) else ''
        result.append({'id': folder.name, 'domain': domain if h.valid_domain(domain) else '',
                       'created_at': manifest.get('created_at', '') if isinstance(manifest, dict) else '',
                       'files': len(manifest.get('files', {})) if isinstance(manifest.get('files'), dict) else 0,
                       'bytes': usage['bytes'], 'incomplete': not bool(manifest),
                       'active': isinstance(active.get(domain), dict) and active[domain].get('id') == folder.name,
                       'autorepair': any(value == folder.name for value in autorepair.values())})
    return result


def baseline_delete(token, domain=''):
    if not re.fullmatch(r'[a-f0-9]{32}', token):
        raise ValueError('Ungueltige Baseline-ID.')
    if domain and not h.valid_domain(domain):
        raise ValueError('Ungueltige Baseline-Domain.')
    folder = root() / 'baselines' / token
    try:
        info = folder.lstat()
    except OSError:
        raise ValueError('Baseline nicht gefunden.')
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
        raise ValueError('Baseline-Verzeichnis ist nicht sicher.')
    settings = config()
    configured = settings.get('baselines', {}) if isinstance(settings.get('baselines', {}), dict) else {}
    autorepair = settings.get('autorepair', {}) if isinstance(settings.get('autorepair', {}), dict) else {}
    if any(value == token for value in autorepair.values()):
        raise ValueError('Baseline wird fuer automatische Reparatur verwendet. Reparatur zuerst deaktivieren.')
    manifest = h.read_json(folder / 'manifest.json', {}, max_bytes=2_000_000)
    manifest_domain = manifest.get('domain', '') if isinstance(manifest, dict) else ''
    owner = manifest_domain if h.valid_domain(manifest_domain) else ''
    configured_domains = [name for name, item in configured.items()
                          if isinstance(item, dict) and item.get('id') == token and h.valid_domain(name)]
    if owner and configured_domains and owner not in configured_domains:
        raise ValueError('Baseline-Metadaten widersprechen der Guardian-Konfiguration.')
    owner = owner or (configured_domains[0] if configured_domains else '')
    if domain and owner and domain != owner:
        raise ValueError('Baseline gehoert zu einer anderen Domain.')
    if domain and not owner:
        raise ValueError('Domain der Baseline konnte nicht bestaetigt werden.')
    shutil.rmtree(str(folder))
    for name in configured_domains:
        configured.pop(name, None)
    if configured_domains:
        settings['baselines'] = configured
        save_config(settings)
    h.incident_log('operator', 'warning', owner,
                   'Administrator hat eine Good-File-Baseline dauerhaft geloescht: ' + token)
    invalidate_storage_cache()
    return {'message': 'Baseline geloescht und Speicher freigegeben.', 'id': token}


def backup_delete(token):
    if not re.fullmatch(r'[a-f0-9]{32}', token):
        raise ValueError('Ungueltige Backup-ID.')
    settings = config()
    waf_settings = settings.get('waf', {})
    if isinstance(waf_settings, dict) and waf_settings.get('backup') == token:
        raise ValueError('Dieses Backup ist die aktuelle Guardian-WAF-Wiederherstellungsquelle.')
    meta_path = root() / 'backups' / (token + '.json')
    blob_path = root() / 'backups' / (token + '.bin')
    meta = h.read_json(meta_path, {})
    legacy_waf_engine = not meta and not meta_path.exists() and not meta_path.is_symlink()
    if not legacy_waf_engine and (meta.get('id') != token or meta.get('kind') not in ('php', 'waf', 'waf-engine')):
        raise ValueError('Verwaltetes PHP-/WAF-Backup nicht gefunden.')
    data, _ = checked(blob_path)
    if not legacy_waf_engine and digest(data) != meta.get('sha256'):
        raise ValueError('Backup-Pruefsumme stimmt nicht; nichts geloescht.')
    blob_path.unlink()
    if not legacy_waf_engine:
        meta_path.unlink()
    kind = meta.get('kind', 'waf-engine')
    identity = meta.get('identity', '') if kind in ('waf', 'waf-engine') else ''
    h.incident_log('operator', 'warning', identity,
                   'Administrator hat ein %s-Wiederherstellungsbackup dauerhaft geloescht: %s' % (kind, token))
    invalidate_storage_cache()
    return {'message': 'Backup geloescht und Speicher freigegeben.', 'id': token}


def baseline(domain, trusted):
    if trusted is not True:
        raise ValueError('Die saubere Herkunft muss ausdruecklich bestaetigt werden.')
    docroot, uid, gid = h.site_docroot(domain)
    latest = next((item for item in h.history(limit=None) if item.get('domain') == domain), None)
    if not latest or latest.get('status') != 'finished' or latest.get('infected') != 0:
        raise ValueError('Zuerst einen fehlerfreien Vollscan ohne Funde durchfuehren.')
    report = h.load_job(latest['id'])
    if time.time() - float(report.get('epoch', 0)) > 3600 or report.get('warning'):
        raise ValueError('Sauberer Scan muss weniger als eine Stunde alt sein.')
    token = uuid.uuid4().hex
    if shutil.disk_usage(root()).free < 128 * 1024 * 1024:
        raise ValueError('Mindestens 128 MiB freier Speicher fuer eine Baseline erforderlich.')
    if sum(1 for _ in (root() / 'baselines').iterdir()) >= 20:
        raise ValueError('Maximal 20 Baselines. Nicht mehr benoetigte Baselines zuerst entfernen.')
    baseline_bytes = directory_usage(root() / 'baselines')['bytes']
    destination = root() / 'baselines' / token
    destination.mkdir(mode=0o700)
    entries = {}
    total = 0
    try:
        for directory, dirs, names in os.walk(docroot, followlinks=False):
            dirs[:] = [name for name in dirs if not (pathlib.Path(directory) / name).is_symlink()]
            for name in names:
                if not name.lower().endswith(h.WATCH_SUFFIXES):
                    continue
                relative = (pathlib.Path(directory) / name).relative_to(docroot).as_posix()
                if len(entries) >= 5000 or total > 64 * 1024 * 1024:
                    raise ValueError('Baseline-Limit ueberschritten (5000 Dateien / 64 MiB).')
                before, dfd, leaf = h.file_metadata(docroot, relative, max_bytes=2 * 1024 * 1024)
                try:
                    original_mode = stat.S_IMODE(os.stat(leaf, dir_fd=dfd, follow_symlinks=False).st_mode) & 0o755
                    fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
                    with os.fdopen(fd, 'rb') as stream:
                        data = stream.read(2 * 1024 * 1024 + 1)
                    after, second_fd, _ = h.file_metadata(docroot, relative, max_bytes=2 * 1024 * 1024)
                    os.close(second_fd)
                    if before != after or digest(data) != before['sha256'] or before['uid'] != uid:
                        raise ValueError('Datei waehrend Baseline-Erstellung geaendert oder fremder Eigentuemer.')
                finally:
                    os.close(dfd)
                total += len(data)
                if total > 64 * 1024 * 1024:
                    raise ValueError('Baseline zu gross.')
                if baseline_bytes + total > BASELINE_QUOTA_BYTES:
                    raise ValueError('Baseline-Speicherquote von 512 MiB wuerde ueberschritten. Aeltere Baselines zuerst entfernen.')
                blob = before['sha256']
                if not (destination / blob).exists():
                    atomic(destination / blob, data, 0o400)
                entries[relative] = {'sha256': blob, 'size': len(data), 'mode': original_mode}
        if not entries:
            raise ValueError('Keine geeigneten Dateien fuer Baseline vorhanden.')
        info = {'id': token, 'domain': domain, 'docroot': str(docroot), 'uid': uid, 'gid': gid,
                'files': entries, 'created_at': h.utc_now(), 'scan': latest['id'],
                'trust': 'administrator-attested; not vendor-authenticated'}
        h.write_json(destination / 'manifest.json', info)
        if baseline_bytes + directory_usage(destination)['bytes'] > BASELINE_QUOTA_BYTES:
            raise ValueError('Baseline-Speicherquote von 512 MiB wuerde ueberschritten. Aeltere Baselines zuerst entfernen.')
        os.chmod(destination / 'manifest.json', 0o400)
        settings = config()
        settings.setdefault('baselines', {})[domain] = {'id': token, 'files': len(entries),
                                                      'created_at': info['created_at']}
        # A new baseline must never silently change the source of automatic repair.
        settings.setdefault('autorepair', {}).pop(domain, None)
        save_config(settings)
        invalidate_storage_cache()
    except Exception:
        # Incomplete captures are not useful recovery sources and must not consume quota.
        shutil.rmtree(str(destination), ignore_errors=True)
        raise
    h.incident_log('operator', 'warning', domain, 'Good-File-Baseline vom Administrator freigegeben: ' + token)
    return {'message': 'Baseline mit %d Dateien gespeichert. Automatische Reparatur bleibt aus.' % len(entries)}


def repair_set(domain, mode):
    h.site_docroot(domain)
    if mode not in ('on', 'off'):
        raise ValueError('Ungueltiger Reparaturmodus.')
    settings = config()
    if mode == 'on':
        item = settings.get('baselines', {}).get(domain, {})
        if not item.get('id'):
            raise ValueError('Zuerst eine vertrauenswuerdige Baseline erstellen.')
        settings.setdefault('autorepair', {})[domain] = item['id']
    else:
        settings.setdefault('autorepair', {}).pop(domain, None)
    save_config(settings)
    invalidate_storage_cache()
    h.incident_log('operator', 'warning', domain, 'Automatische Reparatur ' + mode)
    return {'message': 'Automatische Reparatur ' + mode}


def repair_one(jobid, index, blocking=False):
    if not h.JOB_ID.fullmatch(jobid) or type(index) is not int or not 0 <= index < h.MAX_FINDINGS:
        raise ValueError('Ungueltiger Fundverweis.')
    fd = h.lock_scan(blocking=blocking)
    try:
        report = h.load_job(jobid)
        if not report or report.get('status') != 'finished':
            raise ValueError('Abgeschlossener Scan erforderlich.')
        finding = report['findings'][index]
        if finding.get('state') != 'found' or finding.get('ignored') is True or not finding.get('fingerprint'):
            raise ValueError('Unveraenderter, verifizierter Fund erforderlich.')
        domain = report['domain']
        raw_ignored = config().get('ignore_hashes', {})
        ignored_hashes = raw_ignored.get(domain, []) if isinstance(raw_ignored, dict) else []
        global_ignored = config().get('global_ignore_hashes', [])
        if not isinstance(global_ignored, list):
            global_ignored = []
        if (finding['fingerprint'].get('sha256') in ignored_hashes or
                finding['fingerprint'].get('sha256') in global_ignored):
            raise ValueError('Dateiinhalt steht auf der Ignore-Liste; Eintrag zuerst entfernen und neu scannen.')
        item = config().get('baselines', {}).get(domain, {})
        token = item.get('id', '')
        if not re.fullmatch(r'[a-f0-9]{32}', token):
            raise ValueError('Keine Baseline vorhanden.')
        folder = root() / 'baselines' / token
        manifest = h.read_json(folder / 'manifest.json', {}, max_bytes=2_000_000)
        docroot, uid, gid = h.site_docroot(domain)
        if manifest.get('domain') != domain or manifest.get('docroot') != str(docroot) or manifest.get('uid') != uid:
            raise ValueError('Baseline passt nicht zum aktuellen Webspace.')
        relative = finding['path']
        good = manifest.get('files', {}).get(relative, {})
        sha = good.get('sha256', '')
        if not HEX.fullmatch(sha):
            raise ValueError('Kein bekanntes Good-File fuer diesen Fund; manuelle Quarantaene verwenden.')
        data, _ = checked(folder / sha)
        if digest(data) != sha or len(data) != good.get('size'):
            raise ValueError('Baseline-Pruefsumme stimmt nicht.')
        before, dfd, name = h.file_metadata(docroot, relative)
        qfd = os.open(str(h.ROOT / 'quarantine'), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        temp = '.guardian-repair-' + uuid.uuid4().hex
        quarantine = jobid + '-' + str(index) + '-' + uuid.uuid4().hex
        moved_original = False
        try:
            if before != finding['fingerprint'] or before['uid'] != uid:
                raise ValueError('Funddatei inzwischen geaendert.')
            output_fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dfd)
            with os.fdopen(output_fd, 'wb') as output:
                os.fchown(output.fileno(), uid, gid)
                os.fchmod(output.fileno(), int(good.get('mode', 0o600)) & 0o755)
                output.write(data)
                output.flush()
                os.fsync(output.fileno())
            finding.update(state='pending', quarantine_id=quarantine)
            h.save_job(report)
            os.rename(name, quarantine, src_dir_fd=dfd, dst_dir_fd=qfd)
            moved_original = True
            moved = os.stat(quarantine, dir_fd=qfd, follow_symlinks=False)
            if moved.st_ino != before['ino'] or moved.st_dev != before['dev']:
                raise ValueError('Datei waehrend Reparatur verschoben; manuelle Pruefung erforderlich.')
            # link refuses to overwrite a file concurrently recreated by the site.
            os.link(temp, name, src_dir_fd=dfd, dst_dir_fd=dfd, follow_symlinks=False)
            finding.update(state='repaired', repaired_at=h.utc_now(), baseline=token,
                           repaired_sha256=sha)
            h.save_job(report)
            h.incident_log('operator', 'warning', domain, 'Good-File-Reparatur ausgefuehrt; Original in Quarantaene.', relative)
        except Exception:
            if moved_original:
                try:
                    os.link(quarantine, name, src_dir_fd=qfd, dst_dir_fd=dfd, follow_symlinks=False)
                    os.unlink(quarantine, dir_fd=qfd)
                    finding.update(state='found')
                    finding.pop('quarantine_id', None)
                except OSError:
                    finding['state'] = 'error_review'
            else:
                finding['state'] = 'found'
                finding.pop('quarantine_id', None)
            h.save_job(report)
            raise
        finally:
            try:
                os.unlink(temp, dir_fd=dfd)
            except FileNotFoundError:
                pass
            os.close(dfd)
            os.close(qfd)
        return {'message': 'Good-File eingespielt; infiziertes Original bleibt fuer Rollback in Quarantaene.'}
    finally:
        os.close(fd)


def repair_rollback(jobid, index):
    if not h.JOB_ID.fullmatch(jobid) or type(index) is not int or not 0 <= index < h.MAX_FINDINGS:
        raise ValueError('Ungueltiger Fundverweis.')
    fd = h.lock_scan()
    try:
        report = h.load_job(jobid)
        finding = report['findings'][index]
        if finding.get('state') != 'repaired':
            raise ValueError('Kein reparierter Fund.')
        docroot, _, _ = h.site_docroot(report['domain'])
        current, dfd, leaf = h.file_metadata(docroot, finding['path'])
        qfd = os.open(str(h.ROOT / 'quarantine'), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            if current['sha256'] != finding['repaired_sha256']:
                raise ValueError('Reparierte Datei wurde geaendert; Rollback verweigert.')
            qname = finding['quarantine_id']
            if not re.fullmatch(r'[a-f0-9-]{67,75}', qname):
                raise ValueError('Ungueltige Quarantaene-ID.')
            # Atomic exchange never leaves the destination missing and retains good-file copy.
            libc = ctypes.CDLL(None, use_errno=True)
            exchange = getattr(libc, 'renameat2', None)
            if exchange is None:
                raise ValueError('Sicherer Rollback benoetigt Linux renameat2.')
            if exchange(dfd, os.fsencode(leaf), qfd, os.fsencode(qname), 2) != 0:
                raise OSError(ctypes.get_errno(), 'Rollback-Austausch fehlgeschlagen')
            finding.update(state='rolled_back', rolled_back_at=h.utc_now())
            h.save_job(report)
        finally:
            os.close(dfd)
            os.close(qfd)
        h.incident_log('operator', 'critical', report['domain'], 'Reparatur zurueckgenommen; Malware kann wieder aktiv sein.', finding['path'])
        return {'message': 'Original zurueckgespielt. Achtung: Die Datei kann infiziert sein.'}
    finally:
        os.close(fd)


def auto_repair(jobid):
    report = h.load_job(jobid)
    if not report:
        return
    settings = config()
    selected = settings.get('autorepair', {}).get(report['domain'])
    if not selected or selected != settings.get('baselines', {}).get(report['domain'], {}).get('id'):
        return
    raw_ignored = settings.get('ignore_hashes', {})
    ignored_hashes = raw_ignored.get(report['domain'], []) if isinstance(raw_ignored, dict) else []
    if not isinstance(ignored_hashes, list):
        ignored_hashes = []
    global_ignored = settings.get('global_ignore_hashes', [])
    if not isinstance(global_ignored, list):
        global_ignored = []
    ignored_hashes = set(ignored_hashes) | set(global_ignored)
    for index, finding in enumerate(report.get('findings', [])):
        sha = (finding.get('fingerprint') or {}).get('sha256')
        if (finding.get('state') == 'found' and finding.get('ignored') is not True and
                sha not in ignored_hashes):
            try:
                repair_one(jobid, index, blocking=True)
            except (ValueError, OSError, KeyError, IndexError):
                h.incident_log('operator', 'warning', report['domain'], 'Automatische Reparatur abgelehnt; manuelle Pruefung erforderlich.', finding.get('path', ''))


def write_guard(folder, data, gid):
    folderfd = os.open(str(folder), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    temp = '.guard-' + uuid.uuid4().hex
    try:
        st = os.fstat(folderfd)
        if st.st_uid != 0 or st.st_mode & 0o027:
            raise ValueError('Guardian-Verzeichnis zwischenzeitlich geaendert.')
        guardfd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o640, dir_fd=folderfd)
        with os.fdopen(guardfd, 'wb') as output:
            os.fchown(output.fileno(), 0, gid)
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.rename(temp, 'guard.php', src_dir_fd=folderfd, dst_dir_fd=folderfd)
    finally:
        try:
            os.unlink(temp, dir_fd=folderfd)
        except FileNotFoundError:
            pass
        os.close(folderfd)


def bots_set(domain, mode):
    if mode not in ('on', 'off'):
        raise ValueError('Ungueltiger Bot-Modus.')
    docroot, uid, gid = h.site_docroot(domain)
    settings = config()
    # Store guard outside document root but inside subscription. Website UID can read it.
    home = pathlib.Path(h.plesk_hosting_path(domain)[1]).resolve(strict=True)
    if os.path.commonpath((str(home), str(docroot))) != str(home):
        raise ValueError('Webspace geaendert.')
    folder = home / ('.guardian-' + hashlib.sha256(domain.encode('ascii')).hexdigest()[:16])
    if re.search(r'["\\\r\n\x00]', str(folder)):
        raise ValueError('Webspace-Pfad kann nicht sicher in PHP-INI dargestellt werden.')
    record = settings.get('bots', {}).get(domain, {})
    dfd = os.open(str(docroot), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        try:
            fd = os.open('.user.ini', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
            with os.fdopen(fd, 'rb') as stream:
                st = os.fstat(stream.fileno())
                if not stat.S_ISREG(st.st_mode) or st.st_size > 64000 or st.st_uid not in (0, uid):
                    raise ValueError('Unsichere .user.ini.')
                current = stream.read(64001)
        except FileNotFoundError:
            current = b''
        text = current.decode('utf-8')
        if mode == 'on':
            if record.get('enabled'):
                raise ValueError('Bot-Pruefung ist bereits konfiguriert; zuerst deaktivieren.')
            if re.search(r'^\s*auto_prepend_file\s*=', text, re.M | re.I):
                raise ValueError('Bestehendes auto_prepend_file wird nicht ueberschrieben.')
            if not settings.get('cloud_consent') or not settings.get('turnstile_sitekey') or not settings.get('turnstile_secret'):
                raise ValueError('Turnstile-Schluessel und Zustimmung fehlen.')
            if folder.exists() or folder.is_symlink():
                # Existing directory is accepted only when it is our root-owned private directory.
                st = folder.lstat()
                if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o027:
                    raise ValueError('Unsicheres Guardian-Verzeichnis im Webspace.')
            else:
                folder.mkdir(mode=0o750)
                os.chown(folder, 0, gid)
            data = {'domain': domain, 'sitekey': settings['turnstile_sitekey'],
                    'secret': settings['turnstile_secret'], 'signing_key': os.urandom(32).hex()}
            template = (HERE / 'guardian-bot-guard.php').read_text(encoding='utf-8')
            encoded = base64.b64encode(json.dumps(data).encode()).decode('ascii')
            template = template.replace('/* GUARDIAN_CONFIG */', "$guardianConfig = json_decode(base64_decode('%s'), true);" % encoded)
            php = h.binary(('/usr/bin/php', '/opt/plesk/php/8.3/bin/php'))
            if not php:
                raise ValueError('PHP CLI fuer Syntaxpruefung fehlt.')
            run([php, '-l'], input=template.encode('utf-8'))
            write_guard(folder, template.encode('utf-8'), gid)
            block = '\n' + BEGIN + 'auto_prepend_file="%s"\n' % (folder / 'guard.php') + END
            updated = current + block.encode('utf-8')
            record = {'enabled': True, 'before': base64.b64encode(current).decode('ascii'),
                      'installed_sha256': digest(updated), 'guard': str(folder / 'guard.php')}
        else:
            if not record.get('enabled'):
                raise ValueError('Kein von Guardian aktivierter Bot-Schutz vorhanden.')
            if digest(current) != record.get('installed_sha256'):
                raise ValueError('.user.ini zwischenzeitlich geaendert; keine automatische Ruecksetzung.')
            updated = base64.b64decode(record['before'], validate=True)
            record = {'enabled': False, 'guard': str(folder / 'guard.php')}
        temp = '.guardian-ini-' + uuid.uuid4().hex
        fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=dfd)
        try:
            with os.fdopen(fd, 'wb') as output:
                os.fchown(output.fileno(), uid, gid)
                output.write(updated)
                output.flush()
                os.fsync(output.fileno())
            # Require unchanged source immediately before replacing it.
            try:
                checkfd = os.open('.user.ini', os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dfd)
                with os.fdopen(checkfd, 'rb') as inp:
                    unchanged = inp.read(64001) == current
            except FileNotFoundError:
                unchanged = current == b''
            if not unchanged:
                raise ValueError('.user.ini waehrend Aktion geaendert.')
            os.rename(temp, '.user.ini', src_dir_fd=dfd, dst_dir_fd=dfd)
            if mode == 'off':
                # Cached .user.ini may still prepend this file. Keep a harmless stub,
                # removing provider secrets from disk as soon as the guard is disabled.
                write_guard(folder, b'<?php return; // Guardian disabled\n', gid)
        finally:
            try:
                os.unlink(temp, dir_fd=dfd)
            except FileNotFoundError:
                pass
    finally:
        os.close(dfd)
    settings.setdefault('bots', {})[domain] = record
    save_config(settings)
    # Keep guard when disabling: PHP user_ini cache can still refer to it for 300 seconds.
    h.incident_log('operator', 'warning', domain, 'Turnstile PHP-Anmeldeschutz ' + mode)
    return {'message': 'Bot-Schutz konfiguriert. PHP .user.ini-Cache kann bis zu 5 Minuten benoetigen; HTTPS-Anmeldung testen.'}


def cron_audit():
    """Read-only heuristic audit of common system and user cron locations."""
    if os.geteuid() != 0:
        raise ValueError('Cronjob-Pruefung erfordert Root-Leserechte.')
    files = set(CRON_FILES)
    skipped = 0
    for directory in CRON_DIRS:
        try:
            dfd = os.open(str(directory), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        except FileNotFoundError:
            continue
        except OSError:
            skipped += 1
            continue
        try:
            for entry in os.scandir(dfd):
                try:
                    if entry.is_file(follow_symlinks=False) and re.fullmatch(r'[A-Za-z0-9_.-]{1,128}', entry.name):
                        files.add(directory / entry.name)
                except OSError:
                    skipped += 1
        finally:
            os.close(dfd)
    if len(files) > 256:
        files = set(sorted(files, key=str)[:256])
        skipped += 1
    findings = []
    signature_sources = []
    scanned = 0
    total = 0
    for path in sorted(files, key=str):
        try:
            fd = os.open(str(path), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(fd, 'rb') as source:
                info = os.fstat(source.fileno())
                if not stat.S_ISREG(info.st_mode) or info.st_size > 131072:
                    skipped += 1
                    continue
                total += info.st_size
                if total > 4 * 1024 * 1024:
                    skipped += 1
                    break
                data = source.read(131073)
                if len(data) > 131072:
                    skipped += 1
                    continue
        except FileNotFoundError:
            continue
        except OSError:
            skipped += 1
            continue
        scanned += 1
        if data:
            signature_sources.append((str(path), data))
        for number, raw in enumerate(data.decode('utf-8', 'replace').splitlines(), 1):
            line = raw.strip()
            if not line or line.startswith('#') or len(line) > 4096:
                continue
            for code, pattern in CRON_PATTERNS:
                if pattern.search(line):
                    findings.append({'source': str(path), 'line': number, 'rule': code,
                                     'severity': 'warning'})
                    break
            if len(findings) >= 100:
                skipped += 1
                break
        if len(findings) >= 100:
            break
    clamav = {'status': 'unavailable', 'finding_count': 0, 'findings': [],
              'note': 'ClamAV-Signaturscan fuer Cron-Dateien nicht ausgefuehrt.'}
    scanner = h.binary(h.CLAM_PATHS)
    if scanner and signature_sources:
        total_cron_bytes = sum(len(data) for _, data in signature_sources)
        if total_cron_bytes > CRON_CLAM_MAX_BYTES:
            clamav.update(status='partial', note='Cron-Dateien ueberschreiten das 4-MiB-Limit; Signaturscan ausgelassen.')
        else:
            try:
                with tempfile.TemporaryDirectory(prefix='guardian-cron-scan-') as scan_dir:
                    source_by_name = {}
                    for index, (source, data) in enumerate(signature_sources):
                        name = 'cron-%03d' % index
                        target = pathlib.Path(scan_dir) / name
                        fd = os.open(str(target), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                        with os.fdopen(fd, 'wb') as output:
                            output.write(data)
                        source_by_name[name] = source
                    result = subprocess.run(
                        [scanner, '--infected', '--no-summary', '--max-files=256',
                         '--max-filesize=131072', '--max-scansize=%d' % CRON_CLAM_MAX_BYTES,
                         scan_dir], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                        stderr=subprocess.DEVNULL, timeout=CRON_CLAM_TIMEOUT, check=False,
                        close_fds=True, cwd='/', env={'PATH': '/usr/bin:/bin', 'LANG': 'C'})
                raw_output = result.stdout[:65536]
                output = (raw_output.decode('utf-8', 'replace') if isinstance(raw_output, bytes)
                          else str(raw_output))
                hits = []
                for line in output.splitlines():
                    match = CRON_CLAM_SIGNATURE.fullmatch(line.strip())
                    if not match:
                        continue
                    name = os.path.basename(match.group(1))
                    if name in source_by_name and len(hits) < 100:
                        hits.append({'source': source_by_name[name], 'signature': match.group(2)})
                if result.returncode == 0:
                    clamav.update(status='no_signatures', finding_count=0, findings=hits,
                                   note='Lokaler ClamAV-Signaturscan der erfassten Cron-Dateien; keine Aenderungen.')
                elif result.returncode == 1:
                    clamav.update(status='found' if hits else 'partial', finding_count=len(hits), findings=hits,
                                   note='ClamAV meldete Cron-Datei-Treffer; manuell untersuchen, Guardian aendert nichts.')
                else:
                    clamav.update(status='error', note='ClamAV-Cron-Signaturscan fehlgeschlagen (Exit-Code %d).' % result.returncode)
            except subprocess.TimeoutExpired:
                clamav.update(status='partial', note='ClamAV-Cron-Signaturscan nach 45 Sekunden abgebrochen.')
            except (OSError, subprocess.SubprocessError) as exc:
                clamav.update(status='error', note='ClamAV-Cron-Signaturscan fehlgeschlagen: ' + str(exc)[:120])
    elif not signature_sources:
        clamav.update(status='no_sources', note='Keine lesbaren Cron-Dateien mit Inhalt gefunden.')
    result = {'generated_at': h.utc_now(), 'scanned_sources': scanned,
              'finding_count': len(findings), 'findings': findings,
              'clamav': clamav,
              'partial': skipped > 0, 'skipped_sources': skipped,
              'note': 'Heuristische Pruefung und optionaler lokaler ClamAV-Signaturscan ueblicher Cron-Pfade. Kein vollstaendiger Malware-Nachweis; Eintraege werden nicht veraendert.'}
    h.write_json(root() / 'cron-audit.json', result)
    if findings:
        h.incident_log('cron_suspicious', 'warning', detail='%d verdaechtige Cron-Eintraege; manuelle Pruefung erforderlich.' % len(findings))
    if clamav.get('status') == 'found':
        h.incident_log('cron_suspicious', 'warning', detail='%d ClamAV-Treffer in Cron-Dateien; manuelle Pruefung erforderlich.' % clamav['finding_count'])
    return result


def wordpress_site_context(domain):
    if os.geteuid() != 0 or not h.valid_domain(domain):
        raise ValueError('Gueltige Domain und Root-Verwaltung erforderlich.')
    docroot, uid, gid = h.site_docroot(domain)
    for relative in ('wp-load.php', 'wp-includes/version.php'):
        cursor = docroot
        components = relative.split('/')
        for index, component in enumerate(components):
            cursor = cursor / component
            try:
                info = cursor.lstat()
                resolved = cursor.resolve(strict=True)
            except OSError:
                raise ValueError('Kein vollstaendiger WordPress-Core im Document-Root gefunden.')
            if (stat.S_ISLNK(info.st_mode) or
                    (index < len(components) - 1 and not stat.S_ISDIR(info.st_mode)) or
                    (index == len(components) - 1 and not stat.S_ISREG(info.st_mode)) or
                    os.path.commonpath((str(docroot), str(resolved))) != str(docroot)):
                raise ValueError('WordPress-Core-Pruefung lehnt Symlinks und Sonderdateien ab.')
    return docroot, uid, gid


def wordpress_cli_context(domain):
    docroot, uid, gid = wordpress_site_context(domain)
    cli = h.binary(WP_CLI_PATHS)
    if not cli:
        raise ValueError('WP-CLI fehlt. Fuer die Pruefsummen WP-CLI als root-eigene Systemdatei bereitstellen.')
    executable = pathlib.Path(cli).resolve(strict=True)
    cli_stat = executable.stat()
    if (not stat.S_ISREG(cli_stat.st_mode) or cli_stat.st_uid != 0 or
            cli_stat.st_mode & 0o022 or not os.access(executable, os.X_OK)):
        raise ValueError('WP-CLI muss eine root-eigene, nicht gruppen-/weltbeschreibbare Systemdatei sein.')
    parent = executable.parent
    while parent != parent.parent:
        parent_stat = parent.stat()
        if not stat.S_ISDIR(parent_stat.st_mode) or parent_stat.st_uid != 0 or parent_stat.st_mode & 0o022:
            raise ValueError('WP-CLI-Verzeichnisse muessen root-eigen und nicht gruppen-/weltbeschreibbar sein.')
        parent = parent.parent
    return docroot, uid, gid, executable


def wordpress_checksum_audit(domain, kind):
    """Compare WordPress core or WordPress.org plugins using WP-CLI as the site's UID."""
    if kind not in ('core', 'plugins'):
        raise ValueError('Ungueltige WordPress-Pruefung.')
    docroot, uid, gid, executable = wordpress_cli_context(domain)
    result = None
    output = ''
    truncated = False
    try:
        with tempfile.TemporaryDirectory(prefix='guardian-wp-cli-') as home:
            os.chown(home, uid, gid)
            os.chmod(home, 0o700)
            env = {'PATH': '/usr/bin:/bin', 'HOME': home, 'LANG': 'C', 'TERM': 'dumb',
                   'WP_CLI_CONFIG_PATH': str(pathlib.Path(home) / 'config.yml'),
                   'WP_CLI_PACKAGES_DIR': str(pathlib.Path(home) / 'packages'),
                   'WP_CLI_CACHE_DIR': str(pathlib.Path(home) / 'cache'),
                   'WP_CLI_DISABLE_AUTO_CHECK_UPDATE': '1'}
            args = [str(executable), '--path=' + str(docroot), '--skip-plugins', '--skip-themes',
                    '--skip-packages', '--no-color']
            args.extend(['core', 'verify-checksums'] if kind == 'core' else
                        ['plugin', 'verify-checksums', '--all'])
            with tempfile.TemporaryFile() as log:
                result = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                                        timeout=300, cwd='/', check=False, preexec_fn=lambda: h.drop_privileges(uid, gid),
                                        env=env)
                log.seek(0)
                raw = log.read(5 * 1024 * 1024 + 1)
                truncated = len(raw) > 5 * 1024 * 1024
                output = raw[:5 * 1024 * 1024].decode('utf-8', 'replace')
    except subprocess.TimeoutExpired:
        raise ValueError('WordPress-Pruefung nach fuenf Minuten abgebrochen.')
    findings = []
    unverified_plugins = []
    for line in output.splitlines():
        match = WP_HASH_WARNING.match(line)
        if match:
            relative = match.group(1).replace('\\', '/')
            if h.safe_relative(relative) and len(findings) < 100:
                findings.append({'path': relative,
                                 'rule': 'wordpress-core-checksum-mismatch' if kind == 'core' else
                                 'wordpress-plugin-checksum-mismatch'})
            continue
        if kind == 'plugins':
            skipped = WP_PLUGIN_SKIP_WARNING.match(line)
            if skipped and len(unverified_plugins) < 100:
                unverified_plugins.append(skipped.group(1))
    if truncated:
        status = 'incomplete'
    elif findings:
        status = 'mismatch'
    elif result.returncode == 0 and unverified_plugins:
        status = 'partial'
    elif result.returncode == 0:
        status = 'verified'
    else:
        status = 'error'
    subject = 'Core-Dateien' if kind == 'core' else 'Plugins'
    note = ('WP-CLI vergleicht WordPress-Core-Dateien mit WordPress.org-MD5-Pruefsummen ueber HTTPS.'
            if kind == 'core' else
            'WP-CLI prueft Plugins mit verfuegbaren WordPress.org-Pruefsummen; kommerzielle/eigene Plugins koennen nicht abgedeckt sein.')
    report = {'domain': domain, 'kind': kind, 'checked_at': h.utc_now(), 'status': status,
              'finding_count': len(findings), 'findings': findings,
              'unverified_plugins': sorted(set(unverified_plugins)),
              'note': note + ' Kein signierter Paketnachweis; keine Datei wird geaendert.'}
    h.write_json(root() / ('wordpress-checksum.json' if kind == 'core' else 'wordpress-plugin-checksum.json'), report)
    if status == 'mismatch':
        h.incident_log('cms_checksum_mismatch', 'warning', domain,
                       '%d WordPress-%s stimmen nicht mit WordPress.org-Pruefsummen ueberein.' %
                       (len(findings), subject),
                       findings[0]['path'] if findings else '')
    elif status == 'verified':
        h.incident_log('operator', 'info', domain, 'WordPress-%s erfolgreich verifiziert.' % subject)
    return report


def wp_db_indicator_predicate(column):
    if column not in {name for _, columns in WP_DB_SCAN_TABLES.values() for name in columns}:
        raise ValueError('Ungueltige WordPress-Datenbankspalte.')
    value = "LOWER(COALESCE(`%s`, ''))" % column
    encoded = " OR ".join("LOCATE('%s', %s) > 0" % (marker, value)
                          for marker in ('base64_decode', 'gzinflate', 'str_rot13'))
    execution = " OR ".join("LOCATE('%s(', %s) > 0" % (marker, value)
                            for marker in ('eval', 'assert', 'create_function'))
    shell = " OR ".join("LOCATE('%s(', %s) > 0" % (marker, value)
                        for marker in ('shell_exec', 'passthru', 'proc_open'))
    return "(((%s) AND ((%s) OR (%s))))" % (encoded, execution, shell)


def wp_db_scan_store(report):
    path = root() / 'wordpress-dbscan.json'
    state = h.read_json(path, {'reports': {}})
    reports = state.get('reports', {}) if isinstance(state, dict) else {}
    if not isinstance(reports, dict):
        reports = {}
    reports[report['domain']] = report
    if len(reports) > 5:
        keep = sorted(reports, key=lambda key: reports[key].get('checked_at', ''), reverse=True)[:5]
        reports = {key: reports[key] for key in keep}
    h.write_json(path, {'reports': reports})


def wordpress_database_audit(domain):
    """Read-only scan for paired obfuscation/execution indicators in core WP text tables."""
    docroot, uid, gid, executable = wordpress_cli_context(domain)
    deadline = time.monotonic() + WP_DB_SCAN_TIMEOUT
    findings = []
    scanned_tables = []
    skipped_tables = []
    truncated = False
    failed = False
    error = ''
    base = [str(executable), '--path=' + str(docroot), '--url=https://' + domain,
            '--skip-plugins', '--skip-themes', '--skip-packages', '--no-color', '--quiet']
    try:
        with tempfile.TemporaryDirectory(prefix='guardian-wp-db-') as home:
            os.chown(home, uid, gid)
            os.chmod(home, 0o700)
            env = {'PATH': '/usr/bin:/bin', 'HOME': home, 'LANG': 'C', 'TERM': 'dumb',
                   'WP_CLI_CONFIG_PATH': str(pathlib.Path(home) / 'config.yml'),
                   'WP_CLI_PACKAGES_DIR': str(pathlib.Path(home) / 'packages'),
                   'WP_CLI_CACHE_DIR': str(pathlib.Path(home) / 'cache'),
                   'WP_CLI_DISABLE_AUTO_CHECK_UPDATE': '1'}

            def invoke(args, input_data=None, output_limit=65536):
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise subprocess.TimeoutExpired(args, WP_DB_SCAN_TIMEOUT)
                with tempfile.TemporaryFile() as output:
                    try:
                        result = subprocess.run(args, input=input_data, stdout=output, stderr=subprocess.STDOUT,
                                                timeout=min(remaining, 120), cwd='/', check=False,
                                                preexec_fn=lambda: h.drop_privileges(uid, gid, cpu_limit=120), env=env)
                    except subprocess.TimeoutExpired:
                        raise
                    output.seek(0)
                    raw = output.read(output_limit + 1)
                    return raw[:output_limit].decode('utf-8', 'replace'), len(raw) > output_limit, result.returncode

            prefix_output, prefix_truncated, prefix_rc = invoke(base + ['db', 'prefix'])
            prefix = prefix_output.strip()
            if prefix_rc or prefix_truncated or not re.fullmatch(r'[A-Za-z0-9_]{1,48}', prefix):
                raise ValueError('WordPress-Tabellenpraefix konnte nicht sicher ermittelt werden.')
            table_output, table_truncated, table_rc = invoke(base + ['db', 'tables', '--scope=blog', '--format=list'])
            if table_rc or table_truncated:
                raise ValueError('WordPress-Tabellenliste ueberschreitet das sichere Limit.')
            tables = set()
            for line in table_output.splitlines():
                name = line.strip()
                if not re.fullmatch(r'[A-Za-z0-9_]{1,64}', name) or not name.startswith(prefix):
                    continue
                suffix = name[len(prefix):]
                if suffix in WP_DB_SCAN_TABLES:
                    tables.add(suffix)
            for suffix in ('posts', 'postmeta', 'options', 'comments', 'commentmeta'):
                if suffix not in tables:
                    # Comments are optional features in WordPress; absence alone is not a partial scan.
                    if suffix in ('posts', 'postmeta', 'options'):
                        skipped_tables.append(suffix)
                    continue
                identifier, columns = WP_DB_SCAN_TABLES[suffix]
                table_name = '`' + prefix + suffix + '`'
                predicates = [wp_db_indicator_predicate(column) for column in columns]
                if len(columns) == 1:
                    selected_column = "'%s'" % columns[0]
                else:
                    selected_column = "CASE WHEN %s THEN '%s' ELSE '%s' END" % (
                        predicates[0], columns[0], columns[1])
                where = ' OR '.join(predicates)
                sql = ('SELECT CAST(`%s` AS CHAR), %s, \'obfuscated-execution\' FROM %s '
                       'WHERE (%s) ORDER BY `%s` LIMIT 101;\n') % (
                           identifier, selected_column, table_name, where, identifier)
                output, output_truncated, query_rc = invoke(
                    base + ['db', 'query', '--skip-column-names', '--batch', '--raw', '--silent'],
                    input_data=sql.encode('ascii'), output_limit=WP_DB_SCAN_MAX_OUTPUT)
                if output_truncated or query_rc:
                    truncated = True
                    failed = True
                    skipped_tables.append(suffix)
                    break
                scanned_tables.append(suffix)
                rows = output.splitlines()
                if len(rows) > 100:
                    truncated = True
                    rows = rows[:100]
                for row in rows:
                    parts = row.split('\t')
                    if len(parts) != 3 or not re.fullmatch(r'\d{1,20}', parts[0]) or \
                            parts[1] not in columns or parts[2] != 'obfuscated-execution':
                        failed = True
                        continue
                    findings.append({'table': suffix, 'row_id': parts[0],
                                     'column': parts[1], 'rule': parts[2]})
                    if len(findings) >= WP_DB_SCAN_MAX_FINDINGS:
                        truncated = True
                        break
                if truncated and len(findings) >= WP_DB_SCAN_MAX_FINDINGS:
                    break
    except subprocess.TimeoutExpired:
        failed = True
        truncated = True
    except (OSError, ValueError) as exc:
        # Keep database errors and config values out of reports; only a bounded generic reason is shown.
        failed = True
        error = str(exc)[:180]
    if failed or truncated or skipped_tables:
        status = 'partial'
    elif findings:
        status = 'candidates'
    else:
        status = 'no_indicators'
    report = {'domain': domain, 'checked_at': h.utc_now(), 'status': status,
              'tables_scanned': scanned_tables, 'tables_skipped': sorted(set(skipped_tables)),
              'finding_count': len(findings), 'findings': findings, 'truncated': truncated,
              'note': 'Read-only Heuristik fuer kombinierte Verschleierungs-/Ausfuehrungsmuster in WordPress-Texttabellen. Kein Malware-Vollnachweis; kein Inhalt wird ausgegeben oder geaendert.'}
    if error:
        report['error'] = error
    wp_db_scan_store(report)
    if findings:
        h.incident_log('cms_database_indicators', 'warning', domain,
                       '%d WordPress-Datenbankkandidaten mit kombinierten Verschleierungs-/Ausfuehrungsindikatoren; manuelle Pruefung erforderlich.' % len(findings))
    return report


def wordpress_database_clamav_store(report):
    path = root() / 'wordpress-db-clamav.json'
    state = h.read_json(path, {'reports': {}})
    reports = state.get('reports', {}) if isinstance(state, dict) else {}
    if not isinstance(reports, dict):
        reports = {}
    reports[report['domain']] = report
    if len(reports) > 20:
        keep = sorted(reports, key=lambda key: reports[key].get('checked_at', ''), reverse=True)[:20]
        reports = {key: reports[key] for key in keep}
    h.write_json(path, {'reports': reports})


def php_config_tokens(source):
    tokens = []
    position = 0
    while position < len(source):
        match = PHP_CONFIG_TOKEN.match(source, position)
        if not match:
            raise ValueError('PHP-Konfiguration enthaelt nicht-statische Syntax.')
        token = match.group(0)
        position = match.end()
        if token.isspace() or token.startswith('//') or token.startswith('#') or token.startswith('/*'):
            continue
        tokens.append(token)
    return tokens


def php_config_string(token):
    if len(token) < 2 or token[0] not in "'\"" or token[-1] != token[0]:
        raise ValueError('PHP-Konfiguration enthaelt keinen statischen String.')
    quote = token[0]
    body = token[1:-1]
    if quote == "'":
        return re.sub(r"\\([\\'])", r'\1', body)
    if '$' in body or '`' in body:
        raise ValueError('PHP-Interpolation in Konfiguration wird nicht ausgefuehrt.')
    escapes = {'n': '\n', 'r': '\r', 't': '\t', 'v': '\v', 'e': '\x1b',
               'f': '\f', '\\': '\\', '"': '"', '$': '$'}
    result = []
    index = 0
    while index < len(body):
        char = body[index]
        if char != '\\':
            result.append(char)
            index += 1
            continue
        index += 1
        if index >= len(body):
            raise ValueError('Ungueltige String-Escape-Sequenz in PHP-Konfiguration.')
        escaped = body[index]
        if escaped == 'x' and index + 2 < len(body) and re.fullmatch(r'[0-9A-Fa-f]{2}', body[index + 1:index + 3]):
            result.append(chr(int(body[index + 1:index + 3], 16)))
            index += 3
        elif escaped in escapes:
            result.append(escapes[escaped])
            index += 1
        else:
            # PHP preserves a backslash for unrecognized escapes in double-quoted strings.
            result.extend(('\\', escaped))
            index += 1
    return ''.join(result)


class PHPStaticArrayParser:
    """Parse PHP literal arrays without evaluating an application config file."""

    def __init__(self, tokens):
        self.tokens = tokens
        self.index = 0

    def take(self, expected=None):
        if self.index >= len(self.tokens):
            raise ValueError('Unvollstaendige PHP-Konfiguration.')
        token = self.tokens[self.index]
        if expected is not None and token != expected:
            raise ValueError('PHP-Konfiguration ist keine statische Literal-Arraystruktur.')
        self.index += 1
        return token

    def peek(self):
        return self.tokens[self.index] if self.index < len(self.tokens) else None

    def value(self):
        token = self.peek()
        if token in ('[', 'array'):
            if token == 'array':
                self.take('array')
                self.take('(')
                closing = ')'
            else:
                self.take('[')
                closing = ']'
            result = {}
            next_index = 0
            while self.peek() != closing:
                if self.peek() is None:
                    raise ValueError('Unvollstaendiges PHP-Array.')
                first = self.value()
                if self.peek() == '=>':
                    self.take('=>')
                    key = first
                    value = self.value()
                else:
                    key = next_index
                    next_index += 1
                    value = first
                if not isinstance(key, (str, int)) or key in result:
                    raise ValueError('Doppelte oder dynamische PHP-Array-Schluessel.')
                result[key] = value
                if self.peek() == ',':
                    self.take(',')
                    if self.peek() == closing:
                        break
                elif self.peek() != closing:
                    raise ValueError('Unerwartete PHP-Array-Syntax.')
            self.take(closing)
            return result
        if token is None:
            raise ValueError('Leerer PHP-Konfigurationswert.')
        if token.startswith(("'", '"')):
            return php_config_string(self.take())
        if token.isdigit():
            return int(self.take())
        if token == 'true':
            self.take()
            return True
        if token == 'false':
            self.take()
            return False
        if token == 'null':
            self.take()
            return None
        raise ValueError('Dynamischer PHP-Konfigurationswert wird nicht ausgewertet.')


def read_bounded_site_config(path, allowed_root):
    """Read a small config via no-follow directory descriptors to close symlink races."""
    path = pathlib.Path(path)
    allowed_root = pathlib.Path(allowed_root).resolve(strict=True)
    try:
        relative = path.relative_to(allowed_root)
    except ValueError:
        raise ValueError('CMS-Konfiguration liegt ausserhalb des Plesk-Webspaces.')
    if not relative.parts or any(component in ('', '.', '..') for component in relative.parts):
        raise ValueError('Ungueltiger CMS-Konfigurationspfad.')
    flags_dir = os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0) | getattr(os, 'O_NOFOLLOW', 0)
    flags_file = os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0)
    directory = os.open(str(allowed_root), flags_dir)
    try:
        for component in relative.parts[:-1]:
            child = os.open(component, flags_dir, dir_fd=directory)
            os.close(directory)
            directory = child
        descriptor = os.open(relative.parts[-1], flags_file, dir_fd=directory)
        try:
            info = os.fstat(descriptor)
            if not stat.S_ISREG(info.st_mode) or info.st_size > CMS_DB_MAX_CONFIG:
                raise ValueError('CMS-Konfiguration ist keine begrenzte regulaere Datei.')
            chunks = []
            remaining = CMS_DB_MAX_CONFIG + 1
            while remaining:
                chunk = os.read(descriptor, min(65536, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
            raw = b''.join(chunks)
            if len(raw) > CMS_DB_MAX_CONFIG:
                raise ValueError('CMS-Konfiguration ist zu gross.')
        finally:
            os.close(descriptor)
    finally:
        os.close(directory)
    try:
        source = raw.decode('utf-8')
    except UnicodeDecodeError:
        raise ValueError('CMS-Konfiguration ist keine UTF-8-Datei.')
    return source


def read_static_php_return_array(path, allowed_root):
    """Read a bounded, symlink-free PHP file containing only a literal return array."""
    source = read_bounded_site_config(path, allowed_root)
    tokens = php_config_tokens(source)
    if not tokens or tokens[0] != '<?php':
        raise ValueError('PHP-Konfiguration hat kein erwartetes PHP-Format.')
    parser = PHPStaticArrayParser(tokens[1:])
    parser.take('return')
    result = parser.value()
    parser.take(';')
    if parser.peek() == '?>':
        parser.take('?>')
    if parser.peek() is not None or not isinstance(result, dict):
        raise ValueError('PHP-Konfiguration enthaelt weitere oder dynamische Anweisungen.')
    return result


def php_source_tokens(source):
    """Tokenize enough PHP syntax to identify real property assignments outside strings/comments."""
    tokens = []
    index = 0
    while index < len(source):
        if source[index].isspace():
            index += 1
            continue
        if source.startswith('//', index) or source[index] == '#' and not source.startswith('#[', index):
            end = source.find('\n', index)
            index = len(source) if end < 0 else end + 1
            continue
        if source.startswith('/*', index):
            end = source.find('*/', index + 2)
            if end < 0:
                raise ValueError('Unvollstaendiger PHP-Kommentar.')
            index = end + 2
            continue
        char = source[index]
        if source.startswith('<<<', index) or char == '`':
            raise ValueError('Heredoc- oder Shell-Syntax in Joomla-Konfiguration wird nicht ausgewertet.')
        if char in ("'", '"'):
            start = index
            quote = char
            index += 1
            while index < len(source):
                if source[index] == '\\':
                    index += 2
                    continue
                if source[index] == quote:
                    index += 1
                    break
                index += 1
            else:
                raise ValueError('Ungueltiger String in Joomla-Konfiguration.')
            tokens.append(('string', source[start:index]))
            continue
        variable = re.match(r'\$[A-Za-z_][A-Za-z0-9_]*', source[index:])
        if variable:
            tokens.append(('variable', variable.group(0)[1:]))
            index += len(variable.group(0))
            continue
        identifier = re.match(r'[A-Za-z_][A-Za-z0-9_]*', source[index:])
        if identifier:
            tokens.append(('identifier', identifier.group(0)))
            index += len(identifier.group(0))
            continue
        if char == '#' and source.startswith('#[', index):
            tokens.extend((('symbol', '#'), ('symbol', '[')))
            index += 2
            continue
        tokens.append(('symbol', char))
        index += 1
    return tokens


def static_joomla_database_config(path, allowed_root):
    """Extract only literal Joomla database properties; never include configuration.php."""
    path = pathlib.Path(path)
    root_path = pathlib.Path(allowed_root).resolve(strict=True)
    source = read_bounded_site_config(path, root_path)
    properties = {}
    tokens = php_source_tokens(source)
    expected = {'dbtype', 'host', 'user', 'password', 'db', 'dbprefix'}
    for index in range(len(tokens) - 4):
        visibility, variable, equals, value, semicolon = tokens[index:index + 5]
        if (visibility[0] != 'identifier' or visibility[1] not in ('public', 'protected', 'private') or
                variable[0] != 'variable' or variable[1] not in expected or
                equals != ('symbol', '=') or semicolon != ('symbol', ';')):
            continue
        key = variable[1]
        if key in properties:
            raise ValueError('Doppelte Joomla-Datenbankkonfiguration.')
        properties[key] = php_config_string(value[1]) if value[0] == 'string' else None
    required = ('host', 'user', 'password', 'db')
    if any(key not in properties or properties[key] is None for key in required):
        raise ValueError('Joomla-Datenbankwerte sind nicht als statische Literale konfiguriert.')
    if properties.get('dbtype', 'mysqli').lower() not in ('mysqli', 'mysql'):
        raise ValueError('Joomla verwendet keinen unterstuetzten MySQL/MariaDB-Treiber.')
    config = {'host': properties['host'], 'user': properties['user'],
              'password': properties['password'], 'db': properties['db']}
    if properties.get('dbprefix'):
        config['prefix'] = properties['dbprefix']
    return validate_cms_database_config(config)


def validate_cms_database_config(config):
    """Bound and sanitize connection values before they reach option files or argv."""
    result = {}
    limits = {'host': 255, 'user': 128, 'password': 1024, 'db': 64, 'prefix': 64}
    for key, limit in limits.items():
        value = config.get(key, '')
        if not isinstance(value, str) or len(value) > limit or any(ord(ch) < 32 or ord(ch) == 127 for ch in value):
            raise ValueError('Ungueltige oder zu grosse CMS-Datenbankkonfiguration.')
        if key in ('host', 'user', 'db') and not value:
            raise ValueError('CMS-Datenbankkonfiguration ist unvollstaendig.')
        result[key] = value
    port = config.get('port')
    if port not in (None, ''):
        if isinstance(port, bool) or not str(port).isdigit() or not 1 <= int(port) <= 65535:
            raise ValueError('Ungueltiger Datenbank-Port in CMS-Konfiguration.')
        result['port'] = int(port)
    if not re.fullmatch(r'[A-Za-z0-9_.-]{1,64}', result['db']):
        raise ValueError('Ungueltiger Datenbankname in CMS-Konfiguration.')
    if result['host'] != 'localhost' and not re.fullmatch(r'[A-Za-z0-9_.:-]{1,255}', result['host']):
        raise ValueError('Ungueltiger Datenbankhost in CMS-Konfiguration.')
    if not re.fullmatch(r'[A-Za-z0-9_.@-]{1,128}', result['user']):
        raise ValueError('Ungueltiger Datenbankbenutzer in CMS-Konfiguration.')
    return result


def magento_database_config(path, allowed_root):
    settings = read_static_php_return_array(path, allowed_root)
    try:
        connection = settings['db']['connection']['default']
    except (KeyError, TypeError):
        raise ValueError('Magento-Datenbankverbindung wurde nicht statisch gefunden.')
    if not isinstance(connection, dict):
        raise ValueError('Magento-Datenbankverbindung ist keine Literal-Konfiguration.')
    config = {'host': connection.get('host'), 'user': connection.get('username'),
              'password': connection.get('password'), 'db': connection.get('dbname'),
              'port': connection.get('port'), 'prefix': settings['db'].get('table_prefix', '')}
    return validate_cms_database_config(config)


def trusted_system_binary(path, name):
    executable = pathlib.Path(path).resolve(strict=True)
    info = executable.stat()
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or
            info.st_mode & 0o022 or not os.access(executable, os.X_OK)):
        raise ValueError(name + ' muss eine root-eigene, nicht gruppen-/weltbeschreibbare Systemdatei sein.')
    parent = executable.parent
    while parent != parent.parent:
        parent_info = parent.stat()
        if not stat.S_ISDIR(parent_info.st_mode) or parent_info.st_uid != 0 or parent_info.st_mode & 0o022:
            raise ValueError(name + '-Verzeichnisse muessen root-eigen und nicht gruppen-/weltbeschreibbar sein.')
        parent = parent.parent
    return executable


def find_cms_database(domain):
    docroot, uid, gid = h.site_docroot(domain)
    detected = []
    if (docroot / 'wp-load.php').is_file() and (docroot / 'wp-includes' / 'version.php').is_file():
        detected.append('wordpress')
    joomla_config = docroot / 'configuration.php'
    if joomla_config.is_file():
        detected.append('joomla')
    candidates = [docroot / 'app' / 'etc' / 'env.php']
    if docroot.name.lower() == 'pub':
        candidates.append(docroot.parent / 'app' / 'etc' / 'env.php')
    if any(path.is_file() for path in candidates):
        detected.append('magento')
    if len(detected) != 1:
        raise ValueError('CMS-Datenbankkonfiguration fehlt oder ist im Document-Root nicht eindeutig.')
    return detected[0]


def cms_database_dump_context(domain, cms):
    docroot, uid, gid = h.site_docroot(domain)
    if cms == 'joomla':
        config_path = docroot / 'configuration.php'
        database = static_joomla_database_config(config_path, docroot)
        root_path = docroot
    elif cms == 'magento':
        candidates = [(docroot, docroot / 'app' / 'etc' / 'env.php')]
        if docroot.name.lower() == 'pub':
            candidates.append((docroot.parent, docroot.parent / 'app' / 'etc' / 'env.php'))
        found = [(base, config) for base, config in candidates if config.is_file()]
        if len(found) != 1:
            raise ValueError('Magento-Konfiguration ist im Document-Root nicht eindeutig.')
        root_path, config_path = found[0]
        if root_path != docroot and (root_path.stat().st_uid != uid or root_path.stat().st_gid != gid):
            raise ValueError('Magento-Projektverzeichnis gehoert nicht zum Website-Benutzer.')
        database = magento_database_config(config_path, root_path)
    else:
        raise ValueError('CMS-Datenbankexport fuer diesen CMS-Typ nicht verfuegbar.')
    dump_path = h.binary(('/usr/bin/mysqldump', '/usr/bin/mariadb-dump', '/bin/mysqldump'))
    if not dump_path:
        raise ValueError('mysqldump oder mariadb-dump fehlt.')
    return docroot, uid, gid, trusted_system_binary(dump_path, 'Datenbankexportprogramm'), database


def mysql_option_value(value):
    if not isinstance(value, str) or any(ch in value for ch in ('\x00', '\n', '\r')):
        raise ValueError('Datenbankverbindungswert kann nicht sicher in einer Optiondatei abgelegt werden.')
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"') + '"'


def wordpress_database_clamav_audit(domain):
    return cms_database_clamav_audit(domain, 'wordpress')


def cms_database_clamav_audit(domain, cms):
    """Stream a CMS SQL export through ClamAV without persisting a database dump."""
    if cms == 'wordpress':
        docroot, uid, gid, producer_executable = wordpress_cli_context(domain)
        database = None
    else:
        docroot, uid, gid, producer_executable, database = cms_database_dump_context(domain, cms)
    clam = h.binary(h.CLAM_PATHS)
    if not clam:
        raise ValueError('ClamAV fehlt. Fuer den Datenbank-Signaturscan clamscan installieren.')
    scanner = trusted_system_binary(clam, 'ClamAV')

    state = {'bytes': 0, 'truncated': False, 'pipe_error': False,
             'output_truncated': False, 'findings': []}
    producer = None
    scan = None
    threads = []
    error = ''
    timed_out = False
    deadline = time.monotonic() + WP_DB_SIGNATURE_TIMEOUT

    def kill_group(process):
        if process is None or process.poll() is not None:
            return
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except OSError:
            try:
                process.kill()
            except OSError:
                pass

    def pump_dump(source, target):
        try:
            while True:
                chunk = source.read(64 * 1024)
                if not chunk:
                    break
                room = WP_DB_SIGNATURE_MAX_BYTES - state['bytes']
                if len(chunk) > room:
                    if room > 0:
                        target.write(chunk[:room])
                        state['bytes'] += room
                    state['truncated'] = True
                    kill_group(producer)
                    break
                target.write(chunk)
                state['bytes'] += len(chunk)
        except (BrokenPipeError, OSError, ValueError):
            state['pipe_error'] = True
            kill_group(producer)
        finally:
            try:
                source.close()
            except OSError:
                pass
            try:
                target.close()
            except OSError:
                pass

    def read_scan_output(source):
        read_total = 0
        try:
            while True:
                line = source.readline(4096)
                if not line:
                    break
                read_total += len(line)
                if read_total > WP_DB_SIGNATURE_MAX_OUTPUT:
                    state['output_truncated'] = True
                    continue
                text_line = line.decode('utf-8', 'replace').strip()
                match = WP_DB_SIGNATURE_HIT.fullmatch(text_line)
                if match and len(state['findings']) < WP_DB_SIGNATURE_MAX_HITS:
                    state['findings'].append({'signature': match.group(1), 'rule': 'clamav-database-signature'})
                elif match:
                    state['output_truncated'] = True
        finally:
            try:
                source.close()
            except OSError:
                pass

    try:
        with tempfile.TemporaryDirectory(prefix='guardian-cms-db-clamav-') as home:
            env = {'PATH': '/usr/bin:/bin', 'HOME': home, 'LANG': 'C', 'TERM': 'dumb'}
            if cms == 'wordpress':
                env.update({'WP_CLI_CONFIG_PATH': str(pathlib.Path(home) / 'config.yml'),
                            'WP_CLI_PACKAGES_DIR': str(pathlib.Path(home) / 'packages'),
                            'WP_CLI_CACHE_DIR': str(pathlib.Path(home) / 'cache'),
                            'WP_CLI_DISABLE_AUTO_CHECK_UPDATE': '1'})
                producer_args = [str(producer_executable), '--path=' + str(docroot), '--url=https://' + domain,
                                 '--skip-plugins', '--skip-themes', '--skip-packages', '--no-color', '--quiet',
                                 'db', 'export', '-']
            else:
                option_file = pathlib.Path(home) / 'mysql-client.cnf'
                option_lines = ['[client]', 'host=' + mysql_option_value(database['host']),
                                'user=' + mysql_option_value(database['user']),
                                'password=' + mysql_option_value(database['password'])]
                if database.get('port'):
                    option_lines.append('port=%d' % database['port'])
                option_file.write_text('\n'.join(option_lines) + '\n', encoding='utf-8')
                os.chown(option_file, uid, gid)
                os.chmod(option_file, 0o600)
                producer_args = [str(producer_executable), '--defaults-extra-file=' + str(option_file),
                                 '--single-transaction', '--quick', '--skip-comments', '--no-tablespaces',
                                 '--hex-blob', '--', database['db']]
            os.chown(home, uid, gid)
            os.chmod(home, 0o700)
            clam_args = [str(scanner), '--infected', '--no-summary',
                         '--max-filesize=%d' % WP_DB_SIGNATURE_MAX_BYTES,
                         '--max-scansize=%d' % WP_DB_SIGNATURE_MAX_BYTES, '-']
            producer = subprocess.Popen(producer_args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, close_fds=True, start_new_session=True,
                                        cwd='/', env=env,
                                        preexec_fn=lambda: h.drop_privileges(uid, gid, cpu_limit=120))
            try:
                scan = subprocess.Popen(clam_args, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, close_fds=True, start_new_session=True,
                                        cwd='/', env={'PATH': '/usr/bin:/bin', 'LANG': 'C'},
                                        preexec_fn=lambda: h.drop_privileges(uid, gid, cpu_limit=120))
            except OSError:
                kill_group(producer)
                producer.wait()
                raise
            pump_thread = threading.Thread(target=pump_dump, args=(producer.stdout, scan.stdin), daemon=True)
            output_thread = threading.Thread(target=read_scan_output, args=(scan.stdout,), daemon=True)
            threads = [pump_thread, output_thread]
            for thread in threads:
                thread.start()
            while producer.poll() is None or scan.poll() is None:
                if time.monotonic() >= deadline:
                    timed_out = True
                    kill_group(producer)
                    kill_group(scan)
                    break
                time.sleep(0.05)
            producer_rc = producer.wait(timeout=5)
            scan_rc = scan.wait(timeout=5)
            for thread in threads:
                thread.join(timeout=5)
            if any(thread.is_alive() for thread in threads):
                timed_out = True
            if producer_rc != 0:
                error = 'CMS-Datenbankexport konnte nicht vollstaendig gelesen werden.'
            elif scan_rc not in (0, 1):
                error = 'ClamAV konnte den Datenbankexport nicht vollstaendig pruefen.'
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        error = str(exc)[:180]
        if producer is not None:
            kill_group(producer)
        if scan is not None:
            kill_group(scan)
        for process in (producer, scan):
            if process is not None:
                try:
                    process.wait(timeout=5)
                except (OSError, subprocess.SubprocessError):
                    pass

    if scan is not None and scan.returncode == 1 and not state['findings']:
        state['findings'].append({'signature': 'unparsed-clamav-match', 'rule': 'clamav-database-signature'})
    if timed_out or state['truncated'] or state['pipe_error'] or state['output_truncated'] or error:
        status = 'partial'
    elif scan.returncode == 1 and state['findings']:
        status = 'found'
    elif scan.returncode == 0:
        status = 'no_signatures'
    else:
        status = 'error'
    report = {'domain': domain, 'cms': cms, 'checked_at': h.utc_now(), 'status': status,
              'bytes_scanned': state['bytes'], 'finding_count': len(state['findings']),
              'findings': state['findings'], 'truncated': bool(timed_out or state['truncated'] or
              state['pipe_error'] or state['output_truncated']),
              'note': 'ClamAV-Signaturscan eines direkt gestreamten %s-SQL-Exports. Kein Datenbank-Dump wird auf Platte gespeichert. Kein MDS-/Cloud-Signaturnachweis; keine Datenbank wird geaendert.' % cms}
    if error:
        report['error'] = error
    wordpress_database_clamav_store(report)
    if state['findings']:
        h.incident_log('cms_database_indicators', 'warning', domain,
                       '%d ClamAV-Signaturtreffer im %s-Datenbankexport; manuelle Pruefung erforderlich.' %
                       (len(state['findings']), cms.capitalize()))
    return report


def wordpress_core_checksum_audit(domain):
    return wordpress_checksum_audit(domain, 'core')


def wordpress_plugin_checksum_audit(domain):
    return wordpress_checksum_audit(domain, 'plugins')


def wordpress_theme_fetch(url, max_bytes):
    """Fetch only HTTPS WordPress.org theme API/archive data with strict size limits."""
    def allowed_target(target):
        parts = urllib.parse.urlsplit(target)
        try:
            port = parts.port
        except ValueError:
            return False
        return (parts.scheme == 'https' and parts.hostname in
                ('api.wordpress.org', 'downloads.wordpress.org') and not parts.username and
                not parts.password and port in (None, 443))

    parts = urllib.parse.urlsplit(url)
    if not allowed_target(url) or parts.fragment:
        raise ValueError('Theme-Pruefung akzeptiert nur HTTPS von WordPress.org.')
    request = urllib.request.Request(url, headers={'User-Agent': 'Guardian-Lite/0.28.11 theme-integrity'})
    class AllowedRedirects(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if not allowed_target(newurl):
                raise urllib.error.HTTPError(newurl, code, 'Nicht erlaubtes Weiterleitungsziel', headers, fp)
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    opener = urllib.request.build_opener(AllowedRedirects())
    with opener.open(request, timeout=20) as response:
        data = response.read(max_bytes + 1)
    if len(data) > max_bytes:
        raise ValueError('WordPress.org Theme-Antwort ueberschreitet das sichere Groessenlimit.')
    return data


def wordpress_theme_archive(slug, version, max_archive=WP_THEME_MAX_ARCHIVE):
    query = urllib.parse.urlencode([('action', 'theme_information'), ('request[slug]', slug),
                                    ('request[fields][versions]', '1')])
    api_url = 'https://api.wordpress.org/themes/info/1.2/?' + query
    raw = wordpress_theme_fetch(api_url, 1024 * 1024)
    try:
        info = json.loads(raw.decode('utf-8'))
    except (UnicodeDecodeError, ValueError):
        raise ValueError('WordPress.org lieferte keine gueltige Theme-Metadatenantwort.')
    if not isinstance(info, dict) or info.get('slug') != slug:
        raise ValueError('Theme ist im WordPress.org-Verzeichnis nicht eindeutig verifizierbar.')
    versions = info.get('versions')
    download = versions.get(version) if isinstance(versions, dict) else None
    if not download and info.get('version') == version:
        download = info.get('download_link')
    if not isinstance(download, str):
        raise ValueError('Fuer diese Theme-Version gibt es kein WordPress.org-Archiv.')
    parts = urllib.parse.urlsplit(download)
    if (parts.scheme != 'https' or parts.hostname != 'downloads.wordpress.org'
            or parts.username or parts.password or parts.port not in (None, 443) or parts.fragment):
        raise ValueError('WordPress.org lieferte eine ungueltige Theme-Archivadresse.')
    if max_archive < 1:
        raise ValueError('Das Gesamtlimit fuer Theme-Archive wurde erreicht.')
    return wordpress_theme_fetch(download, min(WP_THEME_MAX_ARCHIVE, max_archive))


def wordpress_theme_local_files(theme_root, max_expanded=WP_THEME_MAX_EXPANDED):
    files = {}
    pending = [theme_root]
    total = 0
    entries_seen = 0
    while pending:
        directory = pending.pop()
        for entry in os.scandir(directory):
            entries_seen += 1
            if entries_seen > WP_THEME_MAX_FILES + 5000:
                raise ValueError('Theme ueberschreitet das Verzeichniseintragslimit.')
            info = entry.stat(follow_symlinks=False)
            if stat.S_ISLNK(info.st_mode):
                raise ValueError('Theme enthaelt Symlinks und wird nicht als Herstellerkopie bewertet.')
            if stat.S_ISDIR(info.st_mode):
                pending.append(pathlib.Path(entry.path))
                continue
            if not stat.S_ISREG(info.st_mode):
                raise ValueError('Theme enthaelt Sonderdateien und wird nicht bewertet.')
            relative = pathlib.Path(entry.path).relative_to(theme_root).as_posix()
            if len(relative) > WP_THEME_MAX_PATH or relative in files or len(files) >= WP_THEME_MAX_FILES:
                raise ValueError('Theme ueberschreitet das Dateilimit oder enthaelt doppelte Pfade.')
            total += info.st_size
            if total > min(WP_THEME_MAX_EXPANDED, max_expanded):
                raise ValueError('Theme ueberschreitet das entpackte Groessenlimit.')
            fd = os.open(entry.path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_CLOEXEC', 0))
            try:
                opened = os.fstat(fd)
                if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino) != (info.st_dev, info.st_ino):
                    raise ValueError('Theme-Datei wurde waehrend der Pruefung ausgetauscht.')
                digest_obj = hashlib.sha256()
                count = 0
                while True:
                    chunk = os.read(fd, 1024 * 1024)
                    if not chunk:
                        break
                    count += len(chunk)
                    if count > min(WP_THEME_MAX_EXPANDED, max_expanded):
                        raise ValueError('Theme-Datei ueberschreitet das sichere Groessenlimit.')
                    digest_obj.update(chunk)
                after = os.fstat(fd)
                if count != info.st_size or (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns) != \
                        (opened.st_dev, opened.st_ino, opened.st_size, opened.st_mtime_ns):
                    raise ValueError('Theme-Datei wurde waehrend der Pruefung veraendert.')
                files[relative] = digest_obj.hexdigest()
            finally:
                os.close(fd)
    return files, total


def wordpress_theme_zip_files(slug, archive, max_expanded=WP_THEME_MAX_EXPANDED):
    files = {}
    total = 0
    try:
        with zipfile.ZipFile(io.BytesIO(archive)) as package:
            entries = package.infolist()
            if len(entries) > WP_THEME_MAX_FILES + 100:
                raise ValueError('Theme-Archiv ueberschreitet das Eintragslimit.')
            for item in entries:
                name = item.filename
                if '\\' in name or '\x00' in name or name.startswith('/'):
                    raise ValueError('Theme-Archiv enthaelt einen unsicheren Dateipfad.')
                path = pathlib.PurePosixPath(name.rstrip('/'))
                if any(part in ('', '.', '..') for part in path.parts) or not path.parts or path.parts[0] != slug:
                    raise ValueError('Theme-Archiv enthaelt einen unerwarteten Dateipfad.')
                mode = item.external_attr >> 16
                if stat.S_ISLNK(mode):
                    raise ValueError('Theme-Archiv enthaelt einen Symlink.')
                if item.is_dir():
                    continue
                if len(path.parts) < 2:
                    raise ValueError('Theme-Archiv enthaelt Dateien ausserhalb des Theme-Verzeichnisses.')
                relative = '/'.join(path.parts[1:])
                if (len(relative) > WP_THEME_MAX_PATH or relative in files or
                        len(files) >= WP_THEME_MAX_FILES or item.flag_bits & 1):
                    raise ValueError('Theme-Archiv enthaelt Duplikate, Verschluesselung oder zu viele Dateien.')
                total += item.file_size
                if item.file_size < 0 or total > min(WP_THEME_MAX_EXPANDED, max_expanded):
                    raise ValueError('Theme-Archiv ueberschreitet das entpackte Groessenlimit.')
                digest_obj = hashlib.sha256()
                count = 0
                with package.open(item, 'r') as stream:
                    while True:
                        chunk = stream.read(1024 * 1024)
                        if not chunk:
                            break
                        count += len(chunk)
                        if count > item.file_size or count > min(WP_THEME_MAX_EXPANDED, max_expanded):
                            raise ValueError('Theme-Archiv enthaelt inkonsistente Dateigroessen.')
                        digest_obj.update(chunk)
                if count != item.file_size:
                    raise ValueError('Theme-Archiv enthaelt eine abgeschnittene Datei.')
                files[relative] = digest_obj.hexdigest()
    except (OSError, zipfile.BadZipFile, RuntimeError) as exc:
        raise ValueError('WordPress.org Theme-Archiv ist ungueltig: %s' % str(exc)[:120])
    if not files:
        raise ValueError('WordPress.org Theme-Archiv enthaelt keine Dateien.')
    return files, total


def wordpress_theme_store(report):
    path = root() / 'wordpress-theme-checksum.json'
    state = h.read_json(path, {'reports': {}})
    reports = state.get('reports', {}) if isinstance(state, dict) else {}
    if not isinstance(reports, dict):
        reports = {}
    reports[report['domain']] = report
    if len(reports) > 50:
        keep = sorted(reports, key=lambda key: reports[key].get('checked_at', ''), reverse=True)[:50]
        reports = {key: reports[key] for key in keep}
    h.write_json(path, {'reports': reports})


def wordpress_theme_checksum_audit(domain):
    """Compare installed public themes with exact-version HTTPS WordPress.org archives."""
    docroot, _, _ = wordpress_site_context(domain)
    themes_path = docroot / 'wp-content' / 'themes'
    cursor = docroot
    for component in ('wp-content', 'themes'):
        cursor = cursor / component
        info = cursor.lstat()
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            raise ValueError('WordPress Theme-Verzeichnis enthaelt Symlinks oder ist ungueltig.')
    per_theme = []
    archive_bytes = 0
    expanded_bytes = 0
    deadline = time.monotonic() + 180
    for entry in sorted(os.scandir(themes_path), key=lambda item: item.name.lower()):
        if time.monotonic() >= deadline:
            per_theme.append({'status': 'incomplete', 'finding_count': 0, 'findings': [],
                              'note': 'Zeitlimit fuer Theme-Pruefung erreicht.'})
            break
        if len(per_theme) >= WP_THEME_MAX_COUNT:
            per_theme.append({'status': 'incomplete', 'note': 'Maximale Theme-Anzahl erreicht.'})
            break
        info = entry.stat(follow_symlinks=False)
        if stat.S_ISLNK(info.st_mode):
            per_theme.append({'slug': entry.name[:100], 'status': 'incomplete', 'finding_count': 0,
                              'findings': [], 'note': 'Symlink im Theme-Verzeichnis wird nicht verfolgt.'})
            continue
        if not stat.S_ISDIR(info.st_mode):
            continue
        slug = entry.name
        item = {'slug': slug[:100], 'status': 'incomplete', 'finding_count': 0, 'findings': []}
        per_theme.append(item)
        try:
            if not WP_THEME_SLUG.fullmatch(slug):
                raise ValueError('Theme-Verzeichnisname ist kein sicherer WordPress.org-Slug.')
            theme_root = pathlib.Path(entry.path)
            style = theme_root / 'style.css'
            style_info = style.lstat()
            if stat.S_ISLNK(style_info.st_mode) or not stat.S_ISREG(style_info.st_mode) or style_info.st_size > 1024 * 1024:
                raise ValueError('style.css fehlt, ist ungueltig oder zu gross.')
            style_fd = os.open(style, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_CLOEXEC', 0))
            try:
                opened = os.fstat(style_fd)
                if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino) != \
                        (style_info.st_dev, style_info.st_ino):
                    raise ValueError('style.css wurde waehrend der Pruefung ausgetauscht.')
                raw_header = os.read(style_fd, 1024 * 1024 + 1)
                if len(raw_header) > 1024 * 1024:
                    raise ValueError('style.css ueberschreitet das sichere Groessenlimit.')
            finally:
                os.close(style_fd)
            header = raw_header.decode('utf-8', 'replace')
            match = WP_THEME_VERSION.search(header)
            if not match:
                raise ValueError('Theme-Version in style.css fehlt.')
            version = match.group(1)
            local, local_bytes = wordpress_theme_local_files(
                theme_root, WP_THEME_MAX_TOTAL_EXPANDED - expanded_bytes)
            expanded_bytes += local_bytes
            archive = wordpress_theme_archive(slug, version, WP_THEME_MAX_TOTAL_ARCHIVE - archive_bytes)
            archive_bytes += len(archive)
            vendor, vendor_bytes = wordpress_theme_zip_files(
                slug, archive, WP_THEME_MAX_TOTAL_EXPANDED - expanded_bytes)
            expanded_bytes += vendor_bytes
            names = sorted(set(local) | set(vendor))
            for name in names:
                if local.get(name) != vendor.get(name):
                    if len(item['findings']) < WP_THEME_MAX_FINDINGS:
                        item['findings'].append({'path': name,
                                                 'rule': 'wordpress-theme-file-mismatch' if name in local and name in vendor else
                                                 ('wordpress-theme-extra-file' if name in local else 'wordpress-theme-missing-file')})
                    item['finding_count'] += 1
            item['version'] = version
            item['status'] = 'mismatch' if item['finding_count'] else 'verified'
            item['note'] = 'Vergleich mit dem passenden WordPress.org-Archiv ueber HTTPS; keine signierte Herstellerpruefsumme.'
        except (OSError, ValueError, urllib.error.URLError, zipfile.BadZipFile) as exc:
            item['note'] = str(exc)[:180]
    if not per_theme:
        status = 'no_themes'
    elif any(item.get('status') == 'mismatch' for item in per_theme):
        status = 'mismatch'
    elif any(item.get('status') != 'verified' for item in per_theme):
        status = 'partial'
    else:
        status = 'verified'
    report = {'domain': domain, 'checked_at': h.utc_now(), 'status': status,
              'theme_count': len(per_theme), 'finding_count': sum(item.get('finding_count', 0) for item in per_theme),
              'themes': per_theme,
              'note': 'Nur Themes mit passender Version im WordPress.org-Verzeichnis sind verifizierbar. Eigene/kommerzielle Themes bleiben ungeprueft. Archive werden ueber HTTPS geladen; dies ist kein signierter Paketnachweis, keine Reparatur und kein Malware-Vollscan.'}
    wordpress_theme_store(report)
    if status == 'mismatch':
        h.incident_log('cms_checksum_mismatch', 'warning', domain,
                       '%d WordPress-Theme-Dateiabweichungen; manuelle Pruefung erforderlich.' % report['finding_count'])
    return report


def diagnostics(domain='', http_probe=False):
    result = {'generated_at': h.utc_now(), 'checks': [], 'domain': domain,
              'note': 'Keine API-Schluessel, Dateiinhalte oder vollstaendigen Serverkonfigurationen enthalten.'}
    def check(name, callback):
        try:
            value = callback()
            result['checks'].append({'name': name, 'ok': True, 'result': value})
        except (OSError, ValueError, subprocess.SubprocessError):
            result['checks'].append({'name': name, 'ok': False, 'result': 'Pruefung fehlgeschlagen oder Voraussetzung fehlt.'})
    check('Plesk', lambda: run([h.binary(h.PLESK_BINARIES) or '/usr/sbin/plesk', 'version']).splitlines()[0])
    check('ClamAV', lambda: run([h.binary(h.CLAM_PATHS) or '/usr/bin/clamscan', '--version']))
    check('Fail2Ban', lambda: h.fail2ban_status())
    check('WAF Log', lambda: {'available': h.waf_status()['available']})
    check('Dateiwache', lambda: h.monitor_status())
    if domain:
        check('Document-Root', lambda: {'uid': h.site_docroot(domain)[1], 'resolved': True})
    if http_probe is True and domain:
        docroot, uid, gid = h.site_docroot(domain)
        token = uuid.uuid4().hex
        name = 'guardian-probe-' + token + '.php'
        dfd = os.open(str(docroot), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=dfd)
            with os.fdopen(fd, 'wb') as output:
                os.fchown(output.fileno(), uid, gid)
                output.write(('<?php header("Cache-Control: no-store"); header("Content-Type: application/json"); '
                              'echo json_encode(["token"=>"%s","php"=>PHP_VERSION,"snuffleupagus"=>extension_loaded("snuffleupagus"),'
                              '"curl"=>extension_loaded("curl"),"prepend"=>(bool)ini_get("auto_prepend_file")]);' % token).encode('ascii'))
            def probe():
                response = api_json('https://' + domain + '/' + name, {'Accept': 'application/json'})
                if response.get('token') != token:
                    raise ValueError('HTTP-Test erreicht nicht die angelegte Testdatei.')
                return {k: response.get(k) for k in ('php', 'snuffleupagus', 'curl', 'prepend')}
            check('HTTPS PHP Request', probe)
        finally:
            os.unlink(name, dir_fd=dfd)
            os.close(dfd)
    h.write_json(root() / 'diagnostics.json', result)
    return result


def public_status():
    prepare()
    settings = config()
    ignore_hashes = settings.get('ignore_hashes', {})
    if not isinstance(ignore_hashes, dict):
        ignore_hashes = {}
    handlers = []
    for path in sorted(PHP_BASE.glob('8.*')):
        if not VERSION.fullmatch(path.name):
            continue
        try:
            base = handler(path.name)
            data, _ = checked(base / 'etc/php.ini')
            handlers.append({'version': path.name, 'sha256': digest(data),
                             'module': (base / 'lib/php/modules/snuffleupagus.so').is_file(),
                             'build_missing': [name for name in ('phpize', 'php-config') if not (base / 'bin' / name).is_file()] +
                                              [name for name in ('git', 'gcc', 'make', 'autoconf') if not shutil.which(name)],
                             'managed': BEGIN.encode() in data})
        except (OSError, ValueError):
            continue
    backups = []
    for path in (root() / 'backups').glob('*.json'):
        item = h.read_json(path, {})
        if item and re.fullmatch(r'[a-f0-9]{32}', str(item.get('id', ''))):
            try:
                blob = root() / 'backups' / (str(item.get('id', '')) + '.bin')
                blob_stat = blob.lstat()
                item['bytes'] = blob_stat.st_size if stat.S_ISREG(blob_stat.st_mode) else 0
            except OSError:
                item['bytes'] = 0
            backups.append(item)
    for blob in (root() / 'backups').glob('*.bin'):
        if not re.fullmatch(r'[a-f0-9]{32}', blob.stem) or (root() / 'backups' / (blob.stem + '.json')).exists():
            continue
        try:
            info = blob.lstat()
            if stat.S_ISREG(info.st_mode):
                backups.append({'id': blob.stem, 'kind': 'waf-engine', 'identity': 'Altes Diagnosebackup',
                                'created_at': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(info.st_mtime)),
                                'bytes': info.st_size, 'legacy': True})
        except OSError:
            continue
    backups.sort(key=lambda x: x.get('created_at', ''), reverse=True)
    try:
        path = waf_file()
        waf_sha = digest(checked(path)[0] if path.exists() else b'')
    except (ValueError, OSError):
        waf_sha = ''
    storage, baseline_items, _ = storage_snapshot()
    db_scan_state = h.read_json(root() / 'wordpress-dbscan.json', {'reports': {}})
    db_scan_reports = db_scan_state.get('reports', {}) if isinstance(db_scan_state, dict) else {}
    if not isinstance(db_scan_reports, dict):
        db_scan_reports = {}
    db_clamav_state = h.read_json(root() / 'wordpress-db-clamav.json', {'reports': {}})
    db_clamav_reports = db_clamav_state.get('reports', {}) if isinstance(db_clamav_state, dict) else {}
    if not isinstance(db_clamav_reports, dict):
        db_clamav_reports = {}
    theme_checksum_state = h.read_json(root() / 'wordpress-theme-checksum.json', {})
    theme_checksum_reports = (theme_checksum_state.get('reports', {})
                              if isinstance(theme_checksum_state, dict) else {})
    if not isinstance(theme_checksum_reports, dict):
        theme_checksum_reports = {}
    return {'ok': True, 'handlers': handlers, 'backups': backups, 'waf': settings.get('waf', {}),
            'waf_sha256': waf_sha, 'cloud': {'consent': bool(settings.get('cloud_consent')),
            'abuseipdb_configured': bool(settings.get('abuseipdb_key')),
            'turnstile_configured': bool(settings.get('turnstile_sitekey') and settings.get('turnstile_secret'))},
            'baselines': settings.get('baselines', {}), 'autorepair': settings.get('autorepair', {}),
            'ignore_hashes': {domain: sorted(value for value in values if isinstance(value, str) and HEX.fullmatch(value))
                              for domain, values in ignore_hashes.items()
                              if h.valid_domain(domain) and isinstance(values, list)},
            'global_ignore_hashes': sorted(value for value in settings.get('global_ignore_hashes', [])
                                           if isinstance(value, str) and HEX.fullmatch(value))
                                    if isinstance(settings.get('global_ignore_hashes', []), list) else [],
            'bots': {d: {'enabled': v.get('enabled', False)} for d, v in settings.get('bots', {}).items()},
            'storage': storage, 'baseline_inventory': baseline_items,
            'diagnostics': h.read_json(root() / 'diagnostics.json', {}),
            'cron_audit': h.read_json(root() / 'cron-audit.json', {}),
            'wordpress_checksum': h.read_json(root() / 'wordpress-checksum.json', {}),
            'wordpress_plugin_checksum': h.read_json(root() / 'wordpress-plugin-checksum.json', {}),
            'wordpress_theme_checksum': theme_checksum_reports,
            'wordpress_db_scans': db_scan_reports,
            'wordpress_db_clamav_scans': db_clamav_reports,
            'cms_db_clamav_scans': db_clamav_reports,
            'jobs': [h.read_json(p, {}) for p in sorted((root() / 'jobs').glob('*.json'),
                     key=lambda x: x.stat().st_mtime, reverse=True)[:10]],
            'reputation': list(h.read_json(root() / 'reputation.json', {}).values())[-20:]}


def uninstall_cleanup():
    # Removing an extension must undo its own active policies, not leave orphaned guards.
    settings = config()
    firewall = h.firewall_rules()
    if h.FIREWALL_SETTINGS.is_file() and not firewall.get('available'):
        raise ValueError('Plesk Firewall ist installiert, aber Guardian kann ihre Regeln nicht sicher auflisten. Deinstallation abgebrochen, damit keine Guardian-Regel als verwaiste Sperre bestehen bleibt.')
    if firewall.get('available'):
        if firewall.get('limited'):
            raise ValueError('Zu viele Guardian-Firewallregeln fuer einen sicheren Deinstallations-Rollback.')
        if firewall.get('pending', {}).get('state') == 'awaiting_confirmation':
            h.firewall_action('cancel')
            firewall = h.firewall_rules()
        if firewall.get('rules'):
            if not h.firewall_status().get('plesk_firewall_active'):
                raise ValueError('Guardian-Firewallregeln sind gespeichert, Plesk-Firewall aber inaktiv. Firewall zuerst in Plesk aktivieren und Guardian-Regeln vor der Deinstallation entfernen.')
            if any(rule.get('kind') == 'port' and rule.get('action') == 'allow'
                   for rule in firewall['rules']):
                raise ValueError('Guardian-Portfreigaben muessen vor der Deinstallation im Panel einzeln entfernt und getestet werden; automatisches Bestaetigen koennte Adminzugriff sperren.')
            for network in sorted({rule['network'] for rule in firewall['rules'] if rule.get('kind') != 'port'}):
                h.firewall_action('unban', network)
                h.firewall_action('confirm')
            for rule in sorted((item for item in firewall['rules'] if item.get('kind') == 'port'),
                               key=lambda item: item.get('id', '')):
                h.firewall_action('port-remove', rule['id'])
                h.firewall_action('confirm')
    for domain, item in settings.get('bots', {}).items():
        if item.get('enabled'):
            bots_set(domain, 'off')
    for item in public_status()['handlers']:
        if item['managed']:
            runtime_set(item['version'], 'off', item['sha256'])
    try:
        path = waf_file()
    except ValueError:
        path = None
    if path is not None and path.exists():
        data, _ = checked(path)
        if data.startswith(b'# Guardian managed\n'):
            if digest(data) != settings.get('waf', {}).get('sha256'):
                raise ValueError('Guardian-WAF-Datei wurde extern geaendert; vor Deinstallation manuell pruefen.')
            ctl = h.binary(('/usr/sbin/apache2ctl', '/usr/sbin/apachectl'))
            systemctl = h.binary(h.SYSTEMCTL_PATHS)
            if not ctl or not systemctl:
                raise ValueError('Guardian-WAF-Regeln vor der Deinstallation manuell deaktivieren.')
            atomic(path, b'# Guardian managed\n', 0o644)
            try:
                run([ctl, '-t'])
                run([systemctl, 'reload', 'apache2' if 'apache2' in str(ctl) else 'httpd'])
            except Exception:
                atomic(path, data, 0o644)
                raise
    for domain in list(h.monitor_config()):
        h.monitor_set(domain, 'off')
    for domain, mode in config().get('waf_engines', {}).items():
        if h.valid_domain(domain) and mode in ('on', 'off', 'detection-only'):
            plesk(['subscription', '--update-web-app-firewall', domain, '-waf-rule-engine', mode])
    settings = config()
    settings['autorepair'] = {}
    settings['waf_engines'] = {}
    save_config(settings)
    return {'message': 'Guardian-eigene aktive Policies deaktiviert und Guardian-Plesk-Firewallregeln entfernt. Backups, Module und Quarantaene bleiben erhalten.'}


def start_job(request):
    for path in (root() / 'jobs').glob('*.json'):
        item = h.read_json(path, {})
        if item.get('status') in ('queued', 'running') and time.time() - item.get('epoch', 0) < 1200:
            raise ValueError('Ein Verwaltungsauftrag laeuft bereits.')
    token = uuid.uuid4().hex
    path = root() / 'jobs' / (token + '.json')
    item = {'id': token, 'action': request['action'], 'domain': request.get('domain', ''),
            'version': request.get('version', ''), 'status': 'queued', 'epoch': time.time()}
    # Long-running actions have no API secrets and store only their validated fields.
    h.write_json(path, item)
    child = subprocess.Popen([sys.executable, str(HERE / 'guardian-manager'), 'job', token],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             close_fds=True, start_new_session=True, cwd='/')
    return {'job': token, 'pid': child.pid, 'message': 'Auftrag gestartet. Status nach Neuladen unter Verwaltung sichtbar.'}


def run_job(token):
    if not re.fullmatch(r'[a-f0-9]{32}', token):
        raise ValueError('Ungueltige Job-ID.')
    with locked(blocking=True):
        path = root() / 'jobs' / (token + '.json')
        item = h.read_json(path, {})
        if item.get('status') != 'queued':
            raise ValueError('Kein wartender Auftrag.')
        item['status'] = 'running'
        h.write_json(path, item)
        try:
            if item['action'] == 'runtime-install':
                result = runtime_install(item['version'])
            elif item['action'] == 'baseline-create':
                scanlock = h.lock_scan()
                try:
                    result = baseline(item['domain'], True)
                finally:
                    os.close(scanlock)
            else:
                raise ValueError('Unbekannter Hintergrundauftrag.')
            item.update(status='finished', result=result)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            message = str(exc)[:240] if isinstance(exc, ValueError) else 'Systemaktion fehlgeschlagen; Build-Voraussetzungen pruefen.'
            item.update(status='error', error=message)
        item['finished_at'] = h.utc_now()
        h.write_json(path, item)


def dispatch(request):
    if not isinstance(request, dict):
        raise ValueError('JSON-Objekt erforderlich.')
    action = request.get('action')
    with locked():
        if action == 'php-backup':
            return php_backup(request.get('version', ''))
        if action == 'php-restore':
            return php_restore(request.get('version', ''), request.get('backup', ''), request.get('sha256', ''))
        if action == 'runtime-set':
            return runtime_set(request.get('version', ''), request.get('mode', ''), request.get('sha256', ''))
        if action == 'runtime-install':
            version = request.get('version', '')
            handler(version)
            return start_job({'action': action, 'version': version})
        if action == 'waf-preview':
            return {'rules': waf_rules(request.get('domain', ''), request.get('mode', ''), request.get('limit', 120))}
        if action == 'waf-set':
            return waf_set(request.get('domain', ''), request.get('mode', ''), request.get('limit', 120), request.get('sha256', ''))
        if action == 'waf-engine':
            return waf_engine(request.get('domain', ''), request.get('mode', ''))
        if action == 'waf-restore':
            return waf_restore(request.get('backup', ''), request.get('sha256', ''))
        if action == 'cloud-save':
            return cloud_save(request)
        if action in ('ignore-add', 'ignore-remove'):
            return ignore_hash_set(request.get('domain', ''), request.get('sha256', ''),
                                   'add' if action == 'ignore-add' else 'remove')
        if action in ('global-ignore-add', 'global-ignore-remove'):
            return global_ignore_hash_set(request.get('sha256', ''),
                                          'add' if action == 'global-ignore-add' else 'remove')
        if action == 'reputation':
            return reputation(request.get('ip', ''))
        if action == 'baseline-create':
            domain = request.get('domain', '')
            h.site_docroot(domain)
            if request.get('trusted') is not True:
                raise ValueError('Saubere Herkunft der Baseline ausdruecklich bestaetigen.')
            return start_job({'action': action, 'domain': domain})
        if action == 'baseline-delete':
            return baseline_delete(request.get('baseline_id', ''), request.get('domain', ''))
        if action == 'backup-delete':
            return backup_delete(request.get('backup', ''))
        if action == 'repair-set':
            return repair_set(request.get('domain', ''), request.get('mode', ''))
        if action == 'repair':
            return repair_one(request.get('jobid', ''), int(request.get('index', -1)))
        if action == 'repair-rollback':
            return repair_rollback(request.get('jobid', ''), int(request.get('index', -1)))
        if action == 'bots-set':
            return bots_set(request.get('domain', ''), request.get('mode', ''))
        if action == 'diagnostics':
            return diagnostics(request.get('domain', ''), request.get('http_probe') is True)
        if action == 'cron-audit':
            return cron_audit()
        if action == 'wp-checksum-audit':
            return wordpress_core_checksum_audit(request.get('domain', ''))
        if action == 'wp-plugin-checksum-audit':
            return wordpress_plugin_checksum_audit(request.get('domain', ''))
        if action == 'wp-theme-checksum-audit':
            return wordpress_theme_checksum_audit(request.get('domain', ''))
        if action == 'wp-db-scan':
            return wordpress_database_audit(request.get('domain', ''))
        if action == 'wp-db-clamav-scan':
            return wordpress_database_clamav_audit(request.get('domain', ''))
        if action == 'cms-db-clamav-scan':
            cms = find_cms_database(request.get('domain', ''))
            return cms_database_clamav_audit(request.get('domain', ''), cms)
        raise ValueError('Unbekannte Verwaltungsaktion.')


def main(args):
    try:
        if args == ['status']:
            return h.respond(public_status())
        if args == ['uninstall']:
            with locked():
                return h.respond({'ok': True, 'result': uninstall_cleanup()})
        if len(args) == 2 and args[0] == 'job':
            run_job(args[1])
            return h.respond({'ok': True})
        if len(args) == 2 and args[0] == 'auto-repair' and h.JOB_ID.fullmatch(args[1]):
            with locked(blocking=True):
                auto_repair(args[1])
            return h.respond({'ok': True})
        if args == ['request']:
            raw = sys.stdin.buffer.read(16385)
            if len(raw) > 16384:
                raise ValueError('Anfrage zu gross.')
            result = dispatch(json.loads(raw))
            return h.respond({'ok': True, 'result': result})
        raise ValueError('Unbekannter Aufruf.')
    except ValueError as exc:
        return h.respond({'ok': False, 'error': str(exc)[:240]}, 1)
    except (OSError, TypeError, KeyError, IndexError, subprocess.SubprocessError):
        # No raw HTTP exceptions: they may contain secrets or provider responses.
        return h.respond({'ok': False, 'error': 'Verwaltungsaktion fehlgeschlagen. Voraussetzungen und aktuelle Fingerprints pruefen.'}, 1)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
