ROOT = pathlib.Path('/var/lib/guardian-lite')
VHOSTS = pathlib.Path('/var/www/vhosts')
PLESK_BINARIES = ('/usr/sbin/plesk', '/usr/bin/plesk')
MODSEC_LOG = pathlib.Path('/var/log/modsec_audit.log')
CLAM_PATHS = ('/usr/bin/clamscan', '/usr/local/bin/clamscan', '/bin/clamscan')
FAIL2BAN_PATHS = ('/usr/bin/fail2ban-client', '/usr/local/bin/fail2ban-client', '/bin/fail2ban-client')
CROWDSEC_PATHS = ('/usr/bin/cscli', '/usr/local/bin/cscli', '/usr/sbin/cscli')
CROWDSEC_APPSEC_CONFIG = pathlib.Path('/etc/crowdsec/acquis.d/appsec.yaml')
CROWDSEC_BOUNCER_CONFIG = pathlib.Path('/etc/crowdsec/bouncers/crowdsec-apache2-bouncer.conf')
SYSTEMCTL_PATHS = ('/usr/bin/systemctl', '/bin/systemctl')
FIREWALL_SETTINGS = pathlib.Path('/usr/local/psa/bin/modules/firewall/settings')
FIREWALL_UNITS = ('plesk-firewall', 'psa-firewall')
FIREWALL_PENDING = ROOT / 'firewall-pending.json'
FIREWALL_EXPIRIES = ROOT / 'firewall-expiries.json'
FIREWALL_ALLOWLIST = ROOT / 'firewall-allowlist.json'
FIREWALL_DEBUG_CONFIG = ROOT / 'firewall-debug.json'
FIREWALL_DEBUG_LOG = ROOT / 'firewall-debug.jsonl'
FIREWALL_DEBUG_LOCK = ROOT / 'firewall-debug.lock'
MAX_FIREWALL_DEBUG_BYTES = 256 * 1024
MAX_FIREWALL_DEBUG_EVENTS = 100
FIREWALL_RULE_PREFIX = 'Guardian Lite managed deny '
FIREWALL_PORT_RULE_PREFIX = 'Guardian Lite managed port '
FIREWALL_TTLS = (0, 3600, 86400, 604800)
MAX_FIREWALL_EXPIRATIONS_PER_TICK = 10
MAX_FIREWALL_ALLOWLIST = 200
DOMAIN_LABEL = re.compile(r'^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$', re.I)
JAIL_NAME = re.compile(r'^[a-zA-Z0-9_.-]{1,80}$')
JOB_ID = re.compile(r'^[a-f0-9]{32}$')
MAX_JAILS = 24
MAX_FAIL2BAN_IPS_PER_JAIL = 100
MAX_FAIL2BAN_IPS_TOTAL = 300
GEOIP_DATABASE = ROOT / 'management' / 'dbip-country-lite.mmdb'
GEOIP_LICENSE = ROOT / 'management' / 'dbip-country-lite.license'
MAX_GEOIP_ADDRESSES = 500
MAX_CROWDSEC_DECISIONS = 50
MAX_HISTORY = 30
MAX_FINDINGS = 50
MAX_SCAN_QUEUE = 100
MAX_ADMIN_TOOL_FILES = 5000
MAX_ADMIN_TOOL_ENTRIES = 10000
MAX_ADMIN_TOOL_RESULTS = 25
MAX_ADMIN_TOOL_FILE_BYTES = 2 * 1024 * 1024
MAX_ADMIN_TOOL_SCAN_SECONDS = 10
MAX_SCAN_CACHE_FILES = 10000
MAX_SCAN_CACHE_PATH_BYTES = 240
MAX_SCAN_CACHE_FILE_BYTES = 4 * 1024 * 1024
MAX_SCAN_CACHE_DOMAINS = 16
MAX_SCAN_FILE_BYTES = 25 * 1024 * 1024
MAX_SCAN_WALK_ENTRIES = 50000
MAX_SCAN_WALK_SECONDS = 45
LOG_LIMIT = 128 * 1024
MAX_SNAPSHOT_FILE = 25 * 1024 * 1024
INCIDENT_LOG = ROOT / 'incidents.jsonl'
