MAX_MONITOR_DOMAINS = 5
MAX_WATCH_DIRS = 450
WATCH_SUFFIXES = ('.php', '.phtml', '.phar', '.inc', '.htaccess', '.user.ini')
EMAIL_RE = re.compile(r'^[A-Za-z0-9._%+\-]{1,64}@[A-Za-z0-9.\-]{1,190}\.[A-Za-z]{2,24}$')



def respond(data, code=0):
    print(json.dumps(data, ensure_ascii=False, separators=(',', ':')))
    return code


def error(message):
    return respond({'ok': False, 'error': str(message)[:350]}, 1)


def binary(paths):
    return next((p for p in paths if os.path.isfile(p) and os.access(p, os.X_OK)), None)


def execute(command, timeout=5):
    started = time.monotonic()
    try:
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                check=False, text=True, errors='replace', timeout=timeout,
                                env={'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C'})
        if (len(command) >= 4 and str(command[1]) == 'ext' and str(command[2]) == 'firewall'):
            firewall_debug_log('plesk-cli', stage=str(command[3]), returncode=result.returncode,
                               duration_ms=int((time.monotonic() - started) * 1000),
                               output_bytes=len(result.stdout.encode('utf-8', 'replace')))
        return result
    except (OSError, subprocess.TimeoutExpired) as exc:
        if (len(command) >= 4 and str(command[1]) == 'ext' and str(command[2]) == 'firewall'):
            firewall_debug_log('plesk-cli-error', stage=str(command[3]),
                               duration_ms=int((time.monotonic() - started) * 1000), detail=str(exc)[:180])
        return None


def valid_domain(domain):
    return (isinstance(domain, str) and 3 <= len(domain) <= 253 and
            len(domain.split('.')) >= 2 and
            all(DOMAIN_LABEL.fullmatch(s) for s in domain.split('.')))


def plesk_hosting_path(domain):
    """Read the authoritative document root and webspace home from Plesk.

    Plesk domains may share a subscription and may not have an httpdocs folder
    beneath their own hostname. We query the hosting record using a fixed SQL
    statement instead of guessing a filesystem path. Input is validated before
    it reaches the command, and nothing is passed through a shell.
    """
    if not valid_domain(domain):
        raise ValueError('Ungueltiger Domainname.')
    plesk = binary(PLESK_BINARIES)
    if not plesk:
        raise ValueError('Plesk-Kommando nicht gefunden; Hostingpfad nicht bestimmbar.')
    sql = ("SELECT h.www_root, u.home FROM domains d "
           "JOIN hosting h ON h.dom_id = d.id "
           "JOIN sys_users u ON u.id = h.sys_user_id "
           "WHERE d.name = '" + domain + "' LIMIT 1")
    result = execute([plesk, 'db', '-Ne', sql], timeout=12)
    if result is None or result.returncode:
        raise ValueError('Plesk-Hostinginformationen nicht lesbar (plesk db).')
    rows = result.stdout.strip().splitlines()
    if len(rows) != 1:
        raise ValueError('Domain hat kein eindeutiges aktives Website-Hosting in Plesk.')
    columns = rows[0].split('\t')
    if len(columns) != 2 or any(not p or p == 'NULL' or len(p) > 2048 for p in columns):
        raise ValueError('Ungueltige Document-Root-Angabe in Plesk.')
    return tuple(columns)


def site_docroot(domain):
    """Resolve only the configured document root inside its own webspace.

    Resolving symlinks is intentional: their final target must remain strictly
    inside the domain's Plesk subscription, not merely inside all vhosts.
    Root-owned targets are never scanned with root privileges.
    """
    configured_root, configured_home = plesk_hosting_path(domain)
    if not pathlib.PurePosixPath(configured_root).is_absolute() or not pathlib.PurePosixPath(configured_home).is_absolute():
        raise ValueError('Plesk-Hostingpfade muessen absolut sein.')
    try:
        base = VHOSTS.resolve(strict=True)
        home = pathlib.Path(configured_home).resolve(strict=True)
        target = pathlib.Path(configured_root).resolve(strict=True)
    except (OSError, RuntimeError):
        raise ValueError('Plesk-Document-Root existiert nicht.')
    if (home == base or target == home or
            os.path.commonpath((str(base), str(home))) != str(base) or
            os.path.commonpath((str(home), str(target))) != str(home) or
            not home.is_dir() or not target.is_dir()):
        raise ValueError('Document-Root ausserhalb des Plesk-Webspaces abgelehnt.')
    st = target.stat()
    if st.st_uid == 0:
        raise ValueError('Document-Root ist root-eigen; Scan als root wird abgelehnt.')
    return target, st.st_uid, st.st_gid


def clam_database_age():
    try:
        candidates = [p.stat().st_mtime for p in pathlib.Path('/var/lib/clamav').iterdir()
                      if p.is_file() and p.suffix.lower() in ('.cvd', '.cld')]
        return max(0, int((time.time()-max(candidates))//86400)) if candidates else None
    except (OSError, ValueError):
        return None


def fail2ban_status():
    cli = binary(FAIL2BAN_PATHS)
    result = {'installed': bool(cli), 'running': False, 'jail_count': 0,
              'banned_total': 0, 'jails': [], 'jails_limited': False}
    if cli is None:
        return result
    run = execute([cli, 'status'])
    if run is None or run.returncode:
        return result
    result['running'] = True
    match = re.search(r'Jail list:\s*(.*)', run.stdout)
    names = [s.strip() for s in match.group(1).split(',')] if match else []
    names = [name for name in names if JAIL_NAME.fullmatch(name)]
    result['jail_count'] = len(names)
    result['jails_limited'] = len(names) > MAX_JAILS
    listed_total = 0
    for name in names[:MAX_JAILS]:
        details = execute([cli, 'status', name], timeout=3)
        output = details.stdout if details and not details.returncode else ''
        match = re.search(r'Currently banned:\s*(\d+)', output)
        count = int(match.group(1)) if match else 0
        ip_match = re.search(r'Banned IP list:\s*([^\r\n]*)', output, re.I)
        addresses = []
        if ip_match:
            for token in re.split(r'[,\s]+', ip_match.group(1).strip()):
                if not token:
                    continue
                try:
                    address = str(ipaddress.ip_address(token))
                except ValueError:
                    continue
                if address not in addresses:
                    addresses.append(address)
        remaining = max(0, MAX_FAIL2BAN_IPS_TOTAL - listed_total)
        limit = min(MAX_FAIL2BAN_IPS_PER_JAIL, remaining)
        visible_addresses = addresses[:limit]
        listed_total += len(visible_addresses)
        result['jails'].append({'name': name, 'banned': count,
                                'banned_ips': visible_addresses,
                                'banned_ips_available': ip_match is not None,
                                'banned_ips_truncated': len(addresses) > len(visible_addresses)})
        result['banned_total'] += count
    return result


def crowdsec_status():
    """Read bounded local CrowdSec decisions; Guardian never installs or enforces CrowdSec."""
    cli = binary(CROWDSEC_PATHS)
    result = {'installed': bool(cli), 'available': False, 'decision_count': 0,
              'decisions': [], 'decisions_limited': False,
              'appsec': crowdsec_appsec_status()}
    if cli is None:
        return result
    run = execute([cli, 'decisions', 'list', '--output', 'json', '--limit',
                   str(MAX_CROWDSEC_DECISIONS), '--color', 'no'], timeout=5)
    if run is None or run.returncode or len(run.stdout) > 256 * 1024:
        return result
    try:
        decoded = json.loads(run.stdout)
    except (ValueError, TypeError):
        return result
    if isinstance(decoded, dict):
        decoded = decoded.get('decisions', decoded.get('items', []))
    if not isinstance(decoded, list):
        return result
    result['available'] = True
    result['decision_count'] = len(decoded)
    result['decisions_limited'] = len(decoded) >= MAX_CROWDSEC_DECISIONS
    for item in decoded[:MAX_CROWDSEC_DECISIONS]:
        if not isinstance(item, dict):
            continue
        value = item.get('value', item.get('Value', ''))
        scope = item.get('scope', item.get('Scope', 'ip'))
        try:
            if not isinstance(value, str) or len(value) > 80:
                continue
            if str(scope).lower() in ('ip', 'ipv4', 'ipv6'):
                address = str(ipaddress.ip_address(value))
                network = address
            elif str(scope).lower() in ('range', 'cidr'):
                network = str(ipaddress.ip_network(value, strict=False))
                address = ''
            else:
                continue
        except ValueError:
            continue
        decision_type = item.get('type', item.get('Type', 'ban'))
        if not isinstance(decision_type, str):
            decision_type = 'ban'
        decision_type = decision_type[:32]
        scenario = item.get('scenario', item.get('Scenario', item.get('reason', '')))
        origin = item.get('origin', item.get('Origin', ''))
        duration = item.get('duration', item.get('Duration', ''))
        result['decisions'].append({
            'network': network, 'ip': address,
            'scope': str(scope)[:16], 'type': decision_type,
            'scenario': scenario[:120] if isinstance(scenario, str) else '',
            'origin': origin[:40] if isinstance(origin, str) else '',
            'duration': duration[:40] if isinstance(duration, str) else ''})
    return result


def crowdsec_appsec_status():
    """Inspect optional CrowdSec AppSec wiring without returning credentials or changing state."""
    state = {'engine_running': False, 'acquisition_configured': False,
             'loopback_listener': False, 'apache_module_loaded': False,
             'bouncer_config_included': False, 'forwarding_enabled': False}
    systemctl = binary(SYSTEMCTL_PATHS)
    if systemctl:
        run = execute([systemctl, 'is-active', 'crowdsec'], timeout=3)
        state['engine_running'] = bool(run and run.returncode == 0 and run.stdout.strip() == 'active')
    try:
        if (CROWDSEC_APPSEC_CONFIG.is_file() and not CROWDSEC_APPSEC_CONFIG.is_symlink()
                and CROWDSEC_APPSEC_CONFIG.stat().st_size <= 65536):
            text = CROWDSEC_APPSEC_CONFIG.read_text(encoding='utf-8', errors='replace')
            state['acquisition_configured'] = bool(re.search(r'^\s*source\s*:\s*appsec\s*(?:#.*)?$', text, re.M))
            state['loopback_listener'] = bool(re.search(
                r'^\s*listen_addr\s*:\s*["\']?(?:127\.0\.0\.1|\[::1\]):7422["\']?\s*(?:#.*)?$', text, re.M))
    except OSError:
        pass
    apachectl = binary(('/usr/sbin/apache2ctl', '/usr/sbin/apachectl', '/usr/bin/apachectl'))
    if apachectl:
        modules = execute([apachectl, '-M'], timeout=4)
        state['apache_module_loaded'] = bool(
            modules and modules.returncode == 0 and re.search(r'^\s*crowdsec_module\s', modules.stdout, re.M))
        includes = execute([apachectl, '-t', '-D', 'DUMP_INCLUDES'], timeout=4)
        state['bouncer_config_included'] = bool(
            includes and includes.returncode == 0 and
            str(CROWDSEC_BOUNCER_CONFIG) in includes.stdout)
    try:
        if (CROWDSEC_BOUNCER_CONFIG.is_file() and not CROWDSEC_BOUNCER_CONFIG.is_symlink()
                and CROWDSEC_BOUNCER_CONFIG.stat().st_size <= 65536):
            text = CROWDSEC_BOUNCER_CONFIG.read_text(encoding='utf-8', errors='replace')
            active = '\n'.join(line for line in text.splitlines()
                               if line.strip() and not line.lstrip().startswith(('#', ';')))
            appsec_on = re.search(r'^\s*CrowdsecAppsec\s+On\s*$', active, re.I | re.M)
            appsec_url = re.search(r'^\s*CrowdsecAppsecURL\s+http://127\.0\.0\.1:7422\s*$', active, re.I | re.M)
            state['forwarding_enabled'] = bool(appsec_on and appsec_url and
                                               state['apache_module_loaded'] and
                                               state['bouncer_config_included'])
    except OSError:
        pass
    return state


def firewall_status():
    ctl = binary(SYSTEMCTL_PATHS)
    active_unit = None
    known = False
    if ctl:
        for unit in FIREWALL_UNITS:
            check = execute([ctl, 'is-active', unit], 3)
            if check and check.returncode == 0 and check.stdout.strip() == 'active':
                active_unit = unit
                known = True
                break
            if check and check.returncode in (3,):
                known = True
    active = active_unit is not None
    installed = FIREWALL_SETTINGS.is_file()
    return {'installed': installed, 'status_known': known,
            'plesk_firewall_active': active, 'service': active_unit}


def firewall_rules():
    """Read Plesk rules for the dashboard, while only managing Guardian-owned rules."""
    pending = read_json(FIREWALL_PENDING, {})
    if pending.get('state') == 'awaiting_confirmation':
        elapsed = max(0, time.time() - float(pending.get('started_epoch', 0)))
        pending['remaining_seconds'] = max(0, int(55 - elapsed))
        if elapsed > 55:
            pending['state'] = 'expired'
    try:
        allowlist = firewall_allowlist_entries()
    except ValueError as exc:
        return {'available': False, 'rules': [], 'inventory': [], 'counts': {}, 'allowlist': [],
                'allowlist_error': str(exc)[:180], 'pending': pending}
    plesk = binary(PLESK_BINARIES)
    if not plesk:
        return {'available': False, 'rules': [], 'inventory': [], 'counts': {}, 'allowlist': allowlist, 'pending': pending}
    result = execute([plesk, 'ext', 'firewall', '--list-json'], timeout=10)
    if result is None or result.returncode:
        return {'available': False, 'rules': [], 'inventory': [], 'counts': {}, 'allowlist': allowlist, 'pending': pending}
    try:
        decoded = json.loads(result.stdout)
    except (ValueError, TypeError):
        return {'available': False, 'rules': [], 'inventory': [], 'counts': {}, 'allowlist': allowlist, 'pending': pending}
    if not isinstance(decoded, list) or len(decoded) > 2000:
        return {'available': False, 'rules': [], 'inventory': [], 'counts': {}, 'allowlist': allowlist, 'pending': pending}
    expiry_data = read_json(FIREWALL_EXPIRIES, {})
    rules = []
    inventory = []
    counts = {'all': 0, 'allow': 0, 'deny': 0, 'input_allow': 0, 'input_deny': 0,
              'port_allow': 0, 'port_deny': 0}
    for item in decoded:
        if not isinstance(item, dict):
            continue
        name = item.get('name')
        rule_id = item.get('id')
        action = item.get('action')
        direction = item.get('direction')
        if (isinstance(rule_id, (str, int)) and str(rule_id).isdigit() and
                isinstance(name, str) and action in ('allow', 'deny') and
                isinstance(direction, str)):
            addresses = item.get('from', item.get('remote-addresses', ''))
            if isinstance(addresses, list):
                addresses = ', '.join(str(x) for x in addresses if isinstance(x, str))
            if not isinstance(addresses, str):
                addresses = ''
            ports_value = item.get('ports', '')
            ports = str(ports_value)[:100] if isinstance(ports_value, (str, int)) else ''
            row = {'id': str(rule_id)[:12], 'name': name[:120], 'class': str(item.get('class', ''))[:40],
                   'direction': direction[:20], 'action': action, 'source': addresses[:200], 'ports': ports}
            counts['all'] += 1
            counts[action] += 1
            if direction == 'input':
                counts['input_' + action] += 1
                if ports:
                    counts['port_' + action] += 1
            if len(inventory) < 300:
                inventory.append(row)
        if (not isinstance(name, str) or not isinstance(rule_id, (str, int)) or
                not str(rule_id).isdigit() or item.get('class') != 'custom' or
                item.get('direction') != 'input'):
            continue
        addresses = item.get('from', item.get('remote-addresses', ''))
        if isinstance(addresses, list):
            addresses = ','.join(str(x) for x in addresses if isinstance(x, str))
        if not isinstance(addresses, str):
            continue
        normalized_sources = []
        for source in addresses.split(','):
            try:
                normalized_sources.append(str(ipaddress.ip_network(source.strip(), strict=False)))
            except ValueError:
                continue
        if name.startswith(FIREWALL_RULE_PREFIX) and item.get('action') == 'deny':
            network = name[len(FIREWALL_RULE_PREFIX):]
            try:
                network = str(ipaddress.ip_network(network, strict=True))
            except ValueError:
                continue
            if network not in normalized_sources or str(item.get('ports', '')).strip():
                continue
            rule = {'id': str(rule_id), 'name': name, 'kind': 'ip_deny',
                    'action': 'deny', 'network': network, 'ports': ''}
            expires_epoch = expiry_data.get(network)
            if (isinstance(expires_epoch, int) and not isinstance(expires_epoch, bool) and expires_epoch > 0 and
                    expires_epoch <= int(time.time()) + max(FIREWALL_TTLS) + 60):
                rule['expires_at'] = datetime.datetime.fromtimestamp(
                    expires_epoch, datetime.timezone.utc).isoformat()
                rule['expires_epoch'] = int(expires_epoch)
        elif name.startswith(FIREWALL_PORT_RULE_PREFIX):
            match = re.fullmatch(r'(allow|deny) (tcp|udp) ([1-9][0-9]{0,4}) ([^ ]{1,80})',
                                 name[len(FIREWALL_PORT_RULE_PREFIX):])
            if not match or item.get('action') != match.group(1):
                continue
            port = int(match.group(3))
            if port > 65535 or str(item.get('ports', '')).replace(' ', '') != '%d/%s' % (port, match.group(2)):
                continue
            try:
                network = str(ipaddress.ip_network(match.group(4), strict=True))
            except ValueError:
                continue
            if network not in normalized_sources:
                continue
            rule = {'id': str(rule_id), 'name': name, 'kind': 'port',
                    'action': match.group(1), 'network': network,
                    'protocol': match.group(2), 'port': port,
                    'ports': '%d/%s' % (port, match.group(2))}
        else:
            continue
        rules.append(rule)
    rules.sort(key=lambda row: (row['network'], row['id']))
    return {'available': True, 'limited': len(rules) > 100, 'rules': rules[:100],
            'inventory': inventory, 'inventory_limited': counts['all'] > len(inventory),
            'counts': counts,
            'allowlist': allowlist,
            'pending': pending}


def firewall_allowlist_entries():
    try:
        st = FIREWALL_ALLOWLIST.lstat()
    except FileNotFoundError:
        return []
    except OSError as exc:
        raise ValueError('Guardian-IP-Ausnahmeliste kann nicht sicher gelesen werden.') from exc
    if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or (st.st_mode & 0o077)):
        raise ValueError('Guardian-IP-Ausnahmeliste hat unsichere Dateirechte oder ist keine regulaere Datei.')
    data = read_json(FIREWALL_ALLOWLIST, None)
    if not isinstance(data, dict) or set(data) != {'entries'}:
        raise ValueError('Guardian-IP-Ausnahmeliste ist unlesbar; Firewall-Aktionen bleiben gesperrt.')
    values = data['entries']
    if not isinstance(values, list) or len(values) > MAX_FIREWALL_ALLOWLIST:
        raise ValueError('Guardian-IP-Ausnahmeliste ist ungueltig oder ueberschreitet das Limit.')
    entries = []
    seen = set()
    for item in values:
        if not isinstance(item, dict):
            raise ValueError('Guardian-IP-Ausnahmeliste enthaelt einen ungueltigen Eintrag.')
        try:
            network = str(ipaddress.ip_network(item.get('network', ''), strict=True))
        except (TypeError, ValueError):
            raise ValueError('Guardian-IP-Ausnahmeliste enthaelt ein ungueltiges Netz.')
        comment = item.get('comment', '')
        created_at = item.get('created_at', '')
        if (network in seen or not isinstance(comment, str) or not 1 <= len(comment.strip()) <= 120 or
                not isinstance(created_at, str) or not 1 <= len(created_at) <= 40):
            raise ValueError('Guardian-IP-Ausnahmeliste enthaelt unvollstaendige Metadaten.')
        try:
            canonical = _firewall_target(network)
        except ValueError as exc:
            raise ValueError('Guardian-IP-Ausnahmeliste enthaelt ein unzulaessiges Netz: ' + str(exc))
        if canonical != network:
            raise ValueError('Guardian-IP-Ausnahmeliste enthaelt ein nicht-kanonisches Netz.')
        network_obj = ipaddress.ip_network(network)
        if any(network_obj.version == ipaddress.ip_network(row['network']).version and
               network_obj.overlaps(ipaddress.ip_network(row['network'])) for row in entries):
            raise ValueError('Guardian-IP-Ausnahmeliste enthaelt sich ueberschneidende Netze.')
        seen.add(network)
        entries.append({'network': network, 'comment': comment.strip(), 'created_at': created_at})
    return entries


def _firewall_allowlist_change(operation, value, comment=''):
    if operation not in ('allowlist-add', 'allowlist-remove'):
        raise ValueError('Ungueltige Guardian-IP-Ausnahmeaktion.')
    network = _firewall_target(value)
    entries = firewall_allowlist_entries()
    existing = next((item for item in entries if item['network'] == network), None)
    if operation == 'allowlist-remove':
        if existing is None:
            raise ValueError('Guardian-IP-Ausnahme nicht gefunden.')
        entries = [item for item in entries if item['network'] != network]
        message = 'Guardian-IP-Ausnahme entfernt; kuenftige Guardian-Sperren sind wieder moeglich.'
    else:
        if (not isinstance(comment, str) or not 1 <= len(comment.strip()) <= 120 or
                any(ord(c) < 32 or ord(c) == 127 for c in comment)):
            raise ValueError('Kommentar muss 1 bis 120 druckbare Zeichen enthalten.')
        if existing:
            raise ValueError('Diese Guardian-IP-Ausnahme ist bereits eingetragen.')
        if len(entries) >= MAX_FIREWALL_ALLOWLIST:
            raise ValueError('Guardian-IP-Ausnahmeliste ist voll (maximal %d Eintraege).' % MAX_FIREWALL_ALLOWLIST)
        network_obj = ipaddress.ip_network(network)
        if any(network_obj.version == ipaddress.ip_network(item['network']).version and
               network_obj.overlaps(ipaddress.ip_network(item['network'])) for item in entries):
            raise ValueError('Die IP ueberschneidet sich mit einer bestehenden Guardian-IP-Ausnahme.')
        listing = firewall_rules()
        if not listing.get('available') or listing.get('limited'):
            raise ValueError('Plesk-Firewallregeln koennen nicht sicher auf Konflikte mit bestehenden Guardian-Sperren geprueft werden.')
        if not firewall_status().get('plesk_firewall_active'):
            raise ValueError('Plesk-Firewall-Regelverwaltung ist nicht aktiv; Guardian-Ausnahme nicht gespeichert.')
        conflicts = [row for row in listing.get('rules', [])
                     if row.get('kind') == 'ip_deny' or
                     (row.get('kind') == 'port' and row.get('action') == 'deny')]
        if any(network_obj.version == ipaddress.ip_network(row['network']).version and
               network_obj.overlaps(ipaddress.ip_network(row['network'])) for row in conflicts):
            raise ValueError('Es gibt bereits eine Guardian-Sperre fuer dieses Netz; zuerst die Sperre ueber Plesk entfernen.')
        entries.append({'network': network, 'comment': comment.strip(), 'created_at': utc_now()})
        entries.sort(key=lambda item: (ipaddress.ip_network(item['network']).version,
                                       int(ipaddress.ip_network(item['network']).network_address)))
        message = 'Guardian wird dieses Netz bei eigenen IP- und Port-Sperren ausnehmen.'
    prepare_dir()
    write_json(FIREWALL_ALLOWLIST, {'entries': entries}, max_bytes=64000)
    incident_log('operator', 'warning' if operation == 'allowlist-add' else 'info', '',
                 ('Guardian-IP-Ausnahme gesetzt: ' if operation == 'allowlist-add' else
                  'Guardian-IP-Ausnahme entfernt: ') + network +
                 ((' – ' + comment.strip()) if operation == 'allowlist-add' else ''))
    return {'ok': True, 'network': network, 'message': message}


def _firewall_target(value):
    try:
        network = ipaddress.ip_network(value, strict=False)
    except (TypeError, ValueError):
        raise ValueError('Ungueltige IPv4-/IPv6-Adresse oder CIDR.')
    if ((network.version == 4 and network.prefixlen < 24) or
            (network.version == 6 and network.prefixlen < 64)):
        raise ValueError('Zu grosses Netz: maximal IPv4 /24 oder IPv6 /64 sperrbar.')
    protected = ([ipaddress.ip_network(x) for x in
                  ('0.0.0.0/8', '127.0.0.0/8', '169.254.0.0/16', '224.0.0.0/4')]
                 if network.version == 4 else
                 [ipaddress.ip_network(x) for x in ('::/128', '::1/128', 'fe80::/10', 'ff00::/8')])
    if any(network.overlaps(blocked) for blocked in protected):
        raise ValueError('Lokale, Link-Local-, Multicast- oder unspezifizierte Netze duerfen nicht gesperrt werden.')
    return str(network)


def _firewall_action(operation, target='', remote_address='', ttl_seconds=0, port='', protocol=''):
    """Stage one Plesk-native IP/port rule; Plesk rolls it back unless confirmed."""
    if os.geteuid() != 0:
        raise ValueError('Root-Verwaltung erforderlich.')
    if operation in ('allowlist-add', 'allowlist-remove'):
        return _firewall_allowlist_change(operation, target, remote_address)
    plesk = binary(PLESK_BINARIES)
    if not plesk or not FIREWALL_SETTINGS.is_file():
        raise ValueError('Plesk Firewall ist nicht installiert oder ihre CLI fehlt.')
    state = firewall_status()
    if not state['plesk_firewall_active']:
        raise ValueError('Plesk Firewall-Regelverwaltung ist nicht aktiv; Guardian aktiviert sie nicht automatisch.')
    ctl = binary(SYSTEMCTL_PATHS)
    if ctl:
        firewalld = execute([ctl, 'is-active', 'firewalld'], 3)
        if firewalld and firewalld.returncode == 0 and firewalld.stdout.strip() == 'active':
            raise ValueError('firewalld ist gleichzeitig aktiv; Plesk warnt vor konkurrierenden Firewall-Regeln.')

    if operation in ('confirm', 'cancel'):
        pending = read_json(FIREWALL_PENDING, {})
        if not pending or pending.get('state') != 'awaiting_confirmation':
            raise ValueError('Keine ausstehende Guardian-Firewall-Aenderung.')
        elapsed = time.time() - float(pending.get('started_epoch', 0))
        if operation == 'confirm' and elapsed > 55:
            raise ValueError('Plesk-Bestaetigungsfenster ist fast abgelaufen; Firewall-Rollback abwarten und erneut pruefen.')
        expiry_data = read_json(FIREWALL_EXPIRIES, {})
        network = pending.get('network', '')
        staged_expiry = False
        if operation == 'confirm' and pending.get('action') == 'ban':
            ttl = pending.get('ttl_seconds', 0)
            if not isinstance(ttl, int) or isinstance(ttl, bool) or ttl not in FIREWALL_TTLS:
                raise ValueError('Ungueltige Firewall-Sperrdauer in ausstehender Aenderung.')
            if ttl:
                expiry_data[network] = int(time.time()) + ttl
            else:
                expiry_data.pop(network, None)
            write_json(FIREWALL_EXPIRIES, expiry_data)
            staged_expiry = True
        command = '--confirm' if operation == 'confirm' else '--reset'
        result = execute([plesk, 'ext', 'firewall', command], timeout=12)
        if result is None or result.returncode:
            if staged_expiry and pending.get('action') == 'ban':
                expiry_data.pop(network, None)
                write_json(FIREWALL_EXPIRIES, expiry_data)
            raise ValueError('Plesk Firewall hat die Aenderung nicht bestaetigt/zurueckgesetzt.')
        if operation == 'confirm' and pending.get('action') == 'unban':
            expiry_data.pop(network, None)
            write_json(FIREWALL_EXPIRIES, expiry_data)
        try:
            FIREWALL_PENDING.unlink()
        except FileNotFoundError:
            pass
        incident_log('operator', 'warning' if operation == 'confirm' else 'info', '',
                     'Guardian-Firewall-Aenderung ' + ('bestaetigt.' if operation == 'confirm' else 'zurueckgesetzt.'))
        return {'ok': True, 'state': 'confirmed' if operation == 'confirm' else 'cancelled',
                'network': pending.get('network', '')}

    if operation not in ('ban', 'unban', 'port-allow', 'port-deny', 'port-remove'):
        raise ValueError('Ungueltige Guardian-Firewall-Aktion.')
    if operation == 'port-remove':
        if not isinstance(target, str) or not target.isdigit() or len(target) > 12:
            raise ValueError('Ungueltige Guardian-Firewall-Regel-ID.')
        network = ''
    else:
        network = _firewall_target(target)
    is_port = operation in ('port-allow', 'port-deny')
    if is_port:
        if (not isinstance(port, str) or not port.isdigit() or len(port) > 5 or
                not 1 <= int(port) <= 65535 or protocol not in ('tcp', 'udp')):
            raise ValueError('Ungueltiger Port oder Transportprotokoll.')
        if operation == 'port-allow' and ipaddress.ip_network(network).prefixlen != ipaddress.ip_network(network).max_prefixlen:
            raise ValueError('Portfreigaben sind nur fuer eine einzelne IPv4- oder IPv6-Adresse erlaubt.')
    elif port or protocol:
        raise ValueError('Portangaben sind fuer diese Firewall-Aktion nicht zulaessig.')
    if (not isinstance(ttl_seconds, int) or isinstance(ttl_seconds, bool) or
            ttl_seconds not in FIREWALL_TTLS or (operation != 'ban' and ttl_seconds != 0)):
        raise ValueError('Ungueltige Sperrdauer. Erlaubt: dauerhaft, 1 Stunde, 24 Stunden oder 7 Tage.')
    if operation in ('ban', 'port-deny'):
        try:
            client = ipaddress.ip_address(remote_address)
        except ValueError:
            raise ValueError('Admin-Verbindungs-IP kann nicht sicher bestimmt werden; Sperre abgelehnt.')
        if client in ipaddress.ip_network(network):
            raise ValueError('Admin-Verbindungs-IP liegt im zu sperrenden Netz; Sperre abgelehnt.')

    pending = read_json(FIREWALL_PENDING, {})
    if pending and pending.get('state') == 'awaiting_confirmation':
        if time.time() - float(pending.get('started_epoch', 0)) <= 90:
            raise ValueError('Es gibt bereits eine ausstehende Firewall-Aenderung; erst bestaetigen oder zuruecksetzen.')
        reset = execute([plesk, 'ext', 'firewall', '--reset'], timeout=12)
        if reset is None or reset.returncode:
            raise ValueError('Abgelaufene Firewall-Aenderung konnte nicht sicher zurueckgesetzt werden.')
        try:
            FIREWALL_PENDING.unlink()
        except FileNotFoundError:
            pass

    listing = firewall_rules()
    if not listing['available'] or listing.get('limited'):
        raise ValueError('Guardian kann die Plesk-Firewallregeln nicht sicher auflisten.')
    if operation in ('ban', 'port-deny'):
        blocked_network = ipaddress.ip_network(network)
        for exception in firewall_allowlist_entries():
            trusted_network = ipaddress.ip_network(exception['network'])
            if (blocked_network.version == trusted_network.version and
                    blocked_network.overlaps(trusted_network)):
                raise ValueError('Die IP ueberschneidet sich mit einer Guardian-IP-Ausnahme; Sperre abgelehnt.')
    if operation == 'ban':
        matches = [row for row in listing['rules'] if row['kind'] == 'ip_deny' and row['network'] == network]
    elif operation in ('port-allow', 'port-deny'):
        target_net = ipaddress.ip_network(network)
        matches = [row for row in listing['rules'] if row['kind'] == 'port' and
                   row['port'] == int(port) and row['protocol'] == protocol and
                   ipaddress.ip_network(row['network']).version == target_net.version and
                   target_net.overlaps(ipaddress.ip_network(row['network']))]
        if operation == 'port-allow' and any(
                row.get('kind') == 'ip_deny' and
                ipaddress.ip_network(row['network']).version == target_net.version and
                target_net.overlaps(ipaddress.ip_network(row['network']))
                for row in listing['rules']):
            raise ValueError('Portfreigabe kollidiert mit einer Guardian-IP-Sperre; zuerst die Sperre entfernen.')
    elif operation == 'port-remove':
        matches = [row for row in listing['rules'] if row['kind'] == 'port' and row['id'] == target]
    else:
        matches = [row for row in listing['rules'] if row['kind'] == 'ip_deny' and row['network'] == network]
    if operation in ('ban', 'port-allow', 'port-deny') and matches:
        raise ValueError('Eine Guardian-Regel fuer dieses Netz bzw. diesen Port existiert bereits.')
    if operation in ('unban', 'port-remove') and not matches:
        raise ValueError('Guardian-Firewallregel nicht gefunden.')
    if operation == 'ban':
        name = FIREWALL_RULE_PREFIX + network
        result = execute([plesk, 'ext', 'firewall', '--set-rule', '-name', name,
                          '-direction', 'input', '-action', 'deny',
                          '-remote-addresses', network], timeout=12)
    elif is_port:
        name = FIREWALL_PORT_RULE_PREFIX + operation[5:] + ' ' + protocol + ' ' + str(int(port)) + ' ' + network
        result = execute([plesk, 'ext', 'firewall', '--set-rule', '-name', name,
                          '-direction', 'input', '-action', operation[5:],
                          '-ports', '%d/%s' % (int(port), protocol),
                          '-remote-addresses', network], timeout=12)
    else:
        name = matches[0]['name']
        result = execute([plesk, 'ext', 'firewall', '--remove-rules', matches[0]['id']], timeout=12)
    if result is None or result.returncode:
        raise ValueError('Plesk Firewall hat die Regelbearbeitung abgelehnt.')
    applied = execute([plesk, 'ext', 'firewall', '--apply'], timeout=15)
    if applied is None or applied.returncode:
        reset = execute([plesk, 'ext', 'firewall', '--reset'], timeout=12)
        if reset is None or reset.returncode:
            raise ValueError('Plesk Firewall konnte Aenderung und Reset nicht bestaetigen; ausstehende Plesk-Konfiguration manuell pruefen.')
        raise ValueError('Plesk Firewall konnte die Aenderung nicht anwenden; ausstehende Regeln wurden zurueckgesetzt.')
    prepare_dir()
    now = time.time()
    write_json(FIREWALL_PENDING, {'state': 'awaiting_confirmation', 'action': operation,
                                  'network': network, 'rule_name': name,
                                  'port': int(port) if is_port else 0,
                                  'protocol': protocol if is_port else '',
                                  'started_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                                  'started_epoch': now, 'rollback_seconds': 60,
                                  'ttl_seconds': ttl_seconds})
    incident_log('operator', 'warning', '', 'Plesk-Firewall-Regel ' + name +
                 ' geaendert; wartet auf getrennten Verbindungstest und Bestaetigung.')
    return {'ok': True, 'state': 'awaiting_confirmation', 'action': operation,
            'network': network, 'rollback_seconds': 60,
            'port': int(port) if is_port else 0, 'protocol': protocol if is_port else '',
            'ttl_seconds': ttl_seconds,
            'message': 'Regel angewendet. Verbindung jetzt in einer getrennten Sitzung testen und innerhalb von 60 Sekunden bestaetigen; ohne Bestaetigung rollt Plesk zurueck.'}


def firewall_action(operation, target='', remote_address='', ttl_seconds=0, port='', protocol=''):
    if os.geteuid() != 0:
        raise ValueError('Root-Verwaltung erforderlich.')
    prepare_dir()
    lockfd = os.open(str(ROOT / 'firewall.lock'), os.O_CREAT | os.O_RDWR |
                     getattr(os, 'O_NOFOLLOW', 0), 0o600)
    try:
        fcntl.flock(lockfd, fcntl.LOCK_EX)
        firewall_debug_log('action', stage=operation)
        try:
            return _firewall_action(operation, target, remote_address, ttl_seconds, port, protocol)
        except (ValueError, OSError, subprocess.SubprocessError) as exc:
            firewall_debug_log('action-error', stage=operation, detail=str(exc)[:180])
            raise
    finally:
        os.close(lockfd)


def parse_waf_lines(lines):
    """Return limited, sanitized WAF metadata; never expose request bodies/tokens."""
    events = []
    timestamp = None
    for line in lines:
        # Audit-log section A starts with "[dd/Mon/yyyy:HH:MM:SS +zzzz] <id> <ip> <port> ...".
        stamp = re.match(r'\[(\d{2}/[A-Za-z]{3}/\d{4}:\d{2}:\d{2}:\d{2} [+-]\d{4})\]', line)
        if stamp:
            try:
                parsed = datetime.datetime.strptime(stamp.group(1), '%d/%b/%Y:%H:%M:%S %z')
                timestamp = {'ts': parsed.isoformat(), 'epoch': int(parsed.timestamp())}
            except ValueError:
                timestamp = None
            continue
        if not (line.startswith('Message:') or 'ModSecurity:' in line):
            continue
        rule = re.search(r'\[id "(\d{1,12})"\]', line)
        address = re.search(r'\[client ([0-9a-fA-F:.]+)\]', line)
        severity = re.search(r'\[severity "([A-Za-z]{1,20})"\]', line)
        if not rule and not address:
            continue
        ip = None
        if address:
            try:
                ip = str(ipaddress.ip_address(address.group(1)))
            except ValueError:
                pass
        event = {'rule': rule.group(1) if rule else 'unbekannt', 'ip': ip,
                 'blocked': 'Access denied' in line,
                 'severity': severity.group(1).upper() if severity else ''}
        if timestamp:
            event.update(timestamp)
        events.append(event)
    return events[-200:][::-1]


def waf_status():
    try:
        with MODSEC_LOG.open('rb') as fp:
            fp.seek(0, os.SEEK_END)
            size = fp.tell()
            fp.seek(max(0, size - 512 * 1024))
            content = fp.read(512 * 1024)
        # First line may be truncated when reading from the tail.
        if size > len(content):
            content = content.partition(b'\n')[2]
        events = parse_waf_lines(content.decode('utf-8', 'replace').splitlines())
        return {'available': True, 'recent_events': events, 'tail_bytes': len(content),
                'note': 'Nur letzte 512 KiB des Audit-Logs; keine vollstaendige Statistik.'}
    except OSError:
        return {'available': False, 'recent_events': [], 'note': 'Audit-Log nicht lesbar oder nicht vorhanden.'}


def blocked_ip_geo_status(fail2ban, crowdsec, waflog):
    """Aggregate public blocked IPs by country using an optional local DB-IP Lite MMDB."""
    result = {'available': False, 'provider': 'DB-IP Lite', 'release': '',
              'blocked_ip_count': 0, 'mapped_ip_count': 0, 'unmapped_ip_count': 0,
              'countries': [], 'source_counts': {'fail2ban': 0, 'crowdsec': 0, 'waf': 0},
              'note': 'Lokale GeoIP-Datenbank fehlt oder maxminddb ist nicht installiert.'}
    addresses = {}

    def add(value, source):
        if not isinstance(value, str) or len(addresses) >= MAX_GEOIP_ADDRESSES:
            return
        try:
            address = ipaddress.ip_address(value)
        except ValueError:
            return
        if not address.is_global:
            return
        addresses.setdefault(str(address), set()).add(source)

    if isinstance(fail2ban, dict):
        for jail in fail2ban.get('jails', [])[:MAX_JAILS]:
            if isinstance(jail, dict):
                for address in jail.get('banned_ips', [])[:MAX_FAIL2BAN_IPS_PER_JAIL]:
                    add(address, 'fail2ban')
    if isinstance(crowdsec, dict):
        for decision in crowdsec.get('decisions', [])[:MAX_CROWDSEC_DECISIONS]:
            if isinstance(decision, dict) and str(decision.get('type', '')).lower() == 'ban':
                # CIDR decisions are intentionally not expanded into individual IPs.
                add(decision.get('ip', ''), 'crowdsec')
    if isinstance(waflog, dict):
        for event in waflog.get('recent_events', [])[:30]:
            if isinstance(event, dict) and event.get('blocked'):
                add(event.get('ip', ''), 'waf')

    result['blocked_ip_count'] = len(addresses)
    for source in result['source_counts']:
        result['source_counts'][source] = sum(1 for sources in addresses.values() if source in sources)
    try:
        st = GEOIP_DATABASE.lstat()
        if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1
                or (st.st_mode & 0o077) or st.st_size < 1024 * 1024
                or st.st_size > 64 * 1024 * 1024):
            result['note'] = 'GeoIP-Datenbank hat ungueltige Dateirechte oder Groesse.'
            return result
        with GEOIP_LICENSE.open('r', encoding='utf-8') as license_file:
            license_text = license_file.read(4096)
        release = re.search(r'(?im)^release\s*:\s*(20\d\d-\d\d)\s*$', license_text)
        result['release'] = release.group(1) if release else ''
        import maxminddb
        reader = maxminddb.open_database(str(GEOIP_DATABASE))
    except (OSError, ImportError, ValueError):
        return result

    countries = {}
    mapped = set()
    try:
        for address, sources in addresses.items():
            record = reader.get(address) or {}
            country = record.get('country', {}) if isinstance(record, dict) else {}
            if not isinstance(country, dict):
                country = {}
            code = country.get('iso_code') or country.get('isoCode') or ''
            names = country.get('names', {})
            name = names.get('en', '') if isinstance(names, dict) else ''
            if not isinstance(code, str) or not re.fullmatch(r'[A-Z]{2}', code.upper()):
                continue
            code = code.upper()
            if not isinstance(name, str) or not name:
                name = code
            bucket = countries.setdefault(code, {'code': code, 'name': name,
                                                   'count': 0, 'sources': set()})
            bucket['count'] += 1
            bucket['sources'].update(sources)
            mapped.add(address)
    finally:
        reader.close()
    result['available'] = True
    result['mapped_ip_count'] = len(mapped)
    result['unmapped_ip_count'] = len(addresses) - len(mapped)
    result['countries'] = sorted(
        ({'code': value['code'], 'name': value['name'], 'count': value['count'],
          'sources': sorted(value['sources'])} for value in countries.values()),
        key=lambda item: (-item['count'], item['code']))[:80]
    result['note'] = ('Laenderzuordnung ist eine ungefaehre IP-Standortbestimmung. '
                      'VPNs, Proxies, Mobilfunknetze und Anycast/CDNs koennen den Provider-Standort zeigen.')
    return result


def ensure_private_dir(path):
    if not path.exists():
        path.mkdir(mode=0o700)
    st = path.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or (st.st_mode & 0o077):
        raise ValueError('Unsicheres Datenverzeichnis: ' + str(path))


def prepare_dir():
    ensure_private_dir(ROOT)
    ensure_private_dir(ROOT / 'jobs')
    ensure_private_dir(ROOT / 'quarantine')
    ensure_private_dir(ROOT / 'watch')
    ensure_private_dir(ROOT / 'scan-cache')


def read_json(path, default=None, max_bytes=500000):
    try:
        fd = os.open(str(path), os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
        with os.fdopen(fd, 'rb') as inp:
            st = os.fstat(inp.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_size > max_bytes:
                return default
            data = json.loads(inp.read().decode('utf-8'))
        return data if isinstance(data, dict) else default
    except (OSError, ValueError, UnicodeError):
        return default


def write_json(path, info, max_bytes=500000):
    temp = path.parent / ('tmp-' + uuid.uuid4().hex)
    data = json.dumps(info, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
    if len(data) > max_bytes:
        raise ValueError('Bericht zu gross.')
    fd = os.open(str(temp), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    try:
        with os.fdopen(fd, 'wb') as out:
            out.write(data)
            out.flush()
            os.fsync(out.fileno())
        os.replace(str(temp), str(path))
    finally:
        try:
            temp.unlink()
        except FileNotFoundError:
            pass


def firewall_debug_settings():
    try:
        st = FIREWALL_DEBUG_CONFIG.lstat()
    except FileNotFoundError:
        return {'enabled': False, 'error': ''}
    except OSError:
        return {'enabled': False, 'error': 'Diagnoseeinstellung nicht lesbar.'}
    if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or (st.st_mode & 0o077)):
        return {'enabled': False, 'error': 'Diagnoseeinstellung hat unsichere Dateirechte.'}
    data = read_json(FIREWALL_DEBUG_CONFIG, None, 4096)
    if not isinstance(data, dict) or set(data) != {'enabled'} or not isinstance(data['enabled'], bool):
        return {'enabled': False, 'error': 'Diagnoseeinstellung ist ungueltig.'}
    return {'enabled': data['enabled'], 'error': ''}


def firewall_debug_list(limit=50):
    limit = min(MAX_FIREWALL_DEBUG_EVENTS, max(1, int(limit)))
    items = []
    try:
        fd = os.open(str(FIREWALL_DEBUG_LOG), os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
        with os.fdopen(fd, 'rb') as stream:
            st = os.fstat(stream.fileno())
            if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or
                    st.st_size > MAX_FIREWALL_DEBUG_BYTES or st.st_mode & 0o077):
                return []
            raw = stream.read(MAX_FIREWALL_DEBUG_BYTES)
        for line in raw.splitlines()[-limit:]:
            try:
                item = json.loads(line.decode('utf-8'))
            except (ValueError, UnicodeError):
                continue
            if isinstance(item, dict) and set(item).issubset(
                    {'time', 'kind', 'stage', 'returncode', 'duration_ms', 'output_bytes', 'detail'}):
                items.append(item)
    except (FileNotFoundError, OSError):
        pass
    return items


def firewall_debug_status():
    settings = firewall_debug_settings()
    try:
        size = FIREWALL_DEBUG_LOG.stat().st_size
    except OSError:
        size = 0
    return {'debug_enabled': settings['enabled'], 'debug_error': settings['error'],
            'debug_events': firewall_debug_list(), 'debug_log_bytes': min(size, MAX_FIREWALL_DEBUG_BYTES),
            'debug_log_limit_bytes': MAX_FIREWALL_DEBUG_BYTES}


def firewall_debug_log(kind, stage='', returncode=None, duration_ms=None, output_bytes=None, detail=''):
    """Append a bounded, root-only trace. It records Plesk CLI status, never stdout or command arguments."""
    try:
        if not firewall_debug_settings()['enabled']:
            return
        prepare_dir()
        item = {'time': utc_now(), 'kind': re.sub(r'[^a-z0-9_-]', '', str(kind).lower())[:40],
                'stage': re.sub(r'[^a-z0-9_-]', '', str(stage).lower())[:40]}
        if isinstance(returncode, int) and not isinstance(returncode, bool):
            item['returncode'] = returncode
        if isinstance(duration_ms, int) and not isinstance(duration_ms, bool) and duration_ms >= 0:
            item['duration_ms'] = min(duration_ms, 3600000)
        if isinstance(output_bytes, int) and not isinstance(output_bytes, bool) and output_bytes >= 0:
            item['output_bytes'] = min(output_bytes, 10 * 1024 * 1024)
        if detail:
            item['detail'] = re.sub(r'[\x00-\x1f\x7f]+', ' ', str(detail))[:180]
        line = (json.dumps(item, ensure_ascii=False, separators=(',', ':')) + '\n').encode('utf-8')
        lock = os.open(str(FIREWALL_DEBUG_LOCK), os.O_CREAT | os.O_RDWR | getattr(os, 'O_NOFOLLOW', 0), 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX)
            existing = b''
            try:
                fd = os.open(str(FIREWALL_DEBUG_LOG), os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
                with os.fdopen(fd, 'rb') as stream:
                    st = os.fstat(stream.fileno())
                    if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or st.st_mode & 0o077):
                        return
                    stream.seek(max(0, st.st_size - MAX_FIREWALL_DEBUG_BYTES))
                    existing = stream.read(MAX_FIREWALL_DEBUG_BYTES)
                    if st.st_size > len(existing):
                        existing = existing.partition(b'\n')[2]
            except FileNotFoundError:
                pass
            combined = existing + line
            if len(combined) > MAX_FIREWALL_DEBUG_BYTES:
                combined = combined[-(MAX_FIREWALL_DEBUG_BYTES - len(line)):]
                if b'\n' in combined:
                    combined = combined.partition(b'\n')[2]
                combined += line
            fd = os.open(str(FIREWALL_DEBUG_LOG), os.O_WRONLY | os.O_CREAT | os.O_TRUNC |
                         getattr(os, 'O_NOFOLLOW', 0), 0o600)
            with os.fdopen(fd, 'wb') as stream:
                os.fchown(stream.fileno(), 0, 0)
                os.fchmod(stream.fileno(), 0o600)
                stream.write(combined[-MAX_FIREWALL_DEBUG_BYTES:])
                stream.flush()
                os.fsync(stream.fileno())
        finally:
            os.close(lock)
    except (OSError, ValueError, TypeError):
        # Debug logging must never break a firewall operation.
        return


def firewall_debug_set(enabled):
    if os.geteuid() != 0 or not isinstance(enabled, bool):
        raise ValueError('Ungueltige Firewall-Diagnoseeinstellung.')
    if firewall_debug_settings()['error']:
        raise ValueError(firewall_debug_settings()['error'])
    prepare_dir()
    if not enabled:
        firewall_debug_log('setting', stage='disabled')
    write_json(FIREWALL_DEBUG_CONFIG, {'enabled': enabled}, 4096)
    if enabled:
        firewall_debug_log('setting', stage='enabled')
    return firewall_debug_status()


def incident_log(event_type, severity, domain='', detail='', relative=''):
    """Root-private bounded audit trail; never log file bodies or credentials."""
    prepare_dir()
    if event_type not in ('file_change', 'malware_detected', 'cron_suspicious', 'cms_checksum_mismatch',
                          'cms_database_indicators', 'scan_complete',
                          'monitor_started', 'monitor_stopped', 'monitor_limit',
                          'monitor_overflow', 'operator', 'notification_error'):
        raise ValueError('Unbekannter Ereignistyp.')
    if severity not in ('info', 'warning', 'critical'):
        raise ValueError('Ungueltige Schwere.')
    if domain and not valid_domain(domain):
        domain = ''
    if relative and not safe_relative(relative):
        relative = ''
    obj = {'id': uuid.uuid4().hex, 'time': utc_now(), 'type': event_type,
           'severity': severity, 'domain': domain, 'path': relative[:240],
           'detail': re.sub(r'[\x00-\x1f]+', ' ', str(detail))[:180]}
    lock = os.open(str(ROOT / 'incidents.lock'), os.O_CREAT | os.O_RDWR | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if INCIDENT_LOG.is_file() and INCIDENT_LOG.stat().st_size > 2_000_000:
            archived = ROOT / 'incidents.previous.jsonl'
            os.replace(str(INCIDENT_LOG), str(archived))
        fd = os.open(str(INCIDENT_LOG), os.O_WRONLY | os.O_APPEND | os.O_CREAT |
                     getattr(os, 'O_NOFOLLOW', 0), 0o600)
        with os.fdopen(fd, 'ab') as output:
            output.write((json.dumps(obj, ensure_ascii=False) + '\n').encode('utf-8'))
            output.flush()
    finally:
        os.close(lock)
    if event_type == 'malware_detected':
        try:
            notify_alert(obj)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            try:
                alert_queue_add(obj, str(exc))
            except (OSError, ValueError) as queue_exc:
                exc = ValueError('Warteschlange: ' + str(queue_exc))
            incident_log('notification_error', 'warning', domain,
                         'Mail-Warnung vorgemerkt bzw. nicht zustellbar: ' + str(exc)[:130])
    return obj


def incident_list(limit=25):
    """Return limited newest-first metadata; avoid reading an unbounded log."""
    limit = min(200, max(1, int(limit)))
    items = []
    for path in (ROOT / 'incidents.previous.jsonl', INCIDENT_LOG):
        try:
            fd = os.open(str(path), os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
            with os.fdopen(fd, 'rb') as stream:
                stream.seek(0, os.SEEK_END)
                end = stream.tell()
                stream.seek(max(0, end - 180000))
                raw = stream.read(180000)
                if end > len(raw):
                    raw = raw.partition(b'\n')[2]
                for row in raw.splitlines():
                    try:
                        item = json.loads(row)
                        if isinstance(item, dict):
                            items.append({k: item.get(k, '') for k in
                                          ('id', 'time', 'type', 'severity', 'domain', 'path', 'detail')})
                    except (ValueError, UnicodeError):
                        continue
        except OSError:
            continue
    return items[-limit:][::-1]


def alert_settings():
    settings = read_json(ALERT_FILE, {})
    recipient = settings.get('recipient', '') if isinstance(settings, dict) else ''
    return {'enabled': settings.get('enabled') is True and bool(EMAIL_RE.fullmatch(recipient)),
            'recipient': recipient if EMAIL_RE.fullmatch(recipient) else ''}


def set_alert_settings(recipient, enabled):
    if os.geteuid() != 0:
        raise ValueError('Root-Rechte erforderlich.')
    if enabled and not EMAIL_RE.fullmatch(recipient):
        raise ValueError('Bitte eine gueltige E-Mail-Adresse angeben.')
    prepare_dir()
    data = {'enabled': bool(enabled), 'recipient': recipient if EMAIL_RE.fullmatch(recipient) else ''}
    write_json(ALERT_FILE, data)
    incident_log('operator', 'info', detail='E-Mail-Benachrichtigungen ' + ('aktiviert' if enabled else 'deaktiviert'))
    return {'ok': True, 'alerts': data}


def alert_queue_lock():
    prepare_dir()
    fd = os.open(str(ALERT_QUEUE_LOCK), os.O_CREAT | os.O_RDWR | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def alert_queue_read():
    try:
        st = ALERT_QUEUE_FILE.lstat()
    except FileNotFoundError:
        return []
    except OSError as exc:
        raise ValueError('Mail-Warteschlange kann nicht sicher gelesen werden.') from exc
    if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or (st.st_mode & 0o077)):
        raise ValueError('Mail-Warteschlange hat unsichere Dateirechte.')
    data = read_json(ALERT_QUEUE_FILE, None, max_bytes=256000)
    if not isinstance(data, dict) or set(data) != {'schema', 'entries'} or data.get('schema') != 1:
        raise ValueError('Mail-Warteschlange ist ungueltig.')
    entries = data['entries']
    if not isinstance(entries, list) or len(entries) > MAX_ALERT_QUEUE:
        raise ValueError('Mail-Warteschlange enthaelt zu viele oder ungueltige Eintraege.')
    validated = []
    seen = set()
    event_fields = {'id', 'type', 'time', 'severity', 'domain', 'path', 'detail'}
    entry_fields = {'id', 'event', 'created_epoch', 'attempts', 'next_attempt', 'last_error', 'state'}
    for item in entries:
        if not isinstance(item, dict) or set(item) != entry_fields:
            raise ValueError('Mail-Warteschlange enthaelt einen ungueltigen Datensatz.')
        event = item.get('event')
        item_id = item.get('id')
        if (not isinstance(item_id, str) or not re.fullmatch(r'[a-f0-9]{32}', item_id) or
                item_id in seen or not isinstance(event, dict) or
                set(event) != event_fields or event.get('id') != item['id'] or
                event.get('type') != 'malware_detected' or event.get('severity') != 'critical' or
                not isinstance(event.get('time'), str) or len(event['time']) > 40 or
                not isinstance(event.get('domain'), str) or (event['domain'] and not valid_domain(event['domain'])) or
                not isinstance(event.get('path'), str) or len(event['path']) > 240 or
                not isinstance(event.get('detail'), str) or len(event['detail']) > 180):
            raise ValueError('Mail-Warteschlange enthaelt ungueltige Ereignisdaten.')
        if (not isinstance(item.get('created_epoch'), (int, float)) or isinstance(item['created_epoch'], bool) or
                not isinstance(item.get('next_attempt'), (int, float)) or isinstance(item['next_attempt'], bool) or
                not isinstance(item.get('attempts'), int) or isinstance(item['attempts'], bool) or
                not 0 <= item['attempts'] <= MAX_ALERT_ATTEMPTS or
                item.get('state') not in ('pending', 'sending', 'failed') or
                not isinstance(item.get('last_error'), str) or len(item['last_error']) > 180):
            raise ValueError('Mail-Warteschlange enthaelt ungueltige Zustellmetadaten.')
        seen.add(item['id'])
        validated.append(item)
    return validated


def alert_queue_write(entries):
    write_json(ALERT_QUEUE_FILE, {'schema': 1, 'entries': entries}, max_bytes=256000)


def alert_queue_add(event, error_message):
    lockfd = alert_queue_lock()
    try:
        entries = alert_queue_read()
        event_id = event.get('id')
        if not isinstance(event_id, str) or not re.fullmatch(r'[a-f0-9]{32}', event_id):
            raise ValueError('Mail-Ereignis hat keine sichere Kennung.')
        if any(item['id'] == event_id for item in entries):
            return {'queued': False, 'duplicate': True}
        if len(entries) >= MAX_ALERT_QUEUE:
            raise ValueError('Mail-Warteschlange voll; maximal %d Eintraege.' % MAX_ALERT_QUEUE)
        safe_event = {key: event.get(key, '') for key in ('id', 'type', 'time', 'severity', 'domain', 'path', 'detail')}
        entries.append({'id': event_id, 'event': safe_event, 'created_epoch': time.time(),
                        'attempts': 0, 'next_attempt': int(time.time()) + 60,
                        'last_error': re.sub(r'[\x00-\x1f]+', ' ', error_message)[:180], 'state': 'pending'})
        alert_queue_write(entries)
        return {'queued': True, 'duplicate': False}
    finally:
        os.close(lockfd)


def alert_queue_status():
    try:
        entries = alert_queue_read()
    except ValueError as exc:
        return {'pending': 0, 'failed': 0, 'oldest_at': '', 'last_error': '', 'error': str(exc)[:180]}
    pending = [item for item in entries if item['state'] != 'failed']
    failed = [item for item in entries if item['state'] == 'failed']
    oldest = min(pending, key=lambda item: item['created_epoch']) if pending else None
    latest_error = next((item['last_error'] for item in reversed(entries) if item['last_error']), '')
    return {'pending': len(pending), 'failed': len(failed),
            'oldest_at': oldest['event']['time'] if oldest else '', 'last_error': latest_error, 'error': ''}


def notify_alert(event, test=False):
    settings = alert_settings()
    if not settings['enabled']:
        if test:
            raise ValueError('E-Mail-Benachrichtigungen sind deaktiviert.')
        return False
    program = binary(MAIL_PATHS)
    if not program:
        raise ValueError('Sendmail-kompatibler Mail-Transport fehlt.')
    prepare_dir()
    lock = os.open(str(ROOT / 'alert.lock'), os.O_CREAT | os.O_RDWR | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        history_file = ROOT / 'alert-throttle.json'
        history = read_json(history_file, {'sent': {}})
        sent = history.get('sent', {})
        if not isinstance(sent, dict):
            sent = {}
        key = event.get('type', '') + ':' + event.get('domain', '')
        now = time.time()
        if not test and now - float(sent.get(key, 0)) < 900:
            return False
        if not test and now - float(sent.get('__global__', 0)) < 60:
            return False
        # Fixed ASCII header, no user-controlled header fields beyond strictly validated recipient.
        body = ('Guardian Lite Ereignis\n\nTyp: %s\nDomain: %s\nZeit: %s\n'
                'Details: %s\n\nPlesk Guardian Lite > Incidents oeffnen.\n' %
                (event.get('type', ''), event.get('domain', ''), event.get('time', ''), event.get('detail', '')))
        message = ('To: ' + settings['recipient'] + '\nSubject: Guardian Lite Sicherheitswarnung\n'
                   'MIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\n\n' + body)
        proc = subprocess.run([program, '-t', '-i'], input=message.encode('utf-8'),
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=8, check=False, env={'PATH': '/usr/sbin:/usr/bin:/bin'})
        if proc.returncode:
            raise ValueError('Mail-Transport hat den Versand abgelehnt.')
        if not test:
            sent[key] = now
            sent['__global__'] = now
            sent = {k: v for k, v in sent.items() if now - float(v) < 86400}
            write_json(history_file, {'sent': sent})
        return True
    finally:
        os.close(lock)


def alert_test():
    if os.geteuid() != 0:
        raise ValueError('Root-Rechte erforderlich.')
    event = {'type': 'operator', 'domain': '', 'detail': 'Testbenachrichtigung', 'time': utc_now()}
    notify_alert(event, test=True)
    return {'ok': True, 'message': 'Testmail an lokalen Mail-Transport uebergeben (Zustellung nicht garantiert).'}


def alert_queue_process(force=False):
    if os.geteuid() != 0:
        raise ValueError('Root-Rechte erforderlich.')
    if not alert_settings()['enabled']:
        return {'checked': 0, 'delivered': 0, 'failed': 0, 'disabled': True,
                'queue': alert_queue_status()}
    lockfd = alert_queue_lock()
    now = time.time()
    try:
        entries = alert_queue_read()
        if force:
            for item in entries:
                if item['state'] == 'failed':
                    item['state'] = 'pending'
                    item['attempts'] = 0
                    item['next_attempt'] = now
                    item['last_error'] = ''
        due = []
        for item in entries:
            if len(due) >= MAX_ALERT_DELIVERIES_PER_TICK:
                break
            if ((item['state'] == 'pending' and (force or item['next_attempt'] <= now)) or
                    (item['state'] == 'sending' and item['next_attempt'] <= now)):
                item['state'] = 'sending'
                item['next_attempt'] = now + 60
                due.append(item.copy())
        alert_queue_write(entries)
    finally:
        os.close(lockfd)
    delivered = 0
    suppressed = 0
    failed = 0
    for claim in due:
        failure = ''
        try:
            sent = notify_alert(claim['event'])
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            sent = False
            failure = re.sub(r'[\x00-\x1f]+', ' ', str(exc))[:180]
        lockfd = alert_queue_lock()
        try:
            current = alert_queue_read()
            row = next((item for item in current if item['id'] == claim['id']), None)
            if row is not None:
                if not sent and not failure and not alert_settings()['enabled']:
                    row['state'] = 'pending'
                    row['next_attempt'] = time.time() + 3600
                elif sent or not failure:
                    current.remove(row)
                    if sent:
                        delivered += 1
                    else:
                        suppressed += 1
                else:
                    row['attempts'] = min(MAX_ALERT_ATTEMPTS, row['attempts'] + 1)
                    row['last_error'] = failure
                    if row['attempts'] >= MAX_ALERT_ATTEMPTS:
                        row['state'] = 'failed'
                        row['next_attempt'] = 0
                    else:
                        row['state'] = 'pending'
                        row['next_attempt'] = time.time() + min(86400, 3600 * (2 ** (row['attempts'] - 1)))
                    failed += 1
                alert_queue_write(current)
        finally:
            os.close(lockfd)
        if failure:
            incident_log('notification_error', 'warning', claim['event'].get('domain', ''),
                         'Mail-Wiederholung %d/%d fehlgeschlagen: %s' %
                         (min(MAX_ALERT_ATTEMPTS, claim['attempts'] + 1), MAX_ALERT_ATTEMPTS, failure[:100]))
    return {'checked': len(due), 'delivered': delivered, 'suppressed': suppressed, 'failed': failed,
            'queue': alert_queue_status()}


def monitor_config():
    data = read_json(MONITOR_CONFIG, {'domains': {}})
    items = data.get('domains', {}) if isinstance(data, dict) else {}
    return {d: True for d, enabled in items.items()
            if valid_domain(d) and enabled is True} if isinstance(items, dict) else {}


def monitor_state_path(domain):
    if not valid_domain(domain):
        raise ValueError('Ungueltige Monitoring-Domain.')
    return ROOT / 'watch' / ('live-' + hashlib.sha256(domain.encode('ascii')).hexdigest() + '.json')


def monitor_running(domain):
    state = read_json(monitor_state_path(domain), {})
    pid = state.get('pid') if state else None
    if not isinstance(pid, int) or pid < 2:
        return False
    try:
        cmdline = pathlib.Path('/proc/%d/cmdline' % pid).read_bytes()
        return b'guardian-helper' in cmdline and b'watch-worker' in cmdline and domain.encode('ascii') in cmdline
    except OSError:
        return False


def monitor_launch(domain):
    if monitor_running(domain):
        return False
    child = subprocess.Popen([sys.executable, os.path.realpath(__file__), 'watch-worker', domain],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, close_fds=True, cwd='/',
                             start_new_session=True, env={'PATH': '/usr/sbin:/usr/bin:/bin', 'LANG': 'C'})
    write_json(monitor_state_path(domain), {'pid': child.pid, 'started': utc_now(),
                                            'heartbeat': time.time(), 'state': 'starting',
                                            'watch_count': 0})
    return True


def monitor_set(domain, enable):
    if os.geteuid() != 0 or not valid_domain(domain) or enable not in ('on', 'off'):
        raise ValueError('Ungueltige Live-Monitor-Einstellung.')
    if enable == 'on':
        site_docroot(domain)
    prepare_dir()
    fd = os.open(str(ROOT / 'monitor.lock'), os.O_RDWR | os.O_CREAT | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        config = monitor_config()
        if enable == 'on':
            if domain not in config and len(config) >= MAX_MONITOR_DOMAINS:
                raise ValueError('Maximal fuenf Echtzeit-Domains zulaessig.')
            config[domain] = True
        else:
            config.pop(domain, None)
        write_json(MONITOR_CONFIG, {'domains': config})
        if enable == 'on':
            monitor_launch(domain)
    finally:
        os.close(fd)
    incident_log('operator', 'info', domain, 'Echtzeitmonitor ' + ('aktiviert' if enable == 'on' else 'deaktiviert'))
    return {'ok': True, 'domain': domain, 'enabled': enable == 'on'}


def monitor_status():
    config = monitor_config()
    result = []
    for domain in sorted(config):
        state = read_json(monitor_state_path(domain), {})
        alive = monitor_running(domain)
        stamp = float(state.get('heartbeat', 0)) if isinstance(state, dict) else 0
        active = alive and (time.time() - stamp < 120)
        result.append({'domain': domain, 'running': active,
                       'state': state.get('state', 'unknown') if active else 'stopped',
                       'watch_count': state.get('watch_count', 0) if active else 0})
    return result


# Linux inotify: each subdirectory needs its own watch. Hard limit avoids a VPS DoS.
IN_MODIFY = 0x00000002
IN_CLOSE_WRITE = 0x00000008
IN_MOVED_FROM = 0x00000040
IN_MOVED_TO = 0x00000080
IN_CREATE = 0x00000100
IN_DELETE = 0x00000200
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_Q_OVERFLOW = 0x00004000
IN_IGNORED = 0x00008000
IN_ISDIR = 0x40000000
IN_DONT_FOLLOW = 0x02000000
IN_MASK = IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE | IN_DELETE_SELF | IN_MOVE_SELF
IN_EVENT = struct.Struct('iIII')


def watch_worker(domain):
    if os.geteuid() != 0 or not valid_domain(domain) or domain not in monitor_config():
        return 2
    root, uid, gid = site_docroot(domain)
    libc = ctypes.CDLL(None, use_errno=True)
    libc.inotify_init1.argtypes = (ctypes.c_int,)
    libc.inotify_init1.restype = ctypes.c_int
    libc.inotify_add_watch.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32)
    libc.inotify_add_watch.restype = ctypes.c_int
    libc.inotify_rm_watch.argtypes = (ctypes.c_int, ctypes.c_int)
    libc.inotify_rm_watch.restype = ctypes.c_int
    fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
    if fd < 0:
        raise OSError(ctypes.get_errno(), 'Linux inotify nicht verfuegbar')
    by_wd = {}
    limited = False
    recent = {}
    try:
        def add_tree(path, rel='', depth=0):
            nonlocal limited
            if depth > 12 or len(by_wd) >= MAX_WATCH_DIRS:
                limited = True
                return
            if path.is_symlink() or not path.is_dir():
                return
            wd = libc.inotify_add_watch(fd, os.fsencode(str(path)), IN_MASK | IN_DONT_FOLLOW)
            if wd < 0:
                limited = True
                return
            by_wd[wd] = rel
            try:
                with os.scandir(path) as it:
                    # Limit each directory to avoid unbounded memory on hostile sites.
                    for index, entry in enumerate(it):
                        if index >= 2500:
                            limited = True
                            break
                        if entry.is_dir(follow_symlinks=False) and not entry.is_symlink():
                            child = rel + '/' + entry.name if rel else entry.name
                            if safe_relative(child):
                                add_tree(pathlib.Path(entry.path), child, depth + 1)
            except OSError:
                limited = True
        add_tree(root)
        state = 'degraded' if limited else 'running'
        write_json(monitor_state_path(domain), {'pid': os.getpid(), 'state': state,
                   'started': utc_now(), 'heartbeat': time.time(), 'watch_count': len(by_wd)})
        incident_log('monitor_started', 'warning' if limited else 'info', domain,
                     'Live-Monitor gestartet; %d Verzeichnisse%s' %
                     (len(by_wd), ' (Limit erreicht)' if limited else ''))
        last_heartbeat = 0
        while domain in monitor_config():
            now = time.time()
            if now - last_heartbeat > 25:
                write_json(monitor_state_path(domain), {'pid': os.getpid(),
                    'state': 'degraded' if limited else 'running', 'started': utc_now(),
                    'heartbeat': now, 'watch_count': len(by_wd)})
                last_heartbeat = now
            readable, _, _ = select.select([fd], [], [], 3)
            if not readable:
                continue
            try:
                payload = os.read(fd, 65536)
            except BlockingIOError:
                continue
            offset = 0
            while offset + IN_EVENT.size <= len(payload):
                wd, mask, cookie, namelen = IN_EVENT.unpack_from(payload, offset)
                offset += IN_EVENT.size
                if offset + namelen > len(payload):
                    break
                name = payload[offset:offset + namelen].split(b'\x00', 1)[0].decode('utf-8', 'replace')
                offset += namelen
                if mask & IN_Q_OVERFLOW:
                    limited = True
                    incident_log('monitor_overflow', 'warning', domain, 'inotify-Queue uebergelaufen; erneuten Vollscan ausfuehren.')
                    continue
                if mask & IN_IGNORED:
                    by_wd.pop(wd, None)
                    continue
                if wd in by_wd and not by_wd[wd] and mask & (IN_DELETE_SELF | IN_MOVE_SELF):
                    raise ValueError('Document-Root verschoben oder geloescht; Monitor beendet.')
                if wd not in by_wd or not name or '/' in name or name in ('.', '..'):
                    continue
                parent = by_wd[wd]
                rel = parent + '/' + name if parent else name
                if not safe_relative(rel):
                    continue
                abs_path = root / rel
                if mask & IN_ISDIR:
                    if mask & (IN_MOVED_FROM | IN_DELETE):
                        # inotify follows inodes even outside the document root.
                        # Drop the entire old subtree before handling MOVED_TO.
                        for old_wd, old_rel in list(by_wd.items()):
                            if old_rel == rel or old_rel.startswith(rel + '/'):
                                by_wd.pop(old_wd, None)
                                libc.inotify_rm_watch(fd, old_wd)
                        recent = {p: t for p, t in recent.items()
                                  if p != rel and not p.startswith(rel + '/')}
                    if mask & (IN_CREATE | IN_MOVED_TO):
                        add_tree(abs_path, rel, rel.count('/') + 1)
                    continue
                if not rel.lower().endswith(WATCH_SUFFIXES):
                    continue
                # Do not log every transient create; only closed or atomically moved writes.
                if not mask & (IN_CLOSE_WRITE | IN_MOVED_TO | IN_DELETE):
                    continue
                if now - recent.get(rel, 0) < 6:
                    continue
                recent[rel] = now
                if len(recent) > 1200:
                    recent = {k: t for k, t in recent.items() if now - t < 30}
                if mask & IN_DELETE:
                    incident_log('file_change', 'warning', domain, 'Datei geloescht', rel)
                    continue
                incident_log('file_change', 'info', domain, 'Schreibvorgang erkannt', rel)
                # Targeted virus scan runs as the site owner, never as root.
                clam = binary(CLAM_PATHS)
                if not clam:
                    continue
                try:
                    metadata, dfd, _ = file_metadata(root, rel, max_bytes=8 * 1024 * 1024)
                    os.close(dfd)
                    if metadata['uid'] != uid:
                        continue
                    result = subprocess.run([clam, '--infected', '--no-summary',
                                             '--follow-file-symlinks=0', '--max-filesize=8M',
                                             str(abs_path)], stdin=subprocess.DEVNULL,
                                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                            timeout=25, cwd='/', check=False,
                                            preexec_fn=lambda: drop_privileges(uid, gid),
                                            env={'PATH': '/usr/bin:/bin', 'LANG': 'C'})
                    if result.returncode == 1 and b' FOUND' in result.stdout:
                        if metadata['sha256'] in ignored_hash_set(domain):
                            incident_log('file_change', 'info', domain,
                                         'ClamAV-Treffer mit administrativ ignoriertem SHA-256-Inhalt.', rel)
                        else:
                            incident_log('malware_detected', 'critical', domain,
                                         'ClamAV meldet Malware. Datei nicht automatisch veraendert.', rel)
                except (ValueError, OSError, subprocess.TimeoutExpired):
                    continue
        incident_log('monitor_stopped', 'info', domain, 'Live-Monitor beendet')
        return 0
    finally:
        os.close(fd)
        write_json(monitor_state_path(domain), {'pid': 0, 'state': 'stopped',
                                                 'heartbeat': time.time(), 'watch_count': 0})


def job_path(jobid):
    if not JOB_ID.fullmatch(jobid):
        raise ValueError('Ungueltige Job-ID.')
    return ROOT / 'jobs' / (jobid + '.json')


def load_job(jobid):
    return read_json(job_path(jobid))


def save_job(data):
    write_json(job_path(data['id']), data)
    write_json(ROOT / 'latest.json', {'id': data['id']})


def read_scan(jobid=None, include_output=True):
    if jobid is None:
        latest = read_json(ROOT / 'latest.json')
        jobid = latest.get('id') if latest else None
        if not jobid:
            # Preserve visibility of reports from version 0.1.0.
            legacy = read_json(ROOT / 'scan.json')
            return legacy
    if not isinstance(jobid, str) or not JOB_ID.fullmatch(jobid):
        return None
    scan = load_job(jobid)
    if scan is None:
        return None
    if include_output:
        try:
            with (ROOT / 'jobs' / (jobid + '.log')).open('rb') as fp:
                scan['output'] = fp.read(LOG_LIMIT).decode('utf-8', 'replace')
        except OSError:
            scan['output'] = ''
    if scan.get('status') in ('starting', 'running'):
        age = time.time() - float(scan.get('epoch', 0))
        pid = scan.get('pid')
        alive = False
        if isinstance(pid, int) and pid > 0:
            try:
                os.kill(pid, 0)
                alive = True
            except OSError:
                pass
        if not alive and age > 30:
            scan['status'] = 'interrupted'
            scan['error'] = 'Scan-Prozess nicht mehr aktiv.'
    return scan


def queue_lock(blocking=True):
    """Serialize scan queue updates independently from the single-scan lock."""
    prepare_dir()
    fd = os.open(str(ROOT / 'scan-queue.lock'), os.O_RDWR | os.O_CREAT |
                 getattr(os, 'O_NOFOLLOW', 0), 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
    except (OSError, BlockingIOError):
        os.close(fd)
        raise
    return fd


def queued_jobs():
    data = read_json(ROOT / 'scan-queue.json', {'jobs': []})
    values = data.get('jobs', []) if isinstance(data, dict) else []
    return [item for item in values if isinstance(item, str) and JOB_ID.fullmatch(item)] \
        if isinstance(values, list) else []


def scan_queue_status():
    pending = []
    for jobid in queued_jobs():
        item = read_scan(jobid, include_output=False)
        if item and item.get('status') == 'queued':
            pending.append({'id': jobid, 'domain': item.get('domain', ''),
                            'queued_at': item.get('queued_at', item.get('started_at', '')),
                            'trigger': item.get('trigger', 'manual')})
    return {'count': len(pending), 'jobs': pending[:MAX_HISTORY], 'limit': MAX_SCAN_QUEUE}


def enqueue_scan(domain, trigger):
    """Persist a bounded serial scan job; never run two directory scans at once."""
    prepare_dir()
    lockfd = queue_lock()
    try:
        for item in history(limit=None):
            if item.get('domain') == domain and item.get('status') in ('starting', 'running'):
                return {'ok': True, 'id': item['id'], 'status': 'running', 'duplicate': True}
        ids = queued_jobs()
        for jobid in ids:
            item = load_job(jobid)
            if item and item.get('status') == 'queued' and item.get('domain') == domain:
                return {'ok': True, 'id': jobid, 'status': 'queued', 'duplicate': True}
        ids = [jobid for jobid in ids
               if (load_job(jobid) or {}).get('status') == 'queued']
        if len(ids) >= MAX_SCAN_QUEUE:
            raise ValueError('Scan-Warteschlange voll (%d Auftraege). Bitte spaeter erneut versuchen.' % MAX_SCAN_QUEUE)
        jobid = uuid.uuid4().hex
        queued_at = utc_now()
        job = {'id': jobid, 'domain': domain, 'trigger': trigger, 'status': 'queued',
               'queued_at': queued_at, 'started_at': queued_at,
               'epoch': time.time(), 'pid': None, 'findings': []}
        save_job(job)
        logfd = os.open(str(ROOT / 'jobs' / (jobid + '.log')),
                        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0), 0o600)
        os.close(logfd)
        ids.append(jobid)
        write_json(ROOT / 'scan-queue.json', {'jobs': ids})
        return {'ok': True, 'id': jobid, 'status': 'queued', 'duplicate': False}
    finally:
        os.close(lockfd)


def dispatch_next_scan():
    """Start one oldest queued scan while retaining the global scan lock in its worker."""
    try:
        scanfd = lock_scan()
    except (OSError, BlockingIOError):
        return {'started': False, 'reason': 'busy'}
    keep_fd = False
    try:
        qfd = queue_lock()
        try:
            ids = queued_jobs()
            selected = None
            remaining = []
            for jobid in ids:
                item = load_job(jobid)
                if not item or item.get('status') != 'queued':
                    continue
                if selected is None:
                    selected = item
                else:
                    remaining.append(jobid)
            if selected:
                selected.update(status='starting', started_at=utc_now(), epoch=time.time(), pid=None)
                save_job(selected)
            write_json(ROOT / 'scan-queue.json', {'jobs': remaining})
        finally:
            os.close(qfd)
        if not selected:
            return {'started': False, 'reason': 'empty'}
        jobid = selected['id']
        argv = [sys.executable, os.path.realpath(__file__), 'worker', selected['domain'], jobid, str(scanfd)]
        try:
            child = subprocess.Popen(argv, close_fds=True, pass_fds=(scanfd,), stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     start_new_session=True, cwd='/')
        except OSError as exc:
            selected.update(status='error', finished_at=utc_now(),
                             error='Scan-Worker konnte nicht gestartet werden: ' + str(exc)[:180])
            save_job(selected)
            return {'started': False, 'reason': 'spawn-error'}
        keep_fd = True
        return {'started': True, 'id': jobid, 'domain': selected['domain'], 'pid': child.pid}
    finally:
        if not keep_fd:
            os.close(scanfd)


def history(limit=MAX_HISTORY):
    try:
        items = []
        for path in (ROOT / 'jobs').glob('*.json'):
            if JOB_ID.fullmatch(path.stem):
                st = path.stat()
                items.append((st.st_mtime, path.stem))
        items.sort(reverse=True)
        records = []
        for _, jobid in (items if limit is None else items[:limit]):
            entry = read_scan(jobid, include_output=False)
            if entry:
                records.append({k: entry.get(k) for k in
                                ('id', 'domain', 'status', 'started_at', 'finished_at', 'infected', 'ignored', 'trigger')})
        return records
    except OSError:
        return []


def schedules():
    data = read_json(ROOT / 'schedule.json', {'domains': {}})
    domains = data.get('domains', {}) if isinstance(data, dict) else {}
    return {d: value for d, value in domains.items()
            if valid_domain(d) and isinstance(value, dict) and value.get('enabled') is True}


def schedule_set(domain, state):
    if os.geteuid() != 0 or not valid_domain(domain) or state not in ('on', 'off'):
        raise ValueError('Unzulaessige Planungseinstellung.')
    site_docroot(domain)
    prepare_dir()
    data = read_json(ROOT / 'schedule.json', {'domains': {}})
    domains = data.get('domains', {})
    if not isinstance(domains, dict):
        domains = {}
    if state == 'on':
        domains[domain] = {'enabled': True, 'configured_at': utc_now()}
    else:
        domains.pop(domain, None)
    write_json(ROOT / 'schedule.json', {'domains': domains})
    return {'ok': True, 'domain': domain, 'enabled': state == 'on'}


def utc_now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec='seconds')


def lock_scan(blocking=False):
    prepare_dir()
    fd = os.open(str(ROOT / 'scan.lock'), os.O_RDWR | os.O_CREAT | getattr(os, 'O_NOFOLLOW', 0), 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
    except (OSError, BlockingIOError):
        os.close(fd)
        raise BlockingIOError('Ein Scan oder eine Quarantaene-Aktion laeuft bereits.')
    return fd


def scan_start(domain, trigger='manual'):
    if os.geteuid() != 0:
        raise ValueError('Root-Rechte fuer den Plesk-Helfer erforderlich.')
    if trigger not in ('manual', 'schedule') or not valid_domain(domain):
        raise ValueError('Ungueltiger Scan-Auftrag.')
    if not binary(CLAM_PATHS):
        raise ValueError('ClamAV fehlt. Bitte clamscan installieren.')
    site_docroot(domain)
    queued = enqueue_scan(domain, trigger)
    started = dispatch_next_scan()
    result = {'ok': True, 'id': queued['id'],
              'status': 'running' if queued.get('status') == 'running' or started.get('id') == queued['id'] else 'queued'}
    if queued.get('duplicate'):
        result['duplicate'] = True
    return result


def safe_relative(relative):
    if not isinstance(relative, str) or not relative or len(relative) > 2048 or '\x00' in relative:
        return False
    if '\n' in relative or '\r' in relative or '\\' in relative or relative.startswith('/'):
        return False
    return all(s not in ('', '.', '..') for s in relative.split('/'))


def file_metadata(docroot, relative, max_bytes=MAX_SNAPSHOT_FILE):
    """Walk with O_NOFOLLOW and dir_fds to prevent traversal via symlink parents."""
    if not safe_relative(relative):
        raise ValueError('Unzulaessiger Dateipfad.')
    parts = relative.split('/')
    dfd = os.open(str(docroot), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        for component in parts[:-1]:
            next_fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dfd)
            os.close(dfd)
            dfd = next_fd
        fd = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_size > max_bytes or st.st_nlink != 1:
                raise ValueError('Datei ist keine einzelne regulaere Datei im Groessenlimit.')
            digest = hashlib.sha256()
            while True:
                buf = os.read(fd, 128 * 1024)
                if not buf:
                    break
                digest.update(buf)
            after = os.fstat(fd)
            if (st.st_mtime_ns, st.st_size, st.st_ino) != (after.st_mtime_ns, after.st_size, after.st_ino):
                raise ValueError('Datei waehrend der Pruefung geaendert.')
            return {'sha256': digest.hexdigest(), 'size': st.st_size, 'ino': st.st_ino,
                    'dev': st.st_dev, 'mtime_ns': st.st_mtime_ns, 'uid': st.st_uid}, dfd, parts[-1]
        finally:
            os.close(fd)
    except BaseException:
        os.close(dfd)
        raise


def findings_from_log(docroot, logtext):
    prefix = str(docroot) + '/'
    findings = []
    seen = set()
    for line in logtext.splitlines():
        if not line.endswith(' FOUND'):
            continue
        # clamscan emits '<filepath>: <signature> FOUND'. Ignore ambiguous paths.
        match = re.match(r'^(.*): ([^:\n]{1,250}) FOUND$', line)
        if not match or not match.group(1).startswith(prefix):
            continue
        relative = match.group(1)[len(prefix):]
        if not safe_relative(relative) or relative in seen:
            continue
        seen.add(relative)
        finding = {'path': relative, 'signature': match.group(2), 'state': 'found'}
        try:
            meta, dirfd, _ = file_metadata(docroot, relative)
            os.close(dirfd)
            finding['fingerprint'] = meta
        except (OSError, ValueError):
            finding['state'] = 'changed_or_unreadable'
        findings.append(finding)
        if len(findings) >= MAX_FINDINGS:
            break
    return findings


def admin_tool_candidates(docroot):
    """Read-only, bounded checks for common uploaded PHP administration tools.

    These are exposure indicators, not malware verdicts. Never delete or repair them.
    """
    docroot = pathlib.Path(docroot)
    try:
        root_stat = docroot.lstat()
    except OSError:
        return {'findings': [], 'checked': 0, 'incomplete': True, 'truncated': False}
    if not stat.S_ISDIR(root_stat.st_mode) or stat.S_ISLNK(root_stat.st_mode):
        return {'findings': [], 'checked': 0, 'incomplete': True, 'truncated': False}
    deadline = time.monotonic() + MAX_ADMIN_TOOL_SCAN_SECONDS
    findings = []
    checked = 0
    visited = 0
    incomplete = False
    truncated = False
    stack = [('', 0)]
    while stack and not truncated:
        relative_dir, depth = stack.pop()
        dirfd = os.open(str(docroot), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            for component in relative_dir.split('/') if relative_dir else ():
                next_fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dirfd)
                os.close(dirfd)
                dirfd = next_fd
            entries = os.scandir(dirfd)
            try:
                for entry in entries:
                    if time.monotonic() >= deadline or visited >= MAX_ADMIN_TOOL_ENTRIES:
                        incomplete = True
                        truncated = True
                        break
                    visited += 1
                    try:
                        info = entry.stat(follow_symlinks=False)
                    except OSError:
                        incomplete = True
                        continue
                    relative = (relative_dir + '/' if relative_dir else '') + entry.name
                    if stat.S_ISDIR(info.st_mode):
                        if info.st_dev != root_stat.st_dev:
                            incomplete = True
                        elif depth >= 16:
                            incomplete = True
                        elif safe_relative(relative):
                            stack.append((relative, depth + 1))
                        else:
                            incomplete = True
                        continue
                    if not stat.S_ISREG(info.st_mode):
                        incomplete = True
                        continue
                    checked += 1
                    if checked > MAX_ADMIN_TOOL_FILES:
                        incomplete = True
                        truncated = True
                        break
                    if not entry.name.lower().endswith('.php'):
                        continue
                    base = entry.name.lower()
                    adminer_name = re.fullmatch(r'adminer(?:[-_.][0-9][0-9._-]*)?\.php', base) is not None
                    tinyfm_name = base in ('tinyfilemanager.php', 'tiny-file-manager.php', 'filemanager.php')
                    if info.st_size > MAX_ADMIN_TOOL_FILE_BYTES:
                        incomplete = incomplete or adminer_name or tinyfm_name
                        continue
                    if not safe_relative(relative):
                        incomplete = True
                        continue
                    if not adminer_name and not tinyfm_name:
                        continue
                    metadata, file_dirfd, leaf = file_metadata(docroot, relative, MAX_ADMIN_TOOL_FILE_BYTES)
                    try:
                        fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=file_dirfd)
                        try:
                            before = os.fstat(fd)
                            with os.fdopen(fd, 'rb', closefd=False) as stream:
                                prefix = stream.read(65536).lower()
                            after = os.fstat(fd)
                            expected = (metadata['ino'], metadata['dev'], metadata['size'], metadata['mtime_ns'])
                            actual = (after.st_ino, after.st_dev, after.st_size, after.st_mtime_ns)
                            if not stat.S_ISREG(after.st_mode) or actual != expected or before.st_ino != after.st_ino:
                                incomplete = True
                                continue
                        finally:
                            os.close(fd)
                    finally:
                        os.close(file_dirfd)
                    if adminer_name and (b'adminer.org' in prefix or b'adminer' in prefix):
                        tool = 'Adminer'
                    elif tinyfm_name and (b'tinyfilemanager' in prefix or b'tiny file manager' in prefix):
                        tool = 'TinyFileManager'
                    else:
                        continue
                    findings.append({'path': relative, 'tool': tool, 'state': 'review',
                                     'sha256': metadata['sha256']})
                    if len(findings) >= MAX_ADMIN_TOOL_RESULTS:
                        truncated = True
                        break
            finally:
                entries.close()
        except OSError:
            incomplete = True
        finally:
            os.close(dirfd)
    return {'findings': findings, 'checked': checked, 'incomplete': incomplete, 'truncated': truncated}


def ignored_hash_set(domain):
    settings = read_json(ROOT / 'management' / 'config.json', {})
    ignored = settings.get('ignore_hashes', {}) if isinstance(settings, dict) else {}
    global_values = settings.get('global_ignore_hashes', []) if isinstance(settings, dict) else []
    values = ignored.get(domain, []) if isinstance(ignored, dict) else []
    domain_hashes = {value for value in values if isinstance(value, str) and re.fullmatch(r'[a-f0-9]{64}', value)} \
        if isinstance(values, list) else set()
    global_hashes = {value for value in global_values if isinstance(value, str) and
                     re.fullmatch(r'[a-f0-9]{64}', value)} if isinstance(global_values, list) else set()
    return domain_hashes | global_hashes


def annotate_ignored_findings(domain, findings):
    """Keep ignored detections visible, but suppress alerts/repair for exact content hashes."""
    settings = read_json(ROOT / 'management' / 'config.json', {})
    global_values = settings.get('global_ignore_hashes', []) if isinstance(settings, dict) else []
    global_hashes = {value for value in global_values if isinstance(value, str) and
                     re.fullmatch(r'[a-f0-9]{64}', value)} if isinstance(global_values, list) else set()
    hashes = ignored_hash_set(domain)
    count = 0
    for finding in findings:
        fingerprint = finding.get('fingerprint')
        sha = fingerprint.get('sha256') if isinstance(fingerprint, dict) else None
        finding['ignored'] = isinstance(sha, str) and sha in hashes
        if finding['ignored']:
            finding['ignore_scope'] = 'global' if sha in global_hashes else 'domain'
        count += int(finding['ignored'])
    return count


def drop_privileges(uid, gid, cpu_limit=1800):
    os.setgroups([])
    os.setgid(gid)
    os.setuid(uid)
    os.nice(10)
    cpu_limit = max(1, min(1800, int(cpu_limit)))
    resource.setrlimit(resource.RLIMIT_CPU, (cpu_limit, cpu_limit))
    resource.setrlimit(resource.RLIMIT_FSIZE, (5 * 1024 * 1024, 5 * 1024 * 1024))


def scan_cache_path(domain):
    if not valid_domain(domain):
        raise ValueError('Ungueltige Cache-Domain.')
    name = hashlib.sha256(domain.encode('ascii')).hexdigest() + '.json'
    return ROOT / 'scan-cache' / name


def clam_scan_identity(program):
    """Bind cached clean results to the exact scanner binary and local signature files."""
    try:
        executable = pathlib.Path(program).resolve(strict=True)
        binary_stat = executable.stat()
        if (not stat.S_ISREG(binary_stat.st_mode) or binary_stat.st_uid != 0 or
                binary_stat.st_mode & 0o022):
            return None
        parent = executable.parent
        while parent != parent.parent:
            parent_stat = parent.stat()
            if not stat.S_ISDIR(parent_stat.st_mode) or parent_stat.st_uid != 0 or parent_stat.st_mode & 0o022:
                return None
            parent = parent.parent
        digest = hashlib.sha256()
        with executable.open('rb') as source:
            for block in iter(lambda: source.read(256 * 1024), b''):
                digest.update(block)
        version = subprocess.run([str(executable), '--version'], stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, timeout=10, cwd='/', check=False,
                                 env={'PATH': '/usr/bin:/bin', 'LANG': 'C'} )
        if version.returncode or not version.stdout or len(version.stdout) > 4096:
            return None
        sigdir = pathlib.Path('/var/lib/clamav')
        if sigdir.is_symlink() or not sigdir.is_dir():
            return None
        directory_stat = sigdir.stat()
        if directory_stat.st_uid != 0 or directory_stat.st_mode & 0o022:
            return None
        signatures = []
        suffixes = {'.cvd', '.cld', '.ndb', '.hdb', '.hsb', '.ldb', '.mdb', '.ftm'}
        for item in sigdir.iterdir():
            if item.suffix.lower() not in suffixes:
                continue
            info = item.lstat()
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022):
                return None
            signatures.append([item.name, info.st_dev, info.st_ino, info.st_size,
                               info.st_mtime_ns, info.st_ctime_ns])
        if not signatures:
            return None
        identity = hashlib.sha256()
        identity.update(version.stdout)
        identity.update(digest.digest())
        identity.update(json.dumps(sorted(signatures), separators=(',', ':')).encode('utf-8'))
        return identity.hexdigest()
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def scan_file_fingerprint(info):
    return {'dev': int(info.st_dev), 'ino': int(info.st_ino), 'size': int(info.st_size),
            'mtime_ns': int(info.st_mtime_ns), 'ctime_ns': int(info.st_ctime_ns),
            'mode': int(stat.S_IMODE(info.st_mode)), 'uid': int(info.st_uid),
            'gid': int(info.st_gid), 'nlink': int(info.st_nlink)}


def scan_file_inventory(docroot):
    """Bounded no-follow inventory; refuse incremental mode if coverage is uncertain."""
    started = time.monotonic()
    try:
        root_fd = os.open(str(docroot), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        root_info = os.fstat(root_fd)
    except OSError:
        return {}, False, 'Document-Root konnte nicht sicher inventarisiert werden.'
    files = {}
    stack = [('', 0)]
    entries_seen = 0
    reason = ''
    try:
        while stack:
            if time.monotonic() - started > MAX_SCAN_WALK_SECONDS:
                reason = 'Datei-Inventar ueberschreitet das Zeitlimit.'
                break
            relative_dir, depth = stack.pop()
            dir_fd = os.dup(root_fd)
            try:
                if relative_dir:
                    for component in relative_dir.split('/'):
                        next_fd = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                                          dir_fd=dir_fd)
                        os.close(dir_fd)
                        dir_fd = next_fd
                with os.scandir(dir_fd) as iterator:
                    for entry in iterator:
                        entries_seen += 1
                        if entries_seen > MAX_SCAN_WALK_ENTRIES or len(files) >= MAX_SCAN_CACHE_FILES:
                            reason = 'Datei-Inventar ueberschreitet das sichere Limit.'
                            break
                        if time.monotonic() - started > MAX_SCAN_WALK_SECONDS:
                            reason = 'Datei-Inventar ueberschreitet das Zeitlimit.'
                            break
                        relative = (relative_dir + '/' if relative_dir else '') + entry.name
                        try:
                            info = entry.stat(follow_symlinks=False)
                        except OSError:
                            reason = 'Datei-Inventar ist unvollstaendig.'
                            break
                        if stat.S_ISDIR(info.st_mode):
                            if info.st_dev == root_info.st_dev and depth < 16 and safe_relative(relative):
                                stack.append((relative, depth + 1))
                            continue
                        if not stat.S_ISREG(info.st_mode) or info.st_dev != root_info.st_dev:
                            continue
                        if not safe_relative(relative) or '\n' in relative or '\r' in relative:
                            reason = 'Dateipfade lassen sich nicht sicher als ClamAV-Liste abbilden.'
                            break
                        files[relative] = scan_file_fingerprint(info)
                    if reason:
                        break
            except OSError:
                reason = 'Datei-Inventar ist unvollstaendig.'
                break
            finally:
                os.close(dir_fd)
    finally:
        os.close(root_fd)
    return files, not reason, reason


def scan_cache_read(domain, signature):
    data = read_json(scan_cache_path(domain), max_bytes=MAX_SCAN_CACHE_FILE_BYTES)
    if (not isinstance(data, dict) or data.get('schema') != 1 or data.get('domain') != domain or
            data.get('signature') != signature or not isinstance(data.get('files'), dict) or
            len(data['files']) > MAX_SCAN_CACHE_FILES):
        return {}
    valid = {}
    fields = {'dev', 'ino', 'size', 'mtime_ns', 'ctime_ns', 'mode', 'uid', 'gid', 'nlink'}
    for relative, fingerprint in data['files'].items():
        if (isinstance(relative, str) and len(relative.encode('utf-8', 'replace')) <= MAX_SCAN_CACHE_PATH_BYTES and
                safe_relative(relative) and isinstance(fingerprint, dict) and set(fingerprint) == fields and
                all(isinstance(value, int) and value >= 0 for value in fingerprint.values())):
            valid[relative] = fingerprint
    return valid


def scan_cache_write(domain, signature, files):
    if len(files) > MAX_SCAN_CACHE_FILES:
        return False
    path = scan_cache_path(domain)
    try:
        prepare_dir()
        payload = {'schema': 1, 'domain': domain, 'signature': signature,
                   'updated_at': utc_now(), 'files': files}
        write_json(path, payload, max_bytes=MAX_SCAN_CACHE_FILE_BYTES)
        inventory = []
        for item in (ROOT / 'scan-cache').glob('*.json'):
            if item == path or not re.fullmatch(r'[a-f0-9]{64}\.json', item.name):
                continue
            try:
                inventory.append((item.stat().st_mtime, item))
            except OSError:
                continue
        inventory.sort()
        while len(inventory) >= MAX_SCAN_CACHE_DOMAINS:
            _, oldest = inventory.pop(0)
            try:
                oldest.unlink()
            except OSError:
                pass
        return True
    except (OSError, ValueError):
        return False


def scan_cache_list_file(docroot, paths):
    """Create an immutable-to-site-user ClamAV file list in the sticky /tmp directory."""
    fd, name = tempfile.mkstemp(prefix='.guardian-scan-', dir='/tmp')
    try:
        os.fchmod(fd, 0o644)
        with os.fdopen(fd, 'wb') as output:
            for relative in paths:
                encoded = os.fsencode(str(docroot / relative))
                if b'\n' in encoded or b'\r' in encoded:
                    raise ValueError('Dateipfade lassen sich nicht sicher als ClamAV-Liste abbilden.')
                output.write(encoded + b'\n')
            output.flush()
            os.fsync(output.fileno())
        return name
    except BaseException:
        try:
            os.unlink(name)
        except OSError:
            pass
        raise


def scan_worker(domain, jobid, inherited_fd):
    if os.geteuid() != 0 or not JOB_ID.fullmatch(jobid) or inherited_fd < 3:
        return 2
    try:
        os.fstat(inherited_fd)
    except OSError:
        return 2
    scan = load_job(jobid)
    if not scan or scan.get('domain') != domain or scan.get('status') != 'starting':
        return 2
    scan.update(status='running', epoch=time.time(), pid=os.getpid())
    try:
        path, uid, gid = site_docroot(domain)
        program = binary(CLAM_PATHS)
        if not program:
            raise RuntimeError('clamscan nicht gefunden.')
        save_job(scan)
        signature = clam_scan_identity(program)
        inventory, inventory_complete, inventory_reason = scan_file_inventory(path)
        cache_enabled = bool(signature and inventory_complete)
        old_cache = scan_cache_read(domain, signature) if cache_enabled else {}
        cache_candidates = []
        cache_hits = 0
        for relative, fingerprint in inventory.items():
            cacheable = (len(relative.encode('utf-8', 'replace')) <= MAX_SCAN_CACHE_PATH_BYTES and
                         fingerprint['size'] <= MAX_SCAN_FILE_BYTES and fingerprint['nlink'] == 1)
            if cache_enabled and cacheable and old_cache.get(relative) == fingerprint:
                cache_hits += 1
            else:
                cache_candidates.append(relative)
        rapid_scan = {'enabled': cache_enabled, 'files_seen': len(inventory),
                      'cached_clean': cache_hits, 'files_scanned': len(cache_candidates),
                      'cache_updated': False,
                      'note': 'Cache nur fuer unveraenderte regulaere Dateien mit identischem ClamAV-Programm und Signaturbestand.'}
        if not cache_enabled:
            rapid_scan['note'] = inventory_reason or 'ClamAV-Signaturstand nicht sicher bestimmbar; Vollscan ausgefuehrt.'
        scan['rapid_scan'] = rapid_scan
        # Persist the pre-scan counts now so a running report can show them before ClamAV finishes.
        save_job(scan)
        args = [program, '--infected', '--no-summary', '--follow-dir-symlinks=0',
                '--follow-file-symlinks=0', '--cross-fs=no', '--max-filesize=25M',
                '--max-scansize=150M', '--max-files=10000', '--max-recursion=16']
        list_path = None
        if cache_enabled:
            if cache_candidates:
                try:
                    list_path = scan_cache_list_file(path, cache_candidates)
                    args.append('--file-list=' + list_path)
                except (OSError, ValueError):
                    cache_enabled = False
                    scan['rapid_scan'].update(enabled=False, cached_clean=0, files_scanned=len(inventory),
                                              note='Dateiliste konnte nicht sicher erstellt werden; regulaerer Vollscan verwendet.')
                    cache_hits = 0
            # An empty changed-file list is a verified no-op for this exact local scanner/signature state.
        if not cache_enabled:
            args.extend(['--recursive=yes', str(path)])
        log_path = ROOT / 'jobs' / (jobid + '.log')
        try:
            if cache_enabled and not cache_candidates:
                with log_path.open('ab') as log:
                    log.write(('Guardian RapidScan: %d unveraenderte Dateien mit identischem Signaturstand uebersprungen.\n' % cache_hits).encode('utf-8'))
                done = subprocess.CompletedProcess(args, 0)
            else:
                with log_path.open('ab') as log:
                    done = subprocess.run(args, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                                          timeout=3600, cwd='/', check=False,
                                          preexec_fn=lambda: drop_privileges(uid, gid),
                                          env={'PATH': '/usr/bin:/bin', 'LANG': 'C'})
        finally:
            if list_path:
                try:
                    os.unlink(list_path)
                except OSError:
                    pass
        log_size = log_path.stat().st_size
        with log_path.open('rb') as log:
            raw_log = log.read(5 * 1024 * 1024 + 1)
        log_truncated = log_size > 5 * 1024 * 1024 or len(raw_log) > 5 * 1024 * 1024
        text = raw_log[:5 * 1024 * 1024].decode('utf-8', 'replace')
        findings = findings_from_log(path, text)
        logged_findings = sum(1 for line in text.splitlines() if line.endswith(' FOUND'))
        if cache_enabled and done.returncode in (0, 1) and logged_findings == len(findings) and not log_truncated and not re.search(
                r'(?im)^(?:WARNING:|ERROR:|LibClamAV Error:)', text):
            after_inventory, after_complete, _ = scan_file_inventory(path)
            if after_complete:
                infected_paths = {item['path'] for item in findings if item.get('state') == 'found'}
                new_cache = {}
                for relative, fingerprint in after_inventory.items():
                    if (len(relative.encode('utf-8', 'replace')) > MAX_SCAN_CACHE_PATH_BYTES or
                            fingerprint['size'] > MAX_SCAN_FILE_BYTES or fingerprint['nlink'] != 1):
                        continue
                    before = inventory.get(relative)
                    if before != fingerprint or relative in infected_paths:
                        continue
                    if relative in cache_candidates or old_cache.get(relative) == fingerprint:
                        new_cache[relative] = fingerprint
                rapid_scan['cache_updated'] = scan_cache_write(domain, signature, new_cache)
                if not rapid_scan['cache_updated']:
                    rapid_scan['note'] = 'ClamAV-Pruefung abgeschlossen; Cache konnte wegen Speicher-/Datengrenze nicht aktualisiert werden.'
        if log_truncated:
            scan['warning'] = 'Scanner-Protokoll ueberschreitet 5 MiB; Cache wurde nicht aktualisiert.'
        admin_tools = admin_tool_candidates(path)
        ignored_count = annotate_ignored_findings(domain, findings)
        active_findings = [item for item in findings if item.get('state') == 'found' and not item.get('ignored')]
        scan.update(status='finished' if done.returncode in (0, 1) else 'error',
                    finished_at=utc_now(), infected=len(findings), ignored=ignored_count, findings=findings,
                    admin_tools=admin_tools)
        if admin_tools['findings']:
            incident_log('admin_tool_detected', 'warning', domain,
                         '%d bekannte Admin-Tool-Kandidaten gefunden; manuelle Pruefung empfohlen. Keine Datei wurde veraendert.' %
                         len(admin_tools['findings']))
        if done.returncode == 1 and active_findings:
            incident_log('malware_detected', 'critical', domain,
                         'ClamAV meldet %d nicht ignorierte Funde (manuelle Pruefung erforderlich).' % len(active_findings))
        if done.returncode not in (0, 1):
            scan['error'] = 'ClamAV Scan-Fehler (Exit-Code %d).' % done.returncode
        elif done.returncode == 1 and not findings:
            scan['warning'] = 'ClamAV meldet Funde, aber Dateipfade konnten nicht sicher aufgeloest werden.'
    except subprocess.TimeoutExpired:
        scan.update(status='error', error='Scan nach 60 Minuten abgebrochen.', finished_at=utc_now())
    except Exception as exc:
        scan.update(status='error', error='Scan-Fehler: ' + str(exc)[:250], finished_at=utc_now())
    finally:
        save_job(scan)
        os.close(inherited_fd)
    dispatch_next_scan()
    if scan.get('status') == 'finished' and any(
            item.get('state') == 'found' and not item.get('ignored') for item in scan.get('findings', [])):
        manager = pathlib.Path(__file__).resolve().parent / 'guardian-manager'
        if manager.is_file():
            subprocess.Popen([sys.executable, str(manager), 'auto-repair', jobid],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, close_fds=True, start_new_session=True, cwd='/')
    return 0


def watch_path(domain):
    if not valid_domain(domain):
        raise ValueError('Ungueltige Monitoring-Domain.')
    return ROOT / 'watch' / (hashlib.sha256(domain.encode('ascii')).hexdigest() + '.json')


def watch_changes(domain):
    """Bounded, hourly filesystem metadata sampling; NOT real-time protection."""
    root, _, _ = site_docroot(domain)
    start = time.monotonic()
    files = {}
    stack = [(root, '', 0)]
    limited = False
    while stack:
        if len(files) >= 1500 or time.monotonic() - start > 8:
            limited = True
            break
        current, prefix, depth = stack.pop()
        if depth > 12:
            limited = True
            continue
        try:
            # Never sort an unbounded directory; hostile sites can contain millions of entries.
            with os.scandir(current) as iterator:
                entries = []
                for entry in iterator:
                    entries.append(entry)
                    if len(entries) >= 3000:
                        limited = True
                        break
                entries.sort(key=lambda x: x.name)
        except OSError:
            continue
        for entry in entries:
            if time.monotonic() - start > 8 or len(files) >= 1500:
                limited = True
                break
            relative = prefix + entry.name
            if len(relative) > 240:
                continue
            try:
                if entry.is_symlink():
                    continue
                if entry.is_dir(follow_symlinks=False):
                    stack.append((pathlib.Path(entry.path), relative + '/', depth + 1))
                elif entry.is_file(follow_symlinks=False) and (
                        entry.name.lower().endswith(('.php', '.phtml', '.phar', '.inc')) or
                        entry.name in ('.htaccess', '.user.ini')):
                    st = entry.stat(follow_symlinks=False)
                    files[relative] = [st.st_mtime_ns, st.st_size]
            except OSError:
                continue
    previous = read_json(watch_path(domain), {'files': {}})
    old = previous.get('files', {})
    if not isinstance(old, dict):
        old = {}
    changes = []
    if previous.get('initialized'):
        for filename, metadata in files.items():
            if filename not in old:
                changes.append({'path': filename, 'type': 'neu'})
            elif old[filename] != metadata:
                changes.append({'path': filename, 'type': 'geaendert'})
        if not limited and not previous.get('limited'):
            for filename in old.keys() - files.keys():
                changes.append({'path': filename, 'type': 'entfernt'})
    record = {'initialized': True, 'domain': domain, 'checked_at': utc_now(),
              'files': files, 'limited': limited, 'last_changes': changes[:30],
              'change_count': len(changes), 'sampling': 'stündlich / ggf. seltener'}
    write_json(watch_path(domain), record)
    return record


def watch_status():
    records = []
    for domain in list(sorted(schedules()))[:30]:
        data = read_json(watch_path(domain), {})
        if data:
            records.append({k: data.get(k) for k in
                            ('domain', 'checked_at', 'limited', 'last_changes', 'change_count')})
    return records


def prune_reports():
    """Keep quarantine journals indefinitely; remove old clean reports / logs."""
    items = []
    for file in (ROOT / 'jobs').glob('*.json'):
        if JOB_ID.fullmatch(file.stem):
            try:
                items.append((file.stat().st_mtime, file))
            except OSError:
                pass
    items.sort(reverse=True)
    now = time.time()
    for index, (mtime, file) in enumerate(items):
        if index < 200 and now - mtime <= 90 * 86400:
            continue
        report = read_json(file, {})
        if report.get('status') in ('queued', 'running', 'starting') or any(
                x.get('state') in ('pending', 'quarantined', 'error_review', 'repaired', 'rolled_back')
                for x in report.get('findings', []) if isinstance(x, dict)):
            continue
        try:
            file.unlink()
            file.with_suffix('.log').unlink(missing_ok=True)
        except OSError:
            pass


def firewall_expiry_tick():
    """Remove expired Guardian deny rules using Plesk's native rollback/confirm workflow."""
    if os.geteuid() != 0:
        raise ValueError('Firewall-Ablaufpruefung braucht Root-Rechte.')
    pending = read_json(FIREWALL_PENDING, {})
    if pending.get('state') == 'awaiting_confirmation':
        elapsed = time.time() - float(pending.get('started_epoch', 0))
        if elapsed <= 90:
            return {'checked': 0, 'removed': 0, 'pending': True}
        firewall_action('cancel')
    expiries = read_json(FIREWALL_EXPIRIES, {})
    if not expiries:
        return {'checked': 0, 'removed': 0, 'pending': False}
    listing = firewall_rules()
    if not listing.get('available') or listing.get('limited'):
        raise ValueError('Plesk-Firewallregeln fuer den Ablauf koennen nicht sicher gelesen werden.')
    active = {item['network'] for item in listing.get('rules', []) if item.get('kind', 'ip_deny') == 'ip_deny'}
    now = time.time()
    due = []
    due_count = 0
    changed = False
    for network, epoch in list(expiries.items()):
        try:
            canonical = str(ipaddress.ip_network(network, strict=True))
        except (TypeError, ValueError):
            expiries.pop(network, None)
            changed = True
            continue
        if canonical != network or not isinstance(epoch, int) or isinstance(epoch, bool) or epoch <= 0:
            expiries.pop(network, None)
            changed = True
            continue
        if network not in active:
            expiries.pop(network, None)
            changed = True
        elif epoch <= now:
            due_count += 1
            if len(due) < MAX_FIREWALL_EXPIRATIONS_PER_TICK:
                due.append(network)
    if changed:
        write_json(FIREWALL_EXPIRIES, expiries)
    removed = 0
    for network in due:
        firewall_action('unban', network)
        firewall_action('confirm')
        removed += 1
        incident_log('operator', 'info', '', 'Abgelaufene Guardian-Firewall-Sperre automatisch entfernt: ' + network)
    return {'checked': len(expiries), 'removed': removed, 'pending': False,
            'remaining_due': max(0, due_count - removed)}


def scheduled_tick():
    """Hourly Plesk scheduler call; enqueue due domains and run scans serially."""
    if os.geteuid() != 0:
        raise ValueError('Scheduler braucht Root-Rechte.')
    prepare_dir()
    try:
        expiry_result = firewall_expiry_tick()
        if expiry_result.get('remaining_due', 0):
            incident_log('operator', 'warning', '',
                         'Firewall-Ablaufwarteschlange: %d weitere abgelaufene Guardian-Regeln warten auf den naechsten Lauf.' %
                         expiry_result['remaining_due'])
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        incident_log('operator', 'warning', '', 'Automatische Guardian-Firewall-Entsperrung fehlgeschlagen: ' + str(exc)[:180])
    try:
        alert_queue_process()
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        incident_log('notification_error', 'warning', '', 'Mail-Warteschlange konnte nicht verarbeitet werden: ' + str(exc)[:150])
    dispatch_next_scan()
    config = schedules()
    # Watch metadata, limited to three domains per tick to control VPS load.
    selected = sorted(config)
    start = int(time.time() // 3600) * 3 % len(selected) if selected else 0
    for offset in range(min(3, len(selected))):
        domain = selected[(start + offset) % len(selected)]
        try:
            watch_changes(domain)
        except (OSError, ValueError):
            pass
    prune_reports()
    for domain in list(sorted(monitor_config()))[:MAX_MONITOR_DOMAINS]:
        try:
            site_docroot(domain)
            monitor_launch(domain)
        except (OSError, ValueError):
            pass
    latest_per_domain = {}
    # UI history is capped at 30; scheduling must inspect every retained report.
    for item in history(limit=None):
        if item.get('trigger') != 'schedule':
            continue
        try:
            started = datetime.datetime.fromisoformat(item['started_at']).timestamp()
            domain = item['domain']
            latest_per_domain[domain] = max(started, latest_per_domain.get(domain, started))
        except (ValueError, TypeError, KeyError):
            continue
    # Queue every due domain, but keep all ClamAV scans serial and bounded.
    accepted = 0
    deferred = 0
    for domain in sorted(config):
        last = latest_per_domain.get(domain)
        if last is not None and time.time() - last < 24 * 3600:
            continue
        try:
            site_docroot(domain)
            scan_start(domain, 'schedule')
            accepted += 1
            if len(queued_jobs()) >= MAX_SCAN_QUEUE:
                break
        except ValueError as exc:
            if 'Warteschlange voll' in str(exc):
                deferred += 1
                incident_log('operator', 'warning', domain,
                             'Malware-Scan-Warteschlange voll; faellige Domain wird beim naechsten Scheduler-Lauf erneut geprueft.')
                break
            continue
    pending = scan_queue_status()['count']
    message = ('%d faellige Scan(s) angenommen; %d warten.' % (accepted, pending)) if accepted \
        else ('%d Scan(s) warten.' % pending) if pending else 'Keine faelligen Domains.'
    if deferred:
        message += ' Warteschlange voll; mindestens eine Domain wird beim naechsten Lauf erneut geprueft.'
    return {'ok': True, 'accepted': accepted, 'pending': pending, 'deferred': deferred,
            'message': message}


def quarantine_file(jobid, index):
    """Admin-requested containment by atomic rename. Never auto-quarantine."""
    if os.geteuid() != 0:
        raise ValueError('Root-Rechte erforderlich.')
    lockfd = lock_scan()
    try:
        report = load_job(jobid)
        if not report or report.get('status') != 'finished' or not isinstance(index, int):
            raise ValueError('Kein abgeschlossener Scan-Bericht.')
        findings = report.get('findings', [])
        if not (0 <= index < len(findings)):
            raise ValueError('Fundindex ungueltig.')
        finding = findings[index]
        if finding.get('state') != 'found' or not finding.get('fingerprint'):
            raise ValueError('Diese Datei ist nicht mehr fuer Quarantaene geeignet.')
        if time.time() - float(report.get('epoch', 0)) > 7 * 86400:
            raise ValueError('Befund zu alt. Bitte zuerst neu scannen.')
        docroot, uid, _ = site_docroot(report['domain'])
        meta, dfd, name = file_metadata(docroot, finding['path'])
        try:
            if meta != finding['fingerprint'] or meta['uid'] != uid:
                raise ValueError('Datei hat sich geaendert oder gehoert anderem Benutzer; abgelehnt.')
            target = jobid + '-' + str(index) + '-' + uuid.uuid4().hex
            qfd = os.open(str(ROOT / 'quarantine'), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                # Save intent before moving; operator can diagnose interrupted action.
                finding.update(state='pending', quarantine_id=target)
                save_job(report)
                try:
                    os.rename(name, target, src_dir_fd=dfd, dst_dir_fd=qfd)
                except OSError:
                    # No move occurred (e.g. different filesystem); allow a fresh retry.
                    finding['state'] = 'found'
                    finding.pop('quarantine_id', None)
                    save_job(report)
                    raise
                moved = os.stat(target, dir_fd=qfd, follow_symlinks=False)
                if moved.st_ino != meta['ino'] or moved.st_dev != meta['dev']:
                    # The site's owner raced the operation. Never delete the unexpected file.
                    # Attempt non-overwriting rollback; otherwise leave it for manual review.
                    try:
                        os.link(target, name, src_dir_fd=qfd, dst_dir_fd=dfd, follow_symlinks=False)
                        os.unlink(target, dir_fd=qfd)
                        finding['state'] = 'changed_or_unreadable'
                    except OSError:
                        finding['state'] = 'error_review'
                    save_job(report)
                    raise ValueError('Datei im Quarantaene-Moment geaendert; manuelle Pruefung erforderlich.')
                finding['state'] = 'quarantined'
                finding['quarantined_at'] = utc_now()
                save_job(report)
                return {'ok': True, 'message': 'Datei in privates Quarantaene-Verzeichnis verschoben.'}
            finally:
                os.close(qfd)
        finally:
            os.close(dfd)
    finally:
        os.close(lockfd)


def restore_file(jobid, index):
    if os.geteuid() != 0:
        raise ValueError('Root-Rechte erforderlich.')
    lockfd = lock_scan()
    try:
        report = load_job(jobid)
        if not report or not isinstance(index, int):
            raise ValueError('Bericht nicht gefunden.')
        findings = report.get('findings', [])
        if not (0 <= index < len(findings)):
            raise ValueError('Fundindex ungueltig.')
        finding = findings[index]
        qname = finding.get('quarantine_id')
        if finding.get('state') not in ('quarantined', 'pending') or not isinstance(qname, str) or not re.fullmatch(r'[a-f0-9-]{67,75}', qname):
            raise ValueError('Keine wiederherstellbare Quarantaene-Datei.')
        docroot, _, _ = site_docroot(report['domain'])
        relative = finding.get('path')
        if not safe_relative(relative):
            raise ValueError('Ungueltiger Originalpfad.')
        parts = relative.split('/')
        dfd = os.open(str(docroot), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            for part in parts[:-1]:
                next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dfd)
                os.close(dfd)
                dfd = next_fd
            qfd = os.open(str(ROOT / 'quarantine'), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                # link() fails if destination already exists. Never overwrite a repaired site.
                os.link(qname, parts[-1], src_dir_fd=qfd, dst_dir_fd=dfd, follow_symlinks=False)
                os.unlink(qname, dir_fd=qfd)
                finding['state'] = 'restored'
                finding['restored_at'] = utc_now()
                save_job(report)
                return {'ok': True, 'message': 'Datei wiederhergestellt. Malware kann erneut aktiv sein!'}
            finally:
                os.close(qfd)
        finally:
            os.close(dfd)
    finally:
        os.close(lockfd)


def manual_ban(jail, address, operation):
    if os.geteuid() != 0 or not JAIL_NAME.fullmatch(jail) or operation not in ('ban', 'unban'):
        raise ValueError('Ungueltige Fail2Ban-Aktion.')
    try:
        addr = ipaddress.ip_address(address)
        if operation == 'ban' and (addr.is_loopback or addr.is_unspecified or
                                   addr.is_multicast or addr.is_link_local):
            raise ValueError('Diese Adresse darf nicht gesperrt werden.')
        normalized = str(addr)
    except ValueError:
        raise ValueError('Ungueltige oder lokale IP-Adresse.')
    cli = binary(FAIL2BAN_PATHS)
    if not cli:
        raise ValueError('Fail2Ban fehlt.')
    if jail not in [x['name'] for x in fail2ban_status()['jails']]:
        raise ValueError('Jail nicht aktiv oder ausserhalb der Anzeigegrenze.')
    run = execute([cli, 'set', jail, 'banip' if operation == 'ban' else 'unbanip', normalized], 8)
    if run is None or run.returncode:
        raise ValueError('Fail2Ban hat die Aktion abgelehnt.')
    return {'ok': True, 'message': 'Fail2Ban-Aktion ausgefuehrt.', 'ip': normalized}


def php_runtime_status():
    """Conservative read-only static inspection; does not assert actual FPM request coverage."""
    handlers = pathlib.Path('/opt/plesk/php')
    configs = []
    if handlers.is_dir():
        for candidate in sorted(handlers.glob('*/etc/php.ini'))[:24]:
            try:
                if not candidate.is_file() or candidate.stat().st_size > 2_000_000:
                    continue
                text = candidate.read_text(encoding='utf-8', errors='replace')
                enabled_lines = [line.strip() for line in text.splitlines()
                                 if line.strip() and not line.lstrip().startswith(('#', ';'))]
                configured = any(re.match(r'^(?:zend_)?extension\s*=.*snuffleupagus', line, re.I)
                                 for line in enabled_lines)
                rules = any(re.match(r'^sp\.configuration_file\s*=\s*\S+', line, re.I)
                            for line in enabled_lines)
                configs.append({'handler': candidate.parent.parent.name,
                                'module_configured': configured,
                                'rules_configured': rules})
            except OSError:
                continue
    # A PHP configuration is not proof of a running handler or effective policy.
    return {'confirmed': False, 'config_count': len(configs), 'configs': configs}


def http_flood_status():
    # Do not claim rate limiting from a version string or assume nginx has limit_req.
    return {'waf_log_readable': MODSEC_LOG.is_file() and os.access(str(MODSEC_LOG), os.R_OK),
            'nginx_rate_module_detected': False, 'protection_confirmed': False}


def status():
    firewall = firewall_status()
    firewall.update(firewall_rules())
    firewall.update(firewall_debug_status())
    fail2ban = fail2ban_status()
    crowdsec = crowdsec_status()
    waflog = waf_status()
    return {'ok': True,
            'services': {'fail2ban': fail2ban,
                         'crowdsec': crowdsec,
                         'clamav': {'installed': bool(binary(CLAM_PATHS)),
                                    'database_age_days': clam_database_age()},
                         'firewall': firewall, 'waflog': waflog,
                         'blocked_ip_geo': blocked_ip_geo_status(fail2ban, crowdsec, waflog),
                         'php_runtime': php_runtime_status(), 'http_flood': http_flood_status()},
            'scan': read_scan(), 'history': history(), 'schedules': schedules(),
            'scan_queue': scan_queue_status(),
            'watch': watch_status(), 'realtime': monitor_status(),
            'alerts': alert_settings(), 'alert_delivery': alert_queue_status(),
            'incidents': incident_list(200)}


def _main(argv):
    try:
        if argv == ['status']:
            return respond(status())
        if len(argv) == 2 and argv[0] == 'report' and JOB_ID.fullmatch(argv[1]):
            report = read_scan(argv[1])
            if not report:
                raise ValueError('Bericht nicht gefunden.')
            return respond({'ok': True, 'report': report})
        if argv == ['incidents']:
            return respond({'ok': True, 'incidents': incident_list(200)})
        if len(argv) == 3 and argv[0] == 'monitor-set':
            return respond(monitor_set(argv[1], argv[2]))
        if len(argv) == 3 and argv[0] == 'alerts-set':
            return respond(set_alert_settings(argv[1], argv[2] == 'on'))
        if argv == ['alerts-test']:
            return respond(alert_test())
        if argv == ['alerts-retry']:
            return respond(alert_queue_process(force=True))
        if len(argv) == 2 and argv[0] == 'watch-worker':
            return watch_worker(argv[1])
        if len(argv) == 2 and argv[0] == 'scan-start':
            return respond(scan_start(argv[1]))
        if len(argv) == 3 and argv[0] == 'schedule-set':
            return respond(schedule_set(argv[1], argv[2]))
        if argv == ['scheduled-tick']:
            return respond(scheduled_tick())
        if len(argv) == 3 and argv[0] in ('quarantine', 'restore'):
            if not JOB_ID.fullmatch(argv[1]) or not argv[2].isdigit() or len(argv[2]) > 3:
                raise ValueError('Ungueltiger Fundverweis.')
            operation = quarantine_file if argv[0] == 'quarantine' else restore_file
            return respond(operation(argv[1], int(argv[2])))
        if len(argv) == 4 and argv[0] == 'ip-action':
            return respond(manual_ban(argv[1], argv[2], argv[3]))
        if len(argv) in (2, 3, 4, 5, 6) and argv[0] == 'firewall-action':
            operation = argv[1]
            target = argv[2] if len(argv) >= 4 else ''
            if len(argv) == 3 and operation not in ('port-remove', 'allowlist-remove'):
                raise ValueError('Ungueltige Firewall-Aktion.')
            if operation in ('port-remove', 'allowlist-remove') and len(argv) == 3:
                target = argv[2]
            remote = argv[3] if len(argv) >= 4 else ''
            ttl = 0
            port = protocol = ''
            if len(argv) == 5:
                if operation != 'ban' or not argv[4].isdigit() or len(argv[4]) > 6:
                    raise ValueError('Ungueltige Firewall-Sperrdauer.')
                ttl = int(argv[4])
            if len(argv) == 6:
                if operation not in ('port-allow', 'port-deny'):
                    raise ValueError('Ungueltige Port-Firewall-Aktion.')
                port, protocol = argv[4], argv[5]
            return respond(firewall_action(operation, target, remote, ttl, port, protocol))
        if len(argv) == 2 and argv[0] == 'firewall-debug-set' and argv[1] in ('on', 'off'):
            return respond(firewall_debug_set(argv[1] == 'on'))
        if len(argv) == 4 and argv[0] == 'worker':
            return scan_worker(argv[1], argv[2], int(argv[3]))
        return error('Ungueltige Aktion.')
    except (ValueError, OSError, subprocess.SubprocessError, TypeError) as exc:
        return error(str(exc))


def debug_action_stage(argv):
    """Return a fixed operation label; never place domains, IPs, paths or secrets in logs."""
    if not argv:
        return 'helper'
    action = argv[0]
    if action == 'firewall-action' and len(argv) > 1:
        action = 'firewall-' + argv[1]
    elif action == 'ip-action' and len(argv) > 3:
        action = 'fail2ban-' + argv[3]
    allowed = {'scheduled-tick', 'scan-start', 'report', 'monitor-set', 'alerts-set',
               'alerts-test', 'alerts-retry', 'quarantine', 'restore', 'firewall-ban',
               'firewall-unban', 'firewall-port-allow', 'firewall-port-deny',
               'firewall-port-remove', 'firewall-allowlist-add', 'firewall-allowlist-remove',
               'fail2ban-ban', 'fail2ban-unban', 'firewall-debug-set', 'worker', 'watch-worker'}
    return action if action in allowed else 'helper'


def main(argv):
    stage = debug_action_stage(argv)
    started = time.monotonic()
    if argv and argv[0] == 'debug-event':
        # The Plesk controller uses this fixed, secret-free hook for the updater process.
        stage = 'updater-' + argv[1] if len(argv) == 4 and argv[1] in ('check', 'install') else 'invalid-debug-event'
        if (len(argv) != 4 or argv[1] not in ('check', 'install') or argv[2] not in ('0', '1') or
                not argv[3].isdigit() or len(argv[3]) > 7):
            return error('Ungueltiges Debugereignis.')
        firewall_debug_log('module-action' if argv[2] == '0' else 'module-error', stage=stage,
                            returncode=int(argv[2]), duration_ms=int(argv[3]))
        return respond({'ok': True})
    try:
        code = _main(argv)
    except Exception:
        firewall_debug_log('module-error', stage=stage, returncode=1,
                           duration_ms=int((time.monotonic() - started) * 1000))
        raise
    if not (argv and argv[0] == 'firewall-debug-set'):
        firewall_debug_log('module-action' if int(code) == 0 else 'module-error', stage=stage,
                           returncode=int(code), duration_ms=int((time.monotonic() - started) * 1000))
    return code


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
