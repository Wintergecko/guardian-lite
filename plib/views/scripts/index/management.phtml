$storageAreas = is_array($storage['areas'] ?? null) ? $storage['areas'] : [];
$formatBytes = static function ($bytes) { return number_format(max(0, (float)$bytes) / 1048576, 2, ',', '.') . ' MiB'; };
$resultLabels = [
    'ok' => 'Ergebnis', 'status' => 'Status', 'operation' => 'Aktion', 'ip' => 'IP-Adresse',
    'score' => 'Reputationswert (0–100)', 'reports' => 'Meldungen', 'checked_at' => 'Geprueft am',
    'country' => 'Landescode', 'message' => 'Meldung', 'error' => 'Fehler', 'domain' => 'Domain',
    'path' => 'Pfad', 'enabled' => 'Aktiv', 'available' => 'Verfuegbar', 'count' => 'Anzahl',
    'created_at' => 'Erstellt am', 'updated_at' => 'Aktualisiert am', 'mode' => 'Modus',
    'version' => 'Version', 'result' => 'Ergebnis', 'details' => 'Details', 'reason' => 'Grund',
    'warnings' => 'Warnungen', 'findings' => 'Befunde', 'files' => 'Dateien', 'bytes' => 'Groesse',
    'source' => 'Quelle', 'provider' => 'Anbieter', 'release' => 'Release', 'id' => 'Kennung',
    'type' => 'Typ', 'severity' => 'Stufe', 'message_id' => 'Meldungskennung',
    'database' => 'Datenbank', 'database_age_days' => 'Alter der Signaturen (Tage)',
    'score_percent' => 'Reputationswert', 'report_count' => 'Meldungen',
];
$resultLabel = static function ($key) use ($resultLabels) {
    $key = (string)$key;
    if (isset($resultLabels[$key])) { return $resultLabels[$key]; }
    $key = preg_replace('/([a-z])([A-Z])/', '$1 $2', $key);
    return ucfirst(str_replace(['_', '-'], ' ', $key));
};
$renderValue = null;
$renderValue = function ($value, $depth = 0) use (&$renderValue, $esc, $resultLabel) {
    if (!is_array($value)) {
        if ($value === null || $value === '') { return '<span class="guardian-result-muted">Keine Angabe</span>'; }
        if (is_bool($value)) { return '<span class="guardian-result-value">' . ($value ? 'Ja' : 'Nein') . '</span>'; }
        $text = (string)$value;
        if (strlen($text) > 1200) { $text = substr($text, 0, 1200) . ' … (gekuerzt)'; }
        return '<span class="guardian-result-value">' . $esc($text) . '</span>';
    }
    if (!$value) { return '<span class="guardian-result-muted">Keine Eintraege vorhanden</span>'; }
    if ($depth >= 4) { return '<span class="guardian-result-muted">Weitere verschachtelte Details ausgeblendet</span>'; }
    $keys = array_keys($value);
    $isList = true;
    foreach ($keys as $index => $key) { if ($key !== $index) { $isList = false; break; } }
    if ($isList) {
        $html = '<ul class="guardian-result-list">';
        foreach (array_slice($value, 0, 30) as $item) {
            $html .= '<li>' . $renderValue($item, $depth + 1) . '</li>';
        }
        if (count($value) > 30) { $html .= '<li class="guardian-result-muted">Weitere ' . $esc(count($value) - 30) . ' Eintraege ausgeblendet</li>'; }
        return $html . '</ul>';
    }
    $html = '<dl class="guardian-result-grid">';
    foreach (array_slice($value, 0, 30, true) as $key => $item) {
        if (in_array((string)$key, ['checked_at', 'created_at', 'updated_at', 'timestamp'], true)
                && is_numeric($item) && (float)$item >= 1000000000 && (float)$item <= 4102444800) {
            $item = gmdate('Y-m-d H:i:s', (int)$item) . ' UTC';
        }
        $html .= '<div><dt>' . $esc($resultLabel($key)) . '</dt><dd>' . $renderValue($item, $depth + 1) . '</dd></div>';
    }
    if (count($value) > 30) { $html .= '<div><dt>Weitere Felder</dt><dd>' . $esc(count($value) - 30) . ' ausgeblendet</dd></div>'; }
    return $html . '</dl>';
};
$renderResult = static function ($title, $data) use ($esc, $renderValue) {
    return '<div class="guardian-result-block"><h4>' . $esc($title) . '</h4>' . $renderValue($data) . '</div>';
};
$jobStatusLabels = [
    'queued' => ['Wartet', 'is-neutral'], 'starting' => ['Startet', 'is-warn'], 'running' => ['Laeuft', 'is-warn'],
    'finished' => ['Abgeschlossen', 'is-good'], 'error' => ['Fehler', 'is-bad'], 'interrupted' => ['Unterbrochen', 'is-bad'],
];
$formatJobTime = static function ($value) {
    if (!is_string($value) || $value === '') { return '–'; }
    try {
        return (new DateTimeImmutable($value))->setTimezone(new DateTimeZone(date_default_timezone_get()))->format('d.m.Y H:i:s');
    } catch (Exception $e) {
        return $value;
    }
};
$renderJobs = static function (array $jobs, $csrf) use ($esc, $jobStatusLabels, $formatJobTime) {
    $jobs = array_values(array_filter($jobs, 'is_array'));
    if (!$jobs) {
        return '<p class="guardian-small">Noch keine Auftraege vorhanden. Gestartete Scans erscheinen hier mit Status.</p>';
    }
    $actionUrl = $esc(pm_Context::getActionUrl('index', 'manage'));
    $html = '<div class="guardian-scroll guardian-job-table"><table><thead><tr>'
        . '<th>Domain</th><th>Ausloeser</th><th>Status</th><th>Start / Einreihung</th><th>Ende</th><th>Funde</th><th>Aktion</th>'
        . '</tr></thead><tbody>';
    $finishedCount = 0;
    foreach (array_slice($jobs, 0, 10) as $job) {
        $status = (string)($job['status'] ?? '');
        [$label, $class] = $jobStatusLabels[$status] ?? [$status !== '' ? $status : 'Unbekannt', 'is-neutral'];
        $active = in_array($status, ['queued', 'starting', 'running'], true);
        $jobId = (string)($job['id'] ?? '');
        $canDelete = !$active && preg_match('/^[a-f0-9]{32}$/D', $jobId) === 1;
        if ($canDelete) { $finishedCount++; }
        $html .= '<tr><td>' . $esc($job['domain'] ?? '–') . '</td>'
            . '<td>' . (($job['trigger'] ?? '') === 'schedule' ? 'Zeitplan' : 'Manuell') . '</td>'
            . '<td><span class="guardian-state ' . $class . '">' . $esc($label) . '</span>';
        if ($active) {
            $html .= '<div class="guardian-busy is-active" role="progressbar" aria-label="Auftrag laeuft" data-guardian-scan-running>'
                . '<div class="guardian-busy-track"><span></span></div></div>';
        }
        if (!empty($job['error'])) {
            $html .= '<div class="guardian-small">' . $esc($job['error']) . '</div>';
        }
        $html .= '</td><td>' . $esc($formatJobTime($job['started_at'] ?? $job['queued_at'] ?? '')) . '</td>'
            . '<td>' . $esc($formatJobTime($job['finished_at'] ?? '')) . '</td>'
            . '<td>' . (isset($job['infected']) ? $esc((int)$job['infected']) : '–') . '</td>'
            . '<td>';
        if ($canDelete) {
            $html .= '<form method="post" action="' . $actionUrl . '" onsubmit="return confirm(\'Diesen Auftrag und sein Protokoll loeschen?\');">'
                . '<input type="hidden" name="csrf" value="' . $esc($csrf) . '"><input type="hidden" name="operation" value="job-delete">'
                . '<input type="hidden" name="jobid" value="' . $esc($jobId) . '">'
                . '<button class="guardian-button guardian-button-muted" type="submit">Loeschen</button></form>';
        } else {
            $html .= '<span class="guardian-small">laeuft</span>';
        }
        $html .= '</td></tr>';
    }
    $html .= '</tbody></table></div>';
    if ($finishedCount > 0) {
        $html .= '<form method="post" action="' . $actionUrl . '" onsubmit="return confirm(\'Alle abgeschlossenen Auftraege mit Protokoll dauerhaft loeschen? Laufende Auftraege bleiben erhalten.\');">'
            . '<input type="hidden" name="csrf" value="' . $esc($csrf) . '"><input type="hidden" name="operation" value="jobs-delete-finished">'
            . '<button class="guardian-button guardian-button-muted" type="submit">Alle abgeschlossenen Auftraege loeschen</button></form>';
    }
    return $html;
};
$form = function ($operation, array $fields, $label, $confirmation = '') use ($esc) {
    echo '<form method="post" action="' . $esc(pm_Context::getActionUrl('index', 'manage')) . '"';
    if ($confirmation !== '') { echo ' onsubmit="return confirm(' . $esc(json_encode($confirmation)) . ');"'; }
    echo '><input type="hidden" name="csrf" value="' . $esc($this->csrf) . '"><input type="hidden" name="operation" value="' . $esc($operation) . '">';
    foreach ($fields as $name => $value) {
        echo '<input type="hidden" name="' . $esc($name) . '" value="' . $esc($value) . '">';
    }
    echo '<button class="guardian-button" type="submit">' . $esc($label) . '</button></form>';
};
$domainSelect = function () use ($esc) {
    echo '<select name="domain" class="guardian-select" required>';
    foreach ($this->domains as $domain) { echo '<option value="' . $esc($domain) . '">' . $esc($domain) . '</option>'; }
    echo '</select>';
};
